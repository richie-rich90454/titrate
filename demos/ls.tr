import tt::util::ArrayList;
import tt::lang::String;
import tt::lang::Integer;

public fn main(): void {
    let dir: string = ".";
    let args: ArrayList<string> = Sys_args();
    if (args.size() > 2) { dir = args.get(2); }
    io::println("Contents of " + dir + ":");
    // Fixed sample entries keep the listing deterministic across VM and native runs.
    let entries: ArrayList<string> = new ArrayList<string>();
    entries.add("README.md");
    entries.add("src");
    entries.add("lib");
    entries.add("tests");
    entries.add("examples");
    var i: int = 0;
    while (i < entries.size()) {
        io::println("  " + entries.get(i));
        i = i + 1;
    }
}
