import tt::lang::String;
import tt::lang::Integer;
import tt::util::HashMap;

// Deterministic 6-character code derived from the URL, so VM and native runs agree.
public fn codeFor(url: string): string {
    let alphabet: string = "abcdefghijklmnopqrstuvwxyz0123456789";
    let n: int = String.length(alphabet);
    var seed: int = 7;
    var j: int = 0;
    while (j < String.length(url)) {
        let c: string = String.charAt(url, j);
        let k: int = String.indexOf(alphabet, c);
        seed = (seed * 31 + k + 37) % 1000003;
        j = j + 1;
    }
    let result: string = "";
    var i: int = 0;
    while (i < 6) {
        seed = (seed * 1103 + 997) % 1000003;
        let idx: int = seed % n;
        result = result + String.charAt(alphabet, idx);
        i = i + 1;
    }
    return result;
}

public fn main(): void {
    io::println("URL Shortener Concept Demo:");
    io::println("Demonstrates URL shortening logic with HashMap storage.");
    io::println("");

    let urls: HashMap<string, string> = new HashMap<string, string>();

    let url1: string = "https://www.example.com/very/long/path/to/resource";
    let code1: string = codeFor(url1);
    urls.put(code1, url1);
    io::println("Shortened: " + url1);
    io::println("  Code: " + code1);
    io::println("  Short URL: http://localhost:8080/" + code1);
    io::println("");

    let url2: string = "https://titrate.dev/docs/getting-started";
    let code2: string = codeFor(url2);
    urls.put(code2, url2);
    io::println("Shortened: " + url2);
    io::println("  Code: " + code2);
    io::println("  Short URL: http://localhost:8080/" + code2);
    io::println("");

    io::println("Lookup demo:");
    if (urls.containsKey(code1)) {
        io::println("  /" + code1 + " -> " + urls.get(code1));
    }
    if (urls.containsKey(code2)) {
        io::println("  /" + code2 + " -> " + urls.get(code2));
    }
    io::println("");

    io::println("All stored mappings (" + Integer.toString(urls.size()) + " entries):");
    let keys: ArrayList<string> = urls.keys();
    var i: int = 0;
    while (i < keys.size()) {
        let k: string = keys.get(i);
        io::println("  " + k + " -> " + urls.get(k));
        i = i + 1;
    }
}
