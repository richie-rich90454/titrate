import tt::lang::Integer;
import tt::lang::String;

public fn main(): void {
    io::println("Timer and Scheduling Demo:");
    io::println("  Step 1: sleeping for 500ms");
    Time_sleep(500);
    io::println("  Step 2: sleeping for 250ms");
    Time_sleep(250);
    io::println("  Step 3: done");
}
