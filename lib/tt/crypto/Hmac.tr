// HMAC computation using the standard HMAC algorithm (RFC 2104).
import tt::lang::String;
import tt::crypto::Hash;
import tt::crypto::Sha256;
import tt::util::ArrayList;

// HMAC-SHA256: returns hex string
public fn sha256(key: string, message: string): string {
    return _bytesToHex(_hmacSha256(key, message));
}

// HMAC-SHA512: returns hex string
public fn sha512(key: string, message: string): string {
    return _hmac(key, message, 128, "sha512");
}

// HMAC-MD5: returns hex string
public fn md5(key: string, message: string): string {
    return _hmac(key, message, 64, "md5");
}

// HMAC-SHA1: returns hex string
public fn sha1(key: string, message: string): string {
    return _hmac(key, message, 64, "sha1");
}

// HMAC-SHA384: returns hex string
public fn sha384(key: string, message: string): string {
    return _hmac(key, message, 128, "sha384");
}

// HMAC-SHA3-256: returns hex string
public fn sha3_256(key: string, message: string): string {
    return _hmac(key, message, 136, "sha3-256");
}

// Constant-time comparison of two digest strings to prevent timing attacks.
public fn compareDigest(a: string, b: string): bool {
    return Hmac_compareDigest(a, b);
}

// HMAC-SHA256: returns raw byte string
public fn sha256Bytes(key: string, message: string): string {
    return _bytesToRawString(_hmacSha256(key, message));
}

// HMAC-SHA512: returns raw byte string
public fn sha512Bytes(key: string, message: string): string {
    return _hexToBytes(sha512(key, message));
}

// HMAC-SHA256 over raw byte lists. Native hash natives UTF-8-encode their
// string argument, so a pure Titrate SHA-256 is used to keep digest bytes intact.
fn _hmacSha256(key: string, message: string): ArrayList<int> {
    var k: ArrayList<int> = _toBytes(key);
    if (k.size() > 64) {
        k = Sha256.digestBytes(k);
    }
    while (k.size() < 64) {
        k.add(0);
    }
    let ip: ArrayList<int> = new ArrayList<int>();
    let op: ArrayList<int> = new ArrayList<int>();
    var i: int = 0;
    while (i < 64) {
        ip.add(k.get(i) ^ 0x36);
        op.add(k.get(i) ^ 0x5c);
        i = i + 1;
    }
    let innerMsg: ArrayList<int> = new ArrayList<int>();
    i = 0;
    while (i < ip.size()) {
        innerMsg.add(ip.get(i));
        i = i + 1;
    }
    let msgBytes: ArrayList<int> = _toBytes(message);
    i = 0;
    while (i < msgBytes.size()) {
        innerMsg.add(msgBytes.get(i));
        i = i + 1;
    }
    let inner: ArrayList<int> = Sha256.digestBytes(innerMsg);
    let outerMsg: ArrayList<int> = new ArrayList<int>();
    i = 0;
    while (i < op.size()) {
        outerMsg.add(op.get(i));
        i = i + 1;
    }
    i = 0;
    while (i < inner.size()) {
        outerMsg.add(inner.get(i));
        i = i + 1;
    }
    return Sha256.digestBytes(outerMsg);
}

// Generic HMAC construction for algorithms other than SHA-256.
fn _hmac(key: string, message: string, blockSize: int, algorithm: string): string {
    var k: string = key;
    // Long keys are hashed, then decoded from hex into raw bytes.
    if (String.length(k) > blockSize) {
        k = _hexToBytes(Hash.hashBytes(algorithm, k));
    }
    while (String.length(k) < blockSize) {
        k = k + "\x00";
    }
    let iKeyPad: string = _xorPad(k, 0x36, blockSize);
    let oKeyPad: string = _xorPad(k, 0x5c, blockSize);
    let innerHash: string = Hash.hashBytes(algorithm, iKeyPad + message);
    // Feed the inner digest as raw bytes, not as its hex representation.
    let hmacResult: string = Hash.hashBytes(algorithm, oKeyPad + _hexToBytes(innerHash));
    return hmacResult;
}

// XOR each byte of key with a pad value, producing a raw byte string.
fn _xorPad(key: string, pad: int, blockSize: int): string {
    let result: string = "";
    var i: int = 0;
    while (i < blockSize) {
        var b: int = 0;
        if (i < String.length(key)) {
            b = String.charAt(key, i) as int;
        }
        result = result + String.fromCharCode(b ^ pad);
        i = i + 1;
    }
    return result;
}

// Convert a string's character codes to a list of byte values.
fn _toBytes(s: string): ArrayList<int> {
    let result: ArrayList<int> = new ArrayList<int>();
    var i: int = 0;
    while (i < String.length(s)) {
        result.add(String.charAt(s, i) as int);
        i = i + 1;
    }
    return result;
}

// Convert a list of byte values to a raw byte string.
fn _bytesToRawString(bytes: ArrayList<int>): string {
    let result: string = "";
    var i: int = 0;
    while (i < bytes.size()) {
        result = result + String.fromCharCode(bytes.get(i));
        i = i + 1;
    }
    return result;
}

// Convert a byte list to a lowercase hex digest string.
fn _bytesToHex(bytes: ArrayList<int>): string {
    const HEX: string = "0123456789abcdef";
    let result: string = "";
    var i: int = 0;
    while (i < bytes.size()) {
        let b: int = bytes.get(i);
        result = result + String.charAt(HEX, (b / 16) % 16) + String.charAt(HEX, b % 16);
        i = i + 1;
    }
    return result;
}

// Convert a hex string to a raw byte string.
fn _hexToBytes(hex: string): string {
    let result: string = "";
    var i: int = 0;
    while (i + 1 < String.length(hex)) {
        let hi: int = _hexDigit(String.charAt(hex, i));
        let lo: int = _hexDigit(String.charAt(hex, i + 1));
        result = result + String.fromCharCode(hi * 16 + lo);
        i = i + 2;
    }
    return result;
}

// Convert a single hex character to its integer value.
fn _hexDigit(ch: string): int {
    let code: int = String.charAt(ch, 0) as int;
    if (code >= 48 && code <= 57) {
        return code - 48;
    }
    if (code >= 97 && code <= 102) {
        return code - 97 + 10;
    }
    if (code >= 65 && code <= 70) {
        return code - 65 + 10;
    }
    return 0;
}
