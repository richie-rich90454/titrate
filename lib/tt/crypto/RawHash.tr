    K.add(500013540394364858L); K.add(748580250866718886L); K.add(1242879168328830382L); K.add(1977374033974150939L);
    K.add(2944078676154940804L); K.add(3659926193048069267L); K.add(4368137639120453308L); K.add(4836135668995329356L);
    K.add(5532061633213252278L); K.add(6448918945643986474L); K.add(6902733635092675308L); K.add(7801388544844847127L);
    return K;
}

// SHA-512 core; when is384 is true, use the SHA-384 IV and truncate to 48 bytes.
fn sha512Core(bytes: ArrayList<int>, is384: bool): ArrayList<int> {
    let msg: ArrayList<int> = new ArrayList<int>();
    var i: int = 0;
    while (i < bytes.size()) {
        msg.add(bytes.get(i));
        i = i + 1;
    }
    msg.add(128);
    while (msg.size() % 128 != 112) {
        msg.add(0);
    }
    i = 0;
    while (i < 8) {
        msg.add(0);
        i = i + 1;
    }
    let bitLen: long = (bytes.size() as long) * 8L;
    i = 56;
    while (i >= 0) {
        msg.add(((bitLen >> i) & 255L) as int);
        i = i - 8;
    }

    var h0: long = 0L;
    var h1: long = 0L;
    var h2: long = 0L;
    var h3: long = 0L;
    var h4: long = 0L;
    var h5: long = 0L;
    var h6: long = 0L;
    var h7: long = 0L;
    if (is384) {
        h0 = -3766243637369397544L;
        h1 = 7105036623409894663L;
        h2 = -7973340178411365097L;
        h3 = 1526699215303891257L;
        h4 = 7436329637833083697L;
        h5 = -8163818279084223215L;
        h6 = -2662702644619276377L;
        h7 = 5167115440072839076L;
    } else {
        h0 = 7640891576956012808L;
        h1 = -4942790177534073029L;
        h2 = 4354685564936845355L;
        h3 = -6534734903238641935L;
        h4 = 5840696475078001361L;
        h5 = -7276294671716946913L;
        h6 = 2270897969802886507L;
        h7 = 6620516959819538809L;
    }

    let K: ArrayList<long> = sha512Constants();
    var off: int = 0;
    while (off < msg.size()) {
        let w: ArrayList<long> = new ArrayList<long>();
        var j: int = 0;
        while (j < 16) {
            let p: int = off + j * 8;
            var word: long = 0L;
            var b: int = 0;
            while (b < 8) {
                word = (word << 8) | (msg.get(p + b) as long);
                b = b + 1;
            }
            w.add(word);
            j = j + 1;
        }
        while (j < 80) {
            let x: long = w.get(j - 15);
            let y: long = w.get(j - 2);
            let s0: long = rotr64(x, 1) ^ rotr64(x, 8) ^ shr64(x, 7);
            let s1: long = rotr64(y, 19) ^ rotr64(y, 61) ^ shr64(y, 6);
            w.add(w.get(j - 16) + s0 + w.get(j - 7) + s1);
            j = j + 1;
        }

        var a: long = h0;
        var b: long = h1;
        var c: long = h2;
        var d: long = h3;
        var e: long = h4;
        var f: long = h5;
        var g: long = h6;
        var h: long = h7;
        j = 0;
        while (j < 80) {
            let S1: long = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch: long = (e & f) ^ ((~e) & g);
            let t1: long = h + S1 + ch + K.get(j) + w.get(j);
            let S0: long = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj: long = (a & b) ^ (a & c) ^ (b & c);
            let t2: long = S0 + maj;
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            j = j + 1;
        }
        h0 = h0 + a;
        h1 = h1 + b;
        h2 = h2 + c;
        h3 = h3 + d;
        h4 = h4 + e;
        h5 = h5 + f;
        h6 = h6 + g;
        h7 = h7 + h;
        off = off + 128;
    }

    let words: ArrayList<long> = new ArrayList<long>();
    words.add(h0);
    words.add(h1);
    words.add(h2);
    words.add(h3);
    words.add(h4);
    words.add(h5);
    words.add(h6);
    words.add(h7);
    let out: ArrayList<int> = new ArrayList<int>();
    var nwords: int = 8;
    if (is384) {
        nwords = 6;
    }
    i = 0;
    while (i < nwords) {
        let word: long = words.get(i);
        var shift: int = 56;
        while (shift >= 0) {
            out.add(((word >> shift) & 255L) as int);
            shift = shift - 8;
        }
        i = i + 1;
    }
    return out;
}

// SHA-512 digest as 64 raw bytes.
public fn sha512Bytes(bytes: ArrayList<int>): ArrayList<int> {
    return sha512Core(bytes, false);
}

// SHA-384 digest as 48 raw bytes.
public fn sha384Bytes(bytes: ArrayList<int>): ArrayList<int> {
    return sha512Core(bytes, true);
}

// ---- Keccak / SHA3-256 ----

fn keccakRoundConstants(): ArrayList<long> {
    let RC: ArrayList<long> = new ArrayList<long>();
    RC.add(1L); RC.add(32898L); RC.add(-9223372036854742902L); RC.add(-9223372034707259392L);
    RC.add(32907L); RC.add(2147483649L); RC.add(-9223372034707259263L); RC.add(-9223372036854743031L);
    RC.add(138L); RC.add(136L); RC.add(2147516425L); RC.add(2147483658L);
    RC.add(2147516555L); RC.add(-9223372036854775669L); RC.add(-9223372036854742903L); RC.add(-9223372036854743037L);
    RC.add(-9223372036854743038L); RC.add(-9223372036854775680L); RC.add(32778L); RC.add(-9223372034707292150L);
    RC.add(-9223372034707259263L); RC.add(-9223372036854742912L); RC.add(2147483649L); RC.add(-9223372034707259384L);
    return RC;
}

// Rotation offsets in x-major order (index x * 5 + y).
fn keccakRotations(): ArrayList<int> {
    let r: ArrayList<int> = new ArrayList<int>();
    r.add(0); r.add(36); r.add(3); r.add(41); r.add(18);
    r.add(1); r.add(44); r.add(10); r.add(45); r.add(2);
    r.add(62); r.add(6); r.add(43); r.add(15); r.add(61);
    r.add(28); r.add(55); r.add(25); r.add(21); r.add(56);
    r.add(27); r.add(20); r.add(39); r.add(8); r.add(14);
    return r;
}

fn keccakF(state: ArrayList<long>): void {
    let RC: ArrayList<long> = keccakRoundConstants();
    let rot: ArrayList<int> = keccakRotations();
    var round: int = 0;
    while (round < 24) {
        let c: ArrayList<long> = new ArrayList<long>();
        var x: int = 0;
        while (x < 5) {
            var cx: long = 0L;
            var y: int = 0;
            while (y < 5) {
                cx = cx ^ state.get(x + 5 * y);
                y = y + 1;
            }
            c.add(cx);
            x = x + 1;
        }
        x = 0;
        while (x < 5) {
            let d: long = c.get((x + 4) % 5) ^ rotl64(c.get((x + 1) % 5), 1);
            var y: int = 0;
            while (y < 5) {
                state.set(x + 5 * y, state.get(x + 5 * y) ^ d);
                y = y + 1;
            }
            x = x + 1;
        }

        let b: ArrayList<long> = new ArrayList<long>();
        x = 0;
        while (x < 25) {
            b.add(0L);
            x = x + 1;
        }
        x = 0;
        while (x < 5) {
            var y: int = 0;
            while (y < 5) {
                let bx: int = y;
                let by: int = (2 * x + 3 * y) % 5;
                b.set(bx + 5 * by, rotl64(state.get(x + 5 * y), rot.get(x * 5 + y)));
                y = y + 1;
            }
            x = x + 1;
        }

        x = 0;
        while (x < 5) {
            var y: int = 0;
            while (y < 5) {
                let b1: long = b.get(((x + 1) % 5) + 5 * y);
                let b2: long = b.get(((x + 2) % 5) + 5 * y);
                state.set(x + 5 * y, b.get(x + 5 * y) ^ ((~b1) & b2));
                y = y + 1;
            }
            x = x + 1;
        }

        state.set(0, state.get(0) ^ RC.get(round));
        round = round + 1;
    }
}

// SHA3-256 digest as 32 raw bytes.
public fn sha3_256Bytes(bytes: ArrayList<int>): ArrayList<int> {
    const BLOCK: int = 136;
    let padded: ArrayList<int> = new ArrayList<int>();
    var i: int = 0;
    while (i < bytes.size()) {
        padded.add(bytes.get(i));
        i = i + 1;
    }
    padded.add(0x06);
    while (padded.size() % BLOCK != BLOCK - 1) {
        padded.add(0);
    }
    padded.add(0x80);

    let state: ArrayList<long> = new ArrayList<long>();
    i = 0;
    while (i < 25) {
        state.add(0L);
        i = i + 1;
    }

    var off: int = 0;
    while (off < padded.size()) {
        var lane: int = 0;
        while (lane < 17) {
            var word: long = 0L;
            var b: int = 0;
            while (b < 8) {
                word = word ^ ((padded.get(off + lane * 8 + b) as long) << (b * 8));
                b = b + 1;
            }
            state.set(lane, state.get(lane) ^ word);
            lane = lane + 1;
        }
        keccakF(state);
        off = off + BLOCK;
    }

    let out: ArrayList<int> = new ArrayList<int>();
    i = 0;
    while (i < 32) {
        let laneVal: long = state.get(i / 8);
        out.add(((laneVal >> ((i % 8) * 8)) & 255L) as int);
        i = i + 1;
    }
    return out;
}
