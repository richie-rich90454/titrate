// SAX-style streaming JSON parser.
import tt::util::ArrayList;
import tt::util::HashMap;
import tt::json::JsonValue;
import tt::lang::String;

// A single event emitted by the streaming parser.
public class JsonEvent {
    public string eventType;
    public string stringValue;
    public double numberValue;
    public bool boolValue;

    public fn init(t: string) {
        this.eventType = t;
        this.stringValue = "";
        this.numberValue = 0.0;
        this.boolValue = false;
    }
}

// Streaming JSON parser that emits SAX-style events.
public class JsonStreamingParser {
    private var _buffer: string;
    private var _state: int;
    private var _depth: int;
    public var maxDepth: int;
    private var _pos: int;
    private var _events: ArrayList<JsonEvent>;
    private var _pathStack: ArrayList<string>;
    private var _indexStack: ArrayList<int>;
    private var _containerStack: ArrayList<string>;
    private var _isKeyNext: bool;
    private var _final: bool;
    private var _skippedDepth: int;

    public fn init() {
        this._buffer = "";
        this._state = 0;
        this._depth = 0;
        this.maxDepth = 1000;
        this._pos = 0;
        this._events = new ArrayList<JsonEvent>();
        this._pathStack = new ArrayList<string>();
        this._indexStack = new ArrayList<int>();
        this._containerStack = new ArrayList<string>();
        this._isKeyNext = false;
        this._final = false;
        this._skippedDepth = 0;
    }

    // Feed a chunk of JSON text and return any parsed events.
    public fn feed(chunk: string): ArrayList<JsonEvent> {
        this._buffer = this._buffer + chunk;
        this._pos = 0;
        this._events = new ArrayList<JsonEvent>();
        this._final = false;
        this._parseChunk();
        this._buffer = String.substring(this._buffer, this._pos, String.length(this._buffer));
        return this._events;
    }

    // Parse a complete JSON string.
    public fn parse(data: string): ArrayList<JsonEvent> {
        this._buffer = data;
        this._pos = 0;
        this._events = new ArrayList<JsonEvent>();
        this._final = true;
        this._parseChunk();
        this._buffer = "";
        return this._events;
    }

    // Signal end of input and return any remaining events.
    public fn close(): ArrayList<JsonEvent> {
        this._pos = 0;
        this._events = new ArrayList<JsonEvent>();
        this._final = true;
        this._skipWhitespace();
        if (this._pos < String.length(this._buffer)) {
            this._parseChunk();
        }
        this._buffer = "";
        return this._events;
    }

    // Return the current location as a JSON Pointer string.
    public fn currentPath(): string {
        if (this._pathStack.size() == 0) {
            return "";
        }
        var result: string = "";
        let i: int = 0;
        while (i < this._pathStack.size()) {
            let seg: string = this._pathStack.get(i);
            result = result + "/" + _escapePointerSegment(seg);
            i = i + 1;
        }
        return result;
    }

    // Return the next event or null if none available.
    public fn next(): JsonEvent {
        if (this._events.size() > 0) {
            let evt: JsonEvent = this._events.get(0);
            this._events.remove(0);
            return evt;
        }
        return null;
    }

    // ---- Internal parsing ----

    fn _parseChunk(): void {
        while (this._pos < String.length(this._buffer)) {
            this._skipWhitespace();
            if (this._pos >= String.length(this._buffer)) {
                break;
            }
            let c: string = String.charAt(this._buffer, this._pos);
            if (c == "{") {
                this._parseStartObject();
            } else if (c == "}") {
                this._parseEndObject();
            } else if (c == "[") {
                this._parseStartArray();
            } else if (c == "]") {
                this._parseEndArray();
            } else if (c == "\"") {
                if (!this._parseStringOrKey()) { break; }
            } else if (c == ":" ) {
                this._pos = this._pos + 1;
            } else if (c == ",") {
                this._pos = this._pos + 1;
                this._handleComma();
            } else if (c == "n") {
                if (!this._parseNull()) { break; }
            } else if (c == "t" || c == "f") {
                if (!this._parseBool()) { break; }
            } else if (c == "-" || (c >= "0" && c <= "9")) {
                if (!this._parseNumber()) { break; }
            } else {
                this._pos = this._pos + 1;
            }
        }
    }

    fn _skipWhitespace(): void {
        while (this._pos < String.length(this._buffer)) {
            let c: string = String.charAt(this._buffer, this._pos);
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                this._pos = this._pos + 1;
            } else {
                break;
            }
        }
    }

    fn _parseStartObject(): void {
        this._depth = this._depth + 1;
        this._pos = this._pos + 1;
        if (this._depth > this.maxDepth) {
            this._skippedDepth = this._skippedDepth + 1;
            return;
        }
        let evt: JsonEvent = new JsonEvent("startObject");
        this._events.add(evt);
        this._state = 1;
        this._isKeyNext = true;
        this._pathStack.add("");
        this._indexStack.add(0);
        this._containerStack.add("object");
    }

    fn _parseEndObject(): void {
        this._pos = this._pos + 1;
        this._depth = this._depth - 1;
        if (this._depth < 0) {
            this._depth = 0;
        }
        if (this._skippedDepth > 0) {
            this._skippedDepth = this._skippedDepth - 1;
            return;
        }
        if (this._pathStack.size() > 0) {
            this._pathStack.remove(this._pathStack.size() - 1);
        }
        if (this._indexStack.size() > 0) {
            this._indexStack.remove(this._indexStack.size() - 1);
        }
        if (this._containerStack.size() > 0) {
            this._containerStack.remove(this._containerStack.size() - 1);
        }
        let evt: JsonEvent = new JsonEvent("endObject");
        this._events.add(evt);
        this._isKeyNext = false;
    }

    fn _parseStartArray(): void {
        this._depth = this._depth + 1;
        this._pos = this._pos + 1;
        if (this._depth > this.maxDepth) {
            this._skippedDepth = this._skippedDepth + 1;
            return;
        }
        let evt: JsonEvent = new JsonEvent("startArray");
        this._events.add(evt);
        this._state = 2;
        this._isKeyNext = false;
        this._pathStack.add("");
        this._indexStack.add(0);
        this._containerStack.add("array");
    }

    fn _parseEndArray(): void {
        this._pos = this._pos + 1;
        this._depth = this._depth - 1;
        if (this._depth < 0) {
            this._depth = 0;
        }
        if (this._skippedDepth > 0) {
            this._skippedDepth = this._skippedDepth - 1;
            return;
        }
        if (this._pathStack.size() > 0) {
            this._pathStack.remove(this._pathStack.size() - 1);
        }
        if (this._indexStack.size() > 0) {
            this._indexStack.remove(this._indexStack.size() - 1);
        }
        if (this._containerStack.size() > 0) {
            this._containerStack.remove(this._containerStack.size() - 1);
        }
        let evt: JsonEvent = new JsonEvent("endArray");
        this._events.add(evt);
        this._isKeyNext = false;
    }

    fn _parseStringOrKey(): bool {
        if (!this._final && !this._isStringComplete()) {
            return false;
        }
        let s: string = this._readString();
        if (this._isKeyNext) {
            let evt: JsonEvent = new JsonEvent("key");
            evt.stringValue = s;
            this._events.add(evt);
            if (this._pathStack.size() > 0) {
                this._pathStack.set(this._pathStack.size() - 1, s);
            }
            this._isKeyNext = false;
        } else {
            let evt: JsonEvent = new JsonEvent("string");
            evt.stringValue = s;
            this._events.add(evt);
            this._advanceIndex();
        }
        return true;
    }

    fn _parseNull(): bool {
        return this._parseLiteral("null", "null", false);
    }

    fn _parseBool(): bool {
        let c: string = String.charAt(this._buffer, this._pos);
        if (c == "t") {
            return this._parseLiteral("true", "bool", true);
        }
        return this._parseLiteral("false", "bool", false);
    }

    fn _parseLiteral(literal: string, eventType: string, boolValue: bool): bool {
        let needed: int = String.length(literal);
        let available: int = String.length(this._buffer) - this._pos;
        if (available < needed) {
            let partial: string = String.substring(this._buffer, this._pos, String.length(this._buffer));
            if (String.startsWith(literal, partial)) {
                return false;
            }
            this._pos = this._pos + 1;
            return true;
        }
        let found: string = String.substring(this._buffer, this._pos, this._pos + needed);
        if (found != literal) {
            this._pos = this._pos + 1;
            return true;
        }
        this._pos = this._pos + needed;
        let evt: JsonEvent = new JsonEvent(eventType);
        evt.boolValue = boolValue;
        this._events.add(evt);
        this._advanceIndex();
        return true;
    }

    fn _parseNumber(): bool {
        let start: int = this._pos;
        let numStr: string = "";
        if (this._pos < String.length(this._buffer) && String.charAt(this._buffer, this._pos) == "-") {
            numStr = numStr + String.charAt(this._buffer, this._pos);
            this._pos = this._pos + 1;
        }
        while (this._pos < String.length(this._buffer)) {
            let c: string = String.charAt(this._buffer, this._pos);
            if ((c >= "0" && c <= "9") || c == "." || c == "e" || c == "E" || c == "+" || c == "-") {
                numStr = numStr + c;
                this._pos = this._pos + 1;
            } else {
                break;
            }
        }
        if (this._pos >= String.length(this._buffer) && !this._final && String.length(numStr) > 0) {
            let last: string = String.substring(numStr, String.length(numStr) - 1, String.length(numStr));
            if (last == "." || last == "e" || last == "E" || last == "+" || last == "-") {
                this._pos = start;
                return false;
            }
        }
        if (String.length(numStr) == 0) {
            this._pos = this._pos + 1;
            return true;
        }
        let evt: JsonEvent = new JsonEvent("number");
        evt.numberValue = Double.parseDouble(numStr);
        evt.stringValue = numStr;
        this._events.add(evt);
        this._advanceIndex();
        return true;
    }

    // True when the string starting at the current position has a closing
    // quote and every \u escape is complete.
    fn _isStringComplete(): bool {
        var i: int = this._pos + 1;
        while (i < String.length(this._buffer)) {
            let c: string = String.charAt(this._buffer, i);
            if (c == "\\") {
                if (i + 1 >= String.length(this._buffer)) { return false; }
                if (String.charAt(this._buffer, i + 1) == "u") {
                    var h: int = 0;
                    while (h < 4) {
                        if (i + 2 + h >= String.length(this._buffer)) { return false; }
                        h = h + 1;
                    }
                    i = i + 6;
                } else {
                    i = i + 2;
                }
            } else if (c == "\"") {
                return true;
            } else {
                i = i + 1;
            }
        }
        return false;
    }

    fn _handleComma(): void {
        this._skipWhitespace();
        if (this._pos < String.length(this._buffer) && this._containerStack.size() > 0) {
            let container: string = this._containerStack.get(this._containerStack.size() - 1);
            if (container == "object" && String.charAt(this._buffer, this._pos) == "\"") {
                this._isKeyNext = true;
            }
        }
    }

    fn _advanceIndex(): void {
        if (this._indexStack.size() > 0 && this._containerStack.size() > 0) {
            let container: string = this._containerStack.get(this._containerStack.size() - 1);
            if (container == "array") {
                let idx: int = this._indexStack.get(this._indexStack.size() - 1);
                this._indexStack.set(this._indexStack.size() - 1, idx + 1);
                if (this._pathStack.size() > 0) {
                    this._pathStack.set(this._pathStack.size() - 1, Integer.toString(idx));
                }
            }
        }
        this._isKeyNext = false;
    }

    fn _readString(): string {
        // Skip opening quote
        this._pos = this._pos + 1;
        let result: string = "";
        while (this._pos < String.length(this._buffer)) {
            let c: string = String.charAt(this._buffer, this._pos);
            this._pos = this._pos + 1;
            if (c == "\"") {
                break;
            }
            if (c == "\\") {
                if (this._pos < String.length(this._buffer)) {
                    let escaped: string = String.charAt(this._buffer, this._pos);
                    this._pos = this._pos + 1;
                    if (escaped == "n") {
                        result = result + "\n";
                    } else if (escaped == "t") {
                        result = result + "\t";
                    } else if (escaped == "r") {
                        result = result + "\r";
                    } else if (escaped == "\\") {
                        result = result + "\\";
                    } else if (escaped == "\"") {
                        result = result + "\"";
                    } else if (escaped == "/") {
                        result = result + "/";
                    } else if (escaped == "b") {
                        result = result + "\b";
                    } else if (escaped == "f") {
                        result = result + "\f";
                    } else if (escaped == "u") {
                        let hex: string = "";
                        let h: int = 0;
                        while (h < 4 && this._pos < String.length(this._buffer)) {
                            hex = hex + String.charAt(this._buffer, this._pos);
                            this._pos = this._pos + 1;
                            h = h + 1;
                        }
                        result = result + _decodeHex(hex);
                    } else {
                        result = result + escaped;
                    }
                }
            } else {
                result = result + c;
            }
        }
        return result;
    }

}

// Escape a JSON Pointer segment per RFC 6901.
fn _escapePointerSegment(seg: string): string {
    var result: string = "";
    let i: int = 0;
    while (i < String.length(seg)) {
        let c: string = String.charAt(seg, i);
        if (c == "~") {
            result = result + "~0";
        } else if (c == "/") {
            result = result + "~1";
        } else {
            result = result + c;
        }
        i = i + 1;
    }
    return result;
}

// Decode a 4-digit hex string to a Unicode character.
fn _decodeHex(hex: string): string {
    let code: int = 0;
    let i: int = 0;
    while (i < String.length(hex)) {
        let c: string = String.charAt(hex, i);
        code = code * 16;
        if (c >= "0" && c <= "9") {
            code = code + ((String.charAt(c, 0) as int) - (String.charAt("0", 0) as int));
        } else if (c >= "a" && c <= "f") {
            code = code + ((String.charAt(c, 0) as int) - (String.charAt("a", 0) as int)) + 10;
        } else if (c >= "A" && c <= "F") {
            code = code + ((String.charAt(c, 0) as int) - (String.charAt("A", 0) as int)) + 10;
        }
        i = i + 1;
    }
    return String.fromCharCode(code);
}
