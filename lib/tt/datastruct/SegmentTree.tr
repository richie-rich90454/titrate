// Range aggregate tree with a caller-supplied associative combine function.
import tt::util::ArrayList;

public class SegmentTree {
    private ArrayList<int> tree;
    private int n;
    private int identity;
    private fn(int, int): int combine;

    public fn init(combine: fn(int, int): int, identity: int) {
        this.combine = combine;
        this.identity = identity;
        this.n = 0;
        this.tree = new ArrayList<int>();
    }

    private fn buildNode(node: int, start: int, end: int, values: ArrayList<int>): void {
        if (start == end) {
            this.tree.set(node, values.get(start));
            return;
        }
        let mid: int = (start + end) / 2;
        this.buildNode(node * 2, start, mid, values);
        this.buildNode(node * 2 + 1, mid + 1, end, values);
        this.tree.set(node, this.combine(this.tree.get(node * 2), this.tree.get(node * 2 + 1)));
    }

    public fn build(values: ArrayList<int>): void {
        this.n = values.size();
        var capacity: int = 4 * this.n;
        if (capacity < 1) { capacity = 1; }
        this.tree = new ArrayList<int>();
        var i: int = 0;
        while (i < capacity) {
            this.tree.add(this.identity);
            i = i + 1;
        }
        if (this.n > 0) { this.buildNode(1, 0, this.n - 1, values); }
    }

    private fn updateNode(node: int, start: int, end: int, index: int, value: int): void {
        if (start == end) {
            this.tree.set(node, value);
            return;
        }
        let mid: int = (start + end) / 2;
        if (index <= mid) {
            this.updateNode(node * 2, start, mid, index, value);
        } else {
            this.updateNode(node * 2 + 1, mid + 1, end, index, value);
        }
        this.tree.set(node, this.combine(this.tree.get(node * 2), this.tree.get(node * 2 + 1)));
    }

    public fn update(index: int, value: int): void {
        if (index < 0 || index >= this.n) { return; }
        this.updateNode(1, 0, this.n - 1, index, value);
    }

    private fn queryNode(node: int, start: int, end: int, lo: int, hi: int): int {
        if (hi < start || end < lo) { return this.identity; }
        if (lo <= start && end <= hi) { return this.tree.get(node); }
        let mid: int = (start + end) / 2;
        let a: int = this.queryNode(node * 2, start, mid, lo, hi);
        let b: int = this.queryNode(node * 2 + 1, mid + 1, end, lo, hi);
        return this.combine(a, b);
    }

    public fn query(lo: int, hi: int): int {
        if (this.n == 0 || lo > hi) { return this.identity; }
        return this.queryNode(1, 0, this.n - 1, lo, hi);
    }

    public fn size(): int {
        return this.n;
    }
}

// ==================== tests ====================

public fn test_segmenttree_sum_query(): void {
    let plus: fn(int, int): int = fn(a: int, b: int): int { return a + b; };
    let tree: SegmentTree = new SegmentTree(plus, 0);
    let values: ArrayList<int> = new ArrayList<int>();
    values.add(1);
    values.add(2);
    values.add(3);
    values.add(4);
    values.add(5);
    tree.build(values);
    if (tree.size() == 5 && tree.query(0, 4) == 15 && tree.query(1, 3) == 9
            && tree.query(2, 2) == 3 && tree.query(0, 0) == 1 && tree.query(3, 4) == 9) {
        io::println("PASS: segmenttree sum query");
    } else {
        io::println("FAIL: segmenttree sum query");
    }
}

public fn test_segmenttree_update(): void {
    let plus: fn(int, int): int = fn(a: int, b: int): int { return a + b; };
    let tree: SegmentTree = new SegmentTree(plus, 0);
    let values: ArrayList<int> = new ArrayList<int>();
    values.add(1);
    values.add(2);
    values.add(3);
    values.add(4);
    values.add(5);
    tree.build(values);
    tree.update(2, 10);
    tree.update(0, 7);
    if (tree.query(0, 4) == 28 && tree.query(1, 3) == 16 && tree.query(2, 2) == 10
            && tree.query(0, 1) == 9 && tree.query(4, 4) == 5) {
        io::println("PASS: segmenttree update");
    } else {
        io::println("FAIL: segmenttree update");
    }
}

public fn test_segmenttree_min_and_empty(): void {
    let minOf: fn(int, int): int = fn(a: int, b: int): int { return a < b ? a : b; };
    let emptyTree: SegmentTree = new SegmentTree(minOf, 1000);
    let emptyOk: bool = emptyTree.size() == 0 && emptyTree.query(0, 1) == 1000;
    let values: ArrayList<int> = new ArrayList<int>();
    values.add(5);
    values.add(2);
    values.add(8);
    values.add(1);
    values.add(9);
    let tree: SegmentTree = new SegmentTree(minOf, 1000);
    tree.build(values);
    tree.update(3, 7);
    if (emptyOk && tree.query(0, 4) == 2 && tree.query(1, 2) == 2
            && tree.query(3, 4) == 7 && tree.query(0, 0) == 5) {
        io::println("PASS: segmenttree min/empty");
    } else {
        io::println("FAIL: segmenttree min/empty");
    }
}

public fn run_all_segmenttree_tests(): void {
    io::println("=== datastruct/SegmentTree.tr Tests ===");
    test_segmenttree_sum_query();
    test_segmenttree_update();
    test_segmenttree_min_and_empty();
}
