// 1-based prefix-sum array exposed through 0-based indices.
import tt::util::ArrayList;

public class FenwickTree {
    private ArrayList<int> tree;
    private int n;

    public fn init(size: int) {
        if (size < 0) { size = 0; }
        this.n = size;
        this.tree = new ArrayList<int>();
        var i: int = 0;
        while (i <= this.n) {
            this.tree.add(0);
            i = i + 1;
        }
    }

    private fn lowBit(value: int): int {
        return value & (~value + 1);
    }

    public fn add(index: int, delta: int): void {
        if (index < 0 || index >= this.n) { return; }
        var i: int = index + 1;
        while (i <= this.n) {
            this.tree.set(i, this.tree.get(i) + delta);
            i = i + this.lowBit(i);
        }
    }

    public fn prefixSum(index: int): int {
        if (index < 0) { return 0; }
        if (index >= this.n) { index = this.n - 1; }
        var i: int = index + 1;
        var sum: int = 0;
        while (i > 0) {
            sum = sum + this.tree.get(i);
            i = i - this.lowBit(i);
        }
        return sum;
    }

    public fn rangeSum(lo: int, hi: int): int {
        if (lo > hi || this.n == 0) { return 0; }
        return this.prefixSum(hi) - this.prefixSum(lo - 1);
    }

    public fn size(): int {
        return this.n;
    }

    public fn isEmpty(): bool {
        return this.n == 0;
    }
}

// ==================== tests ====================

public fn test_fenwicktree_prefix_sums(): void {
    let tree: FenwickTree = new FenwickTree(6);
    tree.add(0, 2);
    tree.add(1, 4);
    tree.add(2, 6);
    tree.add(3, 8);
    tree.add(4, 10);
    tree.add(5, 12);
    if (tree.size() == 6 && tree.prefixSum(0) == 2 && tree.prefixSum(2) == 12
            && tree.prefixSum(4) == 30 && tree.prefixSum(5) == 42
            && tree.prefixSum(100) == 42 && tree.prefixSum(-1) == 0) {
        io::println("PASS: fenwicktree prefix sums");
    } else {
        io::println("FAIL: fenwicktree prefix sums");
    }
}

public fn test_fenwicktree_range_sums(): void {
    let tree: FenwickTree = new FenwickTree(6);
    tree.add(0, 2);
    tree.add(1, 4);
    tree.add(2, 6);
    tree.add(3, 8);
    tree.add(4, 10);
    tree.add(5, 12);
    if (tree.rangeSum(1, 3) == 18 && tree.rangeSum(2, 5) == 36
            && tree.rangeSum(0, 0) == 2 && tree.rangeSum(4, 4) == 10
            && tree.rangeSum(3, 2) == 0) {
        io::println("PASS: fenwicktree range sums");
    } else {
        io::println("FAIL: fenwicktree range sums");
    }
}

public fn test_fenwicktree_negative_delta_and_empty(): void {
    let empty: FenwickTree = new FenwickTree(0);
    let emptyOk: bool = empty.isEmpty() && empty.size() == 0 && empty.prefixSum(0) == 0
            && empty.rangeSum(0, 3) == 0;
    let tree: FenwickTree = new FenwickTree(5);
    tree.add(0, 3);
    tree.add(2, 7);
    tree.add(2, -3);
    tree.add(4, 5);
    tree.add(9, 100);
    if (emptyOk && tree.prefixSum(4) == 12 && tree.rangeSum(1, 3) == 4
            && tree.rangeSum(2, 2) == 4 && tree.rangeSum(0, 4) == 12) {
        io::println("PASS: fenwicktree negative delta/empty");
    } else {
        io::println("FAIL: fenwicktree negative delta/empty");
    }
}

public fn run_all_fenwicktree_tests(): void {
    io::println("=== datastruct/FenwickTree.tr Tests ===");
    test_fenwicktree_prefix_sums();
    test_fenwicktree_range_sums();
    test_fenwicktree_negative_delta_and_empty();
}
