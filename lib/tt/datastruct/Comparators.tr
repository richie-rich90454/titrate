// Reusable comparison functions. Each comparator returns -1, 0 or 1 and can
// be passed directly to sorting or search helpers that accept fn(T, T): int.
import tt::lang::String;

// Natural ascending order for ints.
public fn ascendingInt(a: int, b: int): int {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}

// Reverse int order.
public fn descendingInt(a: int, b: int): int {
    return ascendingInt(b, a);
}

// Order strings by length, ignoring their contents.
public fn byStringLength(a: string, b: string): int {
    let la: int = String.length(a);
    let lb: int = String.length(b);
    if (la < lb) { return -1; }
    if (la > lb) { return 1; }
    return 0;
}

// Derive a comparable key from each value, then compare the keys.
public fn byKey<K, V>(keyFn: fn(V): K, cmp: fn(K, K): int): fn(V, V): int {
    return fn(a: V, b: V): int {
        return cmp(keyFn(a), keyFn(b));
    };
}

// Tie-break: use `first`, falling back to `second` when first reports equality.
public fn compose<T>(first: fn(T, T): int, second: fn(T, T): int): fn(T, T): int {
    return fn(a: T, b: T): int {
        let c: int = first(a, b);
        if (c != 0) { return c; }
        return second(a, b);
    };
}

// ==================== tests ====================

public fn test_comparators_int(): void {
    if (ascendingInt(2, 5) == -1 && ascendingInt(5, 2) == 1 && ascendingInt(3, 3) == 0
            && descendingInt(2, 5) == 1 && descendingInt(5, 2) == -1 && descendingInt(3, 3) == 0) {
        io::println("PASS: comparators int");
    } else {
        io::println("FAIL: comparators int");
    }
}

public fn test_comparators_string_length(): void {
    if (byStringLength("a", "bbb") == -1 && byStringLength("abcd", "xy") == 1
            && byStringLength("ab", "cd") == 0 && byStringLength("", "") == 0) {
        io::println("PASS: comparators byStringLength");
    } else {
        io::println("FAIL: comparators byStringLength");
    }
}

public fn test_comparators_by_key(): void {
    let keyFn: fn(string): int = fn(s: string): int { return String.length(s); };
    let asc: fn(int, int): int = ascendingInt;
    let byLen: fn(string, string): int = byKey<int, string>(keyFn, asc);
    if (byLen("a", "bb") == -1 && byLen("abc", "x") == 1 && byLen("ab", "cd") == 0) {
        io::println("PASS: comparators byKey");
    } else {
        io::println("FAIL: comparators byKey");
    }
}

public fn test_comparators_compose(): void {
    let lexicographic: fn(string, string): int = fn(a: string, b: string): int {
        return String.compareTo(a, b);
    };
    let lengthCmp: fn(string, string): int = byStringLength;
    let cmp: fn(string, string): int = compose<string>(lengthCmp, lexicographic);
    if (cmp("a", "bb") == -1 && cmp("ab", "cd") == -1 && cmp("b", "a") == 1
            && cmp("aa", "bb") == -1) {
        io::println("PASS: comparators compose");
    } else {
        io::println("FAIL: comparators compose");
    }
}

public fn run_all_comparators_tests(): void {
    io::println("=== datastruct/Comparators.tr Tests ===");
    test_comparators_int();
    test_comparators_string_length();
    test_comparators_by_key();
    test_comparators_compose();
}
