// UndirectedGraph — adjacency-list undirected graph over integer vertices 0..n-1.
import tt::util::ArrayList;
import tt::util::HashMap;
import tt::util::Queue;
import tt::util::Stack;

public class UndirectedGraph {
    private int n;
    private HashMap<int, ArrayList<int>> adj;
    private int edgeCount;

    public fn init(n: int) {
        if (n < 0) { n = 0; }
        this.n = n;
        this.edgeCount = 0;
        this.adj = new HashMap<int, ArrayList<int>>();
        var i: int = 0;
        while (i < n) {
            this.adj.put(i, new ArrayList<int>());
            i = i + 1;
        }
    }

    public fn vertexCount(): int {
        return this.n;
    }

    public fn edgeCount(): int {
        return this.edgeCount;
    }

    public fn addEdge(a: int, b: int): void {
        if (a < 0 || a >= this.n || b < 0 || b >= this.n || a == b) { return; }
        let la: ArrayList<int> = this.adj.get(a);
        let lb: ArrayList<int> = this.adj.get(b);
        if (!la.contains(b)) {
            la.add(b);
            lb.add(a);
            this.edgeCount = this.edgeCount + 1;
        }
    }

    public fn removeEdge(a: int, b: int): bool {
        if (a < 0 || a >= this.n || b < 0 || b >= this.n) { return false; }
        let la: ArrayList<int> = this.adj.get(a);
        let ia: int = la.indexOf(b);
        if (ia < 0) { return false; }
        la.remove(ia);
        let lb: ArrayList<int> = this.adj.get(b);
        let ib: int = lb.indexOf(a);
        if (ib >= 0) { lb.remove(ib); }
        this.edgeCount = this.edgeCount - 1;
        return true;
    }

    public fn hasEdge(a: int, b: int): bool {
        if (a < 0 || a >= this.n) { return false; }
        return this.adj.get(a).contains(b);
    }

    public fn neighbors(v: int): ArrayList<int> {
        if (v < 0 || v >= this.n) { return new ArrayList<int>(); }
        return this.adj.get(v);
    }

    public fn degree(v: int): int {
        if (v < 0 || v >= this.n) { return 0; }
        return this.adj.get(v).size();
    }

    public fn bfs(start: int): ArrayList<int> {
        let result: ArrayList<int> = new ArrayList<int>();
        if (start < 0 || start >= this.n) { return result; }
        let visited: ArrayList<bool> = new ArrayList<bool>();
        var i: int = 0;
        while (i < this.n) {
            visited.add(false);
            i = i + 1;
        }
        let queue: Queue<int> = new Queue<int>();
        visited.set(start, true);
        queue.enqueue(start);
        while (!queue.isEmpty()) {
            let current: int = queue.dequeue();
            result.add(current);
            let nbrs: ArrayList<int> = this.adj.get(current);
            i = 0;
            while (i < nbrs.size()) {
                let next: int = nbrs.get(i);
                if (!visited.get(next)) {
                    visited.set(next, true);
                    queue.enqueue(next);
                }
                i = i + 1;
            }
        }
        return result;
    }

    public fn dfs(start: int): ArrayList<int> {
        let result: ArrayList<int> = new ArrayList<int>();
        if (start < 0 || start >= this.n) { return result; }
        let visited: ArrayList<bool> = new ArrayList<bool>();
        var i: int = 0;
        while (i < this.n) {
            visited.add(false);
            i = i + 1;
        }
        let stack: Stack<int> = new Stack<int>();
        stack.push(start);
        while (!stack.isEmpty()) {
            let current: int = stack.pop();
            if (visited.get(current)) { continue; }
            visited.set(current, true);
            result.add(current);
            let nbrs: ArrayList<int> = this.adj.get(current);
            i = nbrs.size() - 1;
            while (i >= 0) {
                let next: int = nbrs.get(i);
                if (!visited.get(next)) { stack.push(next); }
                i = i - 1;
            }
        }
        return result;
    }

    public fn connectedComponents(): ArrayList<ArrayList<int>> {
        let comps: ArrayList<ArrayList<int>> = new ArrayList<ArrayList<int>>();
        let visited: ArrayList<bool> = new ArrayList<bool>();
        var i: int = 0;
        while (i < this.n) {
            visited.add(false);
            i = i + 1;
        }
        var v: int = 0;
        while (v < this.n) {
            if (!visited.get(v)) {
                let comp: ArrayList<int> = new ArrayList<int>();
                let queue: Queue<int> = new Queue<int>();
                visited.set(v, true);
                queue.enqueue(v);
                while (!queue.isEmpty()) {
                    let current: int = queue.dequeue();
                    comp.add(current);
                    let nbrs: ArrayList<int> = this.adj.get(current);
                    i = 0;
                    while (i < nbrs.size()) {
                        let next: int = nbrs.get(i);
                        if (!visited.get(next)) {
                            visited.set(next, true);
                            queue.enqueue(next);
                        }
                        i = i + 1;
                    }
                }
                comps.add(comp);
            }
            v = v + 1;
        }
        return comps;
    }

    public fn isConnected(): bool {
        return this.connectedComponents().size() <= 1;
    }

    public fn hasCycle(): bool {
        let visited: ArrayList<bool> = new ArrayList<bool>();
        var i: int = 0;
        while (i < this.n) {
            visited.add(false);
            i = i + 1;
        }
        i = 0;
        while (i < this.n) {
            if (!visited.get(i)) {
                if (this._cycleDFS(i, -1, visited)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    private fn _cycleDFS(v: int, parent: int, visited: ArrayList<bool>): bool {
        visited.set(v, true);
        let nbrs: ArrayList<int> = this.adj.get(v);
        var i: int = 0;
        while (i < nbrs.size()) {
            let next: int = nbrs.get(i);
            if (next == parent) { i = i + 1; continue; }
            if (visited.get(next)) { return true; }
            if (this._cycleDFS(next, v, visited)) { return true; }
            i = i + 1;
        }
        return false;
    }
}

// ==================== tests ====================

fn sameInts(a: ArrayList<int>, b: ArrayList<int>): bool {
    if (a.size() != b.size()) { return false; }
    var i: int = 0;
    while (i < a.size()) {
        if (a.get(i) != b.get(i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn ints(a: int, b: int, c: int, d: int): ArrayList<int> {
    let result: ArrayList<int> = new ArrayList<int>();
    result.add(a);
    result.add(b);
    result.add(c);
    result.add(d);
    return result;
}

public fn test_undirectedgraph_edges_degrees(): void {
    let g: UndirectedGraph = new UndirectedGraph(4);
    g.addEdge(0, 1);
    g.addEdge(1, 2);
    g.addEdge(2, 3);
    g.addEdge(3, 0);
    let ok: bool = g.vertexCount() == 4 && g.edgeCount() == 4
        && g.hasEdge(0, 1) && g.hasEdge(1, 0) && !g.hasEdge(0, 2)
        && g.degree(0) == 2 && g.degree(3) == 2 && g.degree(1) == 2;
    if (ok) {
        io::println("PASS: undirectedgraph edges/degrees");
    } else {
        io::println("FAIL: undirectedgraph edges/degrees");
    }
}

public fn test_undirectedgraph_traversals(): void {
    let g: UndirectedGraph = new UndirectedGraph(4);
    g.addEdge(0, 1);
    g.addEdge(1, 2);
    g.addEdge(2, 3);
    let bfsOk: bool = sameInts(g.bfs(0), ints(0, 1, 2, 3));
    let dfsOk: bool = sameInts(g.dfs(0), ints(0, 1, 2, 3));
    let comps: ArrayList<ArrayList<int>> = g.connectedComponents();
    let compOk: bool = comps.size() == 1 && sameInts(comps.get(0), ints(0, 1, 2, 3));
    if (bfsOk && dfsOk && compOk && g.isConnected() && !g.hasCycle()) {
        io::println("PASS: undirectedgraph BFS/DFS/components");
    } else {
        io::println("FAIL: undirectedgraph BFS/DFS/components");
    }
}

public fn test_undirectedgraph_cycle_and_components(): void {
    let g: UndirectedGraph = new UndirectedGraph(4);
    g.addEdge(0, 1);
    g.addEdge(1, 2);
    g.addEdge(2, 3);
    g.addEdge(3, 0);
    let cycleOk: bool = g.hasCycle() && g.removeEdge(3, 0) && !g.hasCycle();
    let h: UndirectedGraph = new UndirectedGraph(5);
    h.addEdge(0, 1);
    h.addEdge(2, 3);
    let parts: ArrayList<ArrayList<int>> = h.connectedComponents();
    let partsOk: bool = parts.size() == 3 && parts.get(0).size() == 2
        && parts.get(1).size() == 2 && parts.get(2).size() == 1
        && !h.isConnected();
    if (cycleOk && partsOk) {
        io::println("PASS: undirectedgraph cycle/components");
    } else {
        io::println("FAIL: undirectedgraph cycle/components");
    }
}

public fn run_all_undirectedgraph_tests(): void {
    io::println("=== datastruct/UndirectedGraph.tr Tests ===");
    test_undirectedgraph_edges_degrees();
    test_undirectedgraph_traversals();
    test_undirectedgraph_cycle_and_components();
}
