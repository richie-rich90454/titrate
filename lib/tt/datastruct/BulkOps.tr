// Single-pass bulk operations on ArrayList. Hash-based helpers (distinct,
// groupBy) avoid the quadratic membership scans a naive implementation would
// need.
import tt::util::ArrayList;
import tt::util::HashMap;
import tt::util::HashSet;

// Apply f to every element, preserving order.
public fn bulkMap<T, R>(list: ArrayList<T>, f: fn(T): R): ArrayList<R> {
    let result: ArrayList<R> = new ArrayList<R>();
    var i: int = 0;
    while (i < list.size()) {
        result.add(f(list.get(i)));
        i = i + 1;
    }
    return result;
}

// Keep the elements accepted by pred, preserving order.
public fn bulkFilter<T>(list: ArrayList<T>, pred: fn(T): bool): ArrayList<T> {
    let result: ArrayList<T> = new ArrayList<T>();
    var i: int = 0;
    while (i < list.size()) {
        let item: T = list.get(i);
        if (pred(item)) {
            result.add(item);
        }
        i = i + 1;
    }
    return result;
}

// Left fold from `initial` using f(accumulator, item).
public fn bulkFold<T, R>(list: ArrayList<T>, initial: R, f: fn(R, T): R): R {
    var acc: R = initial;
    var i: int = 0;
    while (i < list.size()) {
        acc = f(acc, list.get(i));
        i = i + 1;
    }
    return acc;
}

// Split into (accepted, rejected) in a single pass.
public fn bulkPartition<T>(list: ArrayList<T>, pred: fn(T): bool): (ArrayList<T>, ArrayList<T>) {
    let accepted: ArrayList<T> = new ArrayList<T>();
    let rejected: ArrayList<T> = new ArrayList<T>();
    var i: int = 0;
    while (i < list.size()) {
        let item: T = list.get(i);
        if (pred(item)) {
            accepted.add(item);
        } else {
            rejected.add(item);
        }
        i = i + 1;
    }
    return (accepted, rejected);
}

// Group items by a derived key using hash lookups, preserving input order
// within each group.
public fn bulkGroupBy<K, V>(list: ArrayList<V>, keyFn: fn(V): K): HashMap<K, ArrayList<V>> {
    let groups: HashMap<K, ArrayList<V>> = new HashMap<K, ArrayList<V>>();
    var i: int = 0;
    while (i < list.size()) {
        let item: V = list.get(i);
        let key: K = keyFn(item);
        if (!groups.containsKey(key)) {
            groups.put(key, new ArrayList<V>());
        }
        groups.get(key).add(item);
        i = i + 1;
    }
    return groups;
}

// Concatenate a list of lists into one list.
public fn bulkFlatten<T>(lists: ArrayList<ArrayList<T>>): ArrayList<T> {
    let result: ArrayList<T> = new ArrayList<T>();
    var i: int = 0;
    while (i < lists.size()) {
        let part: ArrayList<T> = lists.get(i);
        var j: int = 0;
        while (j < part.size()) {
            result.add(part.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// Keep first occurrences only, preserving their original order.
public fn bulkDistinct<T>(list: ArrayList<T>): ArrayList<T> {
    let seen: HashSet<T> = new HashSet<T>();
    let result: ArrayList<T> = new ArrayList<T>();
    var i: int = 0;
    while (i < list.size()) {
        let item: T = list.get(i);
        if (seen.add(item)) {
            result.add(item);
        }
        i = i + 1;
    }
    return result;
}

// Split into consecutive chunks of at most chunkSize elements. A non-positive
// chunk size yields an empty list.
public fn bulkChunk<T>(list: ArrayList<T>, chunkSize: int): ArrayList<ArrayList<T>> {
    let result: ArrayList<ArrayList<T>> = new ArrayList<ArrayList<T>>();
    if (chunkSize <= 0) { return result; }
    var i: int = 0;
    while (i < list.size()) {
        var end: int = i + chunkSize;
        if (end > list.size()) { end = list.size(); }
        result.add(list.subList(i, end));
        i = end;
    }
    return result;
}

// ==================== tests ====================

public fn test_bulkops_map_filter(): void {
    let nums: ArrayList<int> = new ArrayList<int>();
    nums.add(1);
    nums.add(2);
    nums.add(3);
    let twice: fn(int): int = fn(x: int): int { return x * 2; };
    let even: fn(int): bool = fn(x: int): bool { return x % 2 == 0; };
    let doubled: ArrayList<int> = bulkMap<int, int>(nums, twice);
    let evens: ArrayList<int> = bulkFilter<int>(nums, even);
    if (doubled.size() == 3 && doubled.get(0) == 2 && doubled.get(1) == 4 && doubled.get(2) == 6
            && evens.size() == 1 && evens.get(0) == 2) {
        io::println("PASS: bulkops map/filter");
    } else {
        io::println("FAIL: bulkops map/filter");
    }
}

public fn test_bulkops_fold_partition(): void {
    let nums: ArrayList<int> = new ArrayList<int>();
    nums.add(1);
    nums.add(2);
    nums.add(3);
    nums.add(4);
    let add: fn(int, int): int = fn(acc: int, x: int): int { return acc + x; };
    let even: fn(int): bool = fn(x: int): bool { return x % 2 == 0; };
    let total: int = bulkFold<int, int>(nums, 0, add);
    let (yes, no) = bulkPartition<int>(nums, even);
    if (total == 10 && yes.size() == 2 && yes.get(0) == 2 && yes.get(1) == 4
            && no.size() == 2 && no.get(0) == 1 && no.get(1) == 3) {
        io::println("PASS: bulkops fold/partition");
    } else {
        io::println("FAIL: bulkops fold/partition");
    }
}

public fn test_bulkops_group_by(): void {
    let words: ArrayList<string> = new ArrayList<string>();
    words.add("a");
    words.add("bb");
    words.add("c");
    words.add("dd");
    let byLength: fn(string): int = fn(s: string): int { return String_length(s); };
    let groups: HashMap<int, ArrayList<string>> = bulkGroupBy<int, string>(words, byLength);
    if (groups.size() == 2 && groups.get(1).size() == 2 && groups.get(2).size() == 2
            && groups.get(1).get(0) == "a" && groups.get(1).get(1) == "c"
            && groups.get(2).get(0) == "bb" && groups.get(2).get(1) == "dd") {
        io::println("PASS: bulkops groupBy");
    } else {
        io::println("FAIL: bulkops groupBy");
    }
}

public fn test_bulkops_flatten_distinct(): void {
    let first: ArrayList<int> = new ArrayList<int>();
    first.add(1);
    first.add(2);
    let middle: ArrayList<int> = new ArrayList<int>();
    let last: ArrayList<int> = new ArrayList<int>();
    last.add(3);
    let nested: ArrayList<ArrayList<int>> = new ArrayList<ArrayList<int>>();
    nested.add(first);
    nested.add(middle);
    nested.add(last);
    let flat: ArrayList<int> = bulkFlatten<int>(nested);
    let dups: ArrayList<int> = new ArrayList<int>();
    dups.add(3);
    dups.add(1);
    dups.add(3);
    dups.add(2);
    dups.add(1);
    let unique: ArrayList<int> = bulkDistinct<int>(dups);
    if (flat.size() == 3 && flat.get(0) == 1 && flat.get(1) == 2 && flat.get(2) == 3
            && unique.size() == 3 && unique.get(0) == 3 && unique.get(1) == 1 && unique.get(2) == 2) {
        io::println("PASS: bulkops flatten/distinct");
    } else {
        io::println("FAIL: bulkops flatten/distinct");
    }
}

public fn test_bulkops_chunk(): void {
    let nums: ArrayList<int> = new ArrayList<int>();
    nums.add(1);
    nums.add(2);
    nums.add(3);
    nums.add(4);
    nums.add(5);
    let groups: ArrayList<ArrayList<int>> = bulkChunk<int>(nums, 2);
    let none: ArrayList<ArrayList<int>> = bulkChunk<int>(nums, 0);
    if (groups.size() == 3 && groups.get(0).size() == 2 && groups.get(0).get(0) == 1
            && groups.get(0).get(1) == 2 && groups.get(1).get(1) == 4
            && groups.get(2).size() == 1 && groups.get(2).get(0) == 5
            && none.size() == 0) {
        io::println("PASS: bulkops chunk");
    } else {
        io::println("FAIL: bulkops chunk");
    }
}

public fn run_all_bulkops_tests(): void {
    io::println("=== datastruct/BulkOps.tr Tests ===");
    test_bulkops_map_filter();
    test_bulkops_fold_partition();
    test_bulkops_group_by();
    test_bulkops_flatten_distinct();
    test_bulkops_chunk();
}
