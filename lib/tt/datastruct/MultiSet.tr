// MultiSet: a sorted multiset that keeps a count for each distinct value.
import tt::util::TreeMap;

public class MultiSet<T> {
    private TreeMap<T, int> counts;
    private int total;

    public fn init() {
        this.counts = new TreeMap<T, int>();
        this.total = 0;
    }

    public fn insert(value: T): void {
        var current: int = 0;
        if (this.counts.containsKey(value)) {
            current = this.counts.get(value);
        }
        this.counts.put(value, current + 1);
        this.total = this.total + 1;
    }

    // Remove one occurrence. Returns true when the value was present.
    public fn erase(value: T): bool {
        if (!this.counts.containsKey(value)) { return false; }
        let current: int = this.counts.get(value);
        if (current == 1) {
            this.counts.remove(value);
        } else {
            this.counts.put(value, current - 1);
        }
        this.total = this.total - 1;
        return true;
    }

    public fn count(value: T): int {
        if (!this.counts.containsKey(value)) { return 0; }
        return this.counts.get(value);
    }

    public fn contains(value: T): bool {
        return this.count(value) > 0;
    }

    public fn size(): int {
        return this.total;
    }

    public fn distinctSize(): int {
        return this.counts.size();
    }

    public fn isEmpty(): bool {
        return this.total == 0;
    }

    public fn clear(): void {
        this.counts.clear();
        this.total = 0;
    }

    public fn first(): T {
        return this.counts.firstKey();
    }

    public fn last(): T {
        return this.counts.lastKey();
    }
}

// ==================== tests ====================

public fn test_multiset_counts(): void {
    let ms: MultiSet<int> = new MultiSet<int>();
    ms.insert(5);
    ms.insert(1);
    ms.insert(5);
    ms.insert(3);
    ms.insert(5);
    ms.insert(2);
    if (ms.size() == 6 && ms.distinctSize() == 4 && ms.count(5) == 3
            && ms.count(1) == 1 && ms.count(3) == 1 && ms.count(4) == 0
            && ms.contains(5) && !ms.contains(4)
            && ms.first() == 1 && ms.last() == 5) {
        io::println("PASS: multiset counts");
    } else {
        io::println("FAIL: multiset counts");
    }
}

public fn test_multiset_erase(): void {
    let ms: MultiSet<int> = new MultiSet<int>();
    ms.insert(10);
    ms.insert(20);
    ms.insert(10);
    ms.insert(10);
    let first: bool = ms.erase(10);
    let second: bool = ms.erase(10);
    let third: bool = ms.erase(10);
    let missing: bool = ms.erase(99);
    if (first && second && third && !missing && ms.size() == 1
            && ms.count(10) == 0 && ms.count(20) == 1
            && ms.first() == 20 && ms.last() == 20) {
        io::println("PASS: multiset erase");
    } else {
        io::println("FAIL: multiset erase");
    }
}

public fn test_multiset_clear(): void {
    let ms: MultiSet<int> = new MultiSet<int>();
    ms.insert(7);
    ms.insert(7);
    ms.clear();
    if (ms.isEmpty() && ms.size() == 0 && ms.distinctSize() == 0
            && ms.count(7) == 0 && ms.first() == null && ms.last() == null) {
        io::println("PASS: multiset clear");
    } else {
        io::println("FAIL: multiset clear");
    }
}

public fn run_all_multiset_tests(): void {
    io::println("=== datastruct/MultiSet.tr Tests ===");
    test_multiset_counts();
    test_multiset_erase();
    test_multiset_clear();
}
