// LsmTree: log-structured map. Writes land in a mutable memtable; flush
// publishes an immutable level. Reads check the memtable, then levels from
// newest to oldest, with tombstones shadowing older values.
import tt::util::ArrayList;
import tt::util::HashMap;

public class LsmTree {
    private HashMap<string, string> memtable;
    private HashMap<string, bool> deleted;
    private ArrayList<HashMap<string, string>> levels;
    private ArrayList<HashMap<string, bool>> levelDeletes;

    public fn init() {
        this.memtable = new HashMap<string, string>();
        this.deleted = new HashMap<string, bool>();
        this.levels = new ArrayList<HashMap<string, string>>();
        this.levelDeletes = new ArrayList<HashMap<string, bool>>();
    }

    public fn levelCount(): int {
        return this.levels.size();
    }

    public fn put(key: string, value: string): void {
        this.deleted.remove(key);
        this.memtable.put(key, value);
    }

    public fn get(key: string): string {
        if (this.deleted.containsKey(key)) { return null; }
        if (this.memtable.containsKey(key)) { return this.memtable.get(key); }
        var i: int = this.levels.size() - 1;
        while (i >= 0) {
            if (this.levelDeletes.get(i).containsKey(key)) { return null; }
            let level: HashMap<string, string> = this.levels.get(i);
            if (level.containsKey(key)) { return level.get(key); }
            i = i - 1;
        }
        return null;
    }

    public fn remove(key: string): void {
        this.memtable.remove(key);
        this.deleted.put(key, true);
    }

    // Snapshot the memtable into an immutable level and start a fresh one.
    public fn flush(): void {
        if (this.memtable.size() == 0 && this.deleted.size() == 0) { return; }
        let snapshot: HashMap<string, string> = new HashMap<string, string>();
        let keys: ArrayList<string> = this.memtable.keys();
        var i: int = 0;
        while (i < keys.size()) {
            snapshot.put(keys.get(i), this.memtable.get(keys.get(i)));
            i = i + 1;
        }
        let tombstones: HashMap<string, bool> = new HashMap<string, bool>();
        let removedKeys: ArrayList<string> = this.deleted.keys();
        i = 0;
        while (i < removedKeys.size()) {
            tombstones.put(removedKeys.get(i), true);
            i = i + 1;
        }
        this.levels.add(snapshot);
        this.levelDeletes.add(tombstones);
        this.memtable.clear();
        this.deleted.clear();
    }

    // Number of keys whose current value is not a tombstone.
    public fn size(): int {
        let seen: HashMap<string, bool> = new HashMap<string, bool>();
        var count: int = 0;
        let keys: ArrayList<string> = this.memtable.keys();
        var i: int = 0;
        while (i < keys.size()) {
            let key: string = keys.get(i);
            if (!seen.containsKey(key)) {
                seen.put(key, true);
                if (this.get(key) != null) { count = count + 1; }
            }
            i = i + 1;
        }
        i = this.levels.size() - 1;
        while (i >= 0) {
            let levelKeys: ArrayList<string> = this.levels.get(i).keys();
            var j: int = 0;
            while (j < levelKeys.size()) {
                let key: string = levelKeys.get(j);
                if (!seen.containsKey(key)) {
                    seen.put(key, true);
                    if (this.get(key) != null) { count = count + 1; }
                }
                j = j + 1;
            }
            i = i - 1;
        }
        return count;
    }
}

// ==================== tests ====================

public fn test_lsm_put_get(): void {
    let tree: LsmTree = new LsmTree();
    tree.put("a", "1");
    tree.put("b", "2");
    if (tree.size() == 2 && tree.get("a") == "1" && tree.get("b") == "2"
            && tree.get("z") == null && tree.levelCount() == 0) {
        io::println("PASS: lsm put/get/size");
    } else {
        io::println("FAIL: lsm put/get/size");
    }
}

public fn test_lsm_flush(): void {
    let tree: LsmTree = new LsmTree();
    tree.put("a", "1");
    tree.put("b", "2");
    tree.flush();
    tree.put("a", "3");
    if (tree.levelCount() == 1 && tree.get("a") == "3" && tree.get("b") == "2"
            && tree.size() == 2) {
        io::println("PASS: lsm flush and newest-wins reads");
    } else {
        io::println("FAIL: lsm flush and newest-wins reads");
    }
}

public fn test_lsm_tombstones(): void {
    let tree: LsmTree = new LsmTree();
    tree.put("a", "1");
    tree.put("b", "2");
    tree.flush();
    tree.remove("a");
    tree.flush();
    tree.put("c", "4");
    if (tree.levelCount() == 2 && tree.get("a") == null && tree.get("b") == "2"
            && tree.get("c") == "4" && tree.size() == 2) {
        io::println("PASS: lsm persistent tombstones");
    } else {
        io::println("FAIL: lsm persistent tombstones");
    }
}

public fn run_all_lsmtree_tests(): void {
    io::println("=== datastruct/LsmTree.tr Tests ===");
    test_lsm_put_get();
    test_lsm_flush();
    test_lsm_tombstones();
}
