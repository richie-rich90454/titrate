// Fixed-capacity single-producer single-consumer ring channel. send/trySend
// and receive/tryReceive are explicit non-blocking pairs; a full channel
// refuses a send and an empty channel yields null rather than dropping data.
// shortcut: deterministic single-threaded emulation; add locking and real handoff before sharing across threads.
import tt::util::ArrayList;

public class RingChannel<T> {
    private ArrayList<T> buf;
    private int head;
    private int count;
    private int capacity;

    public fn init(capacity: int) {
        if (capacity < 1) { capacity = 1; }
        this.capacity = capacity;
        this.buf = new ArrayList<T>();
        var i: int = 0;
        while (i < capacity) {
            this.buf.add(null);
            i = i + 1;
        }
        this.head = 0;
        this.count = 0;
    }

    private fn tailIndex(): int {
        return (this.head + this.count) % this.capacity;
    }

    public fn send(value: T): bool {
        if (this.count == this.capacity) { return false; }
        this.buf.set(this.tailIndex(), value);
        this.count = this.count + 1;
        return true;
    }

    public fn trySend(value: T): bool {
        return this.send(value);
    }

    public fn receive(): T {
        if (this.count == 0) { return null; }
        let value: T = this.buf.get(this.head);
        this.buf.set(this.head, null);
        this.head = (this.head + 1) % this.capacity;
        this.count = this.count - 1;
        return value;
    }

    public fn tryReceive(): T {
        return this.receive();
    }

    public fn capacity(): int { return this.capacity; }
    public fn size(): int { return this.count; }
    public fn isEmpty(): bool { return this.count == 0; }
    public fn isFull(): bool { return this.count == this.capacity; }

    public fn clear(): void {
        var i: int = 0;
        while (i < this.capacity) {
            this.buf.set(i, null);
            i = i + 1;
        }
        this.head = 0;
        this.count = 0;
    }
}

// ==================== tests ====================

public fn test_rc_send_receive_fifo(): void {
    let ch: RingChannel<int> = new RingChannel<int>(3);
    let emptyAtStart: bool = ch.isEmpty() && ch.receive() == null;
    let a: bool = ch.send(1);
    let b: bool = ch.trySend(2);
    let c: bool = ch.send(3);
    let overflow: bool = ch.trySend(4);
    let fullBefore: bool = ch.isFull();
    let sizeBefore: int = ch.size();
    let r1: int = ch.receive();
    let r2: int = ch.tryReceive();
    if (emptyAtStart && a && b && c && !overflow && fullBefore
            && ch.capacity() == 3 && sizeBefore == 3
            && r1 == 1 && r2 == 2) {
        io::println("PASS: ringchannel send/receive FIFO");
    } else {
        io::println("FAIL: ringchannel send/receive FIFO");
    }
}

public fn test_rc_ring_wraparound(): void {
    let ch: RingChannel<string> = new RingChannel<string>(3);
    ch.send("a");
    ch.send("b");
    ch.send("c");
    let first: string = ch.receive();
    ch.send("d");
    let second: string = ch.receive();
    let third: string = ch.receive();
    let fourth: string = ch.receive();
    let fifth: string = ch.receive();
    if (first == "a" && second == "b" && third == "c" && fourth == "d"
            && fifth == null && ch.isEmpty() && ch.size() == 0) {
        io::println("PASS: ringchannel wraparound");
    } else {
        io::println("FAIL: ringchannel wraparound");
    }
}

public fn test_rc_capacity_and_clear(): void {
    let ch: RingChannel<int> = new RingChannel<int>(2);
    ch.send(7);
    ch.send(8);
    ch.clear();
    let afterClear: bool = ch.isEmpty() && ch.size() == 0 && !ch.isFull()
            && ch.capacity() == 2 && ch.receive() == null;
    let minimum: RingChannel<int> = new RingChannel<int>(0);
    if (afterClear && minimum.capacity() == 1 && minimum.send(5)
            && minimum.isFull() && !minimum.send(6) && minimum.receive() == 5) {
        io::println("PASS: ringchannel capacity/clear");
    } else {
        io::println("FAIL: ringchannel capacity/clear");
    }
}

public fn run_all_ringchannel_tests(): void {
    io::println("=== datastruct/RingChannel.tr Tests ===");
    test_rc_send_receive_fifo();
    test_rc_ring_wraparound();
    test_rc_capacity_and_clear();
}
