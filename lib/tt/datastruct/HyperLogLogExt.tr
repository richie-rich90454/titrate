// HyperLogLogExt: cardinality estimator with an explicit precision parameter.
// Registers start sparse (a map of nonzero registers) and convert to a dense
// array once more than half the registers are occupied.
import tt::util::ArrayList;
import tt::util::HashMap;

public class HyperLogLogExt {
    private int _precision;
    private int regCount;
    private int threshold;
    private HashMap<int, int> sparse;
    private ArrayList<int> dense;
    private bool denseMode;

    public fn init(precision: int) {
        var p: int = precision;
        if (p < 1) { p = 1; }
        if (p > 16) { p = 16; }
        this._precision = p;
        var count: int = 1;
        var i: int = 0;
        while (i < p) {
            count = count * 2;
            i = i + 1;
        }
        this.regCount = count;
        this.threshold = count / 2;
        if (this.threshold < 1) { this.threshold = 1; }
        this.sparse = new HashMap<int, int>();
        this.dense = new ArrayList<int>();
        this.denseMode = false;
    }

    public fn precision(): int {
        return this._precision;
    }

    public fn size(): int {
        return this.regCount;
    }

    public fn isDense(): bool {
        return this.denseMode;
    }

    public fn sparseSize(): int {
        return this.sparse.size();
    }

    public fn registerAt(index: int): int {
        if (index < 0 || index >= this.regCount) {
            return -1;
        }
        if (this.denseMode) {
            return this.dense.get(index);
        }
        if (!this.sparse.containsKey(index)) {
            return 0;
        }
        return this.sparse.get(index);
    }

    private fn convertToDense(): void {
        this.dense = new ArrayList<int>();
        var i: int = 0;
        while (i < this.regCount) {
            this.dense.add(0);
            i = i + 1;
        }
        let keys: ArrayList<int> = this.sparse.keys();
        i = 0;
        while (i < keys.size()) {
            this.dense.set(keys.get(i), this.sparse.get(keys.get(i)));
            i = i + 1;
        }
        this.sparse.clear();
        this.denseMode = true;
    }

    public fn add(hash: int): void {
        let h: int = hash & 0x7FFFFFFF;
        let idx: int = h & (this.regCount - 1);
        let rest: int = h >> this._precision;
        var rho: int = 1;
        var mask: int = 1 << (31 - this._precision - 1);
        while (mask != 0 && (rest & mask) == 0) {
            rho = rho + 1;
            mask = mask >> 1;
        }
        if (this.denseMode) {
            if (rho > this.dense.get(idx)) {
                this.dense.set(idx, rho);
            }
            return;
        }
        if (!this.sparse.containsKey(idx) || rho > this.sparse.get(idx)) {
            this.sparse.put(idx, rho);
        }
        if (this.sparse.size() > this.threshold) {
            this.convertToDense();
        }
    }

    // Harmonic-mean estimate with the standard small-range linear correction.
    public fn estimate(): double {
        var z: double = 0.0;
        var zeros: int = 0;
        var i: int = 0;
        while (i < this.regCount) {
            let r: int = this.registerAt(i);
            z = z + Math_pow(2.0, -(r as double));
            if (r == 0) {
                zeros = zeros + 1;
            }
            i = i + 1;
        }
        let m: double = this.regCount as double;
        var alpha: double = 0.7213 / (1.0 + 1.079 / m);
        if (this.regCount == 16) { alpha = 0.673; }
        else if (this.regCount == 32) { alpha = 0.697; }
        else if (this.regCount == 64) { alpha = 0.709; }
        var e: double = alpha * m * m / z;
        if (e <= 2.5 * m && zeros > 0) {
            e = m * Math_ln(m / (zeros as double));
        }
        return e;
    }
}

// ==================== tests ====================

public fn test_hyperloglogext_sparse(): void {
    let h: HyperLogLogExt = new HyperLogLogExt(4);
    // 3 & 15 = 3, remainder 0 => rho = 28.
    h.add(3);
    if (h.precision() == 4 && h.size() == 16 && !h.isDense()
            && h.sparseSize() == 1 && h.registerAt(3) == 28
            && h.registerAt(4) == 0 && h.registerAt(16) == -1) {
        io::println("PASS: hyperloglogext sparse register");
    } else {
        io::println("FAIL: hyperloglogext sparse register");
    }
    // Z = 15 + 2^-28, E = 0.673*256/Z is small, so linear counting gives
    // 16*ln(16/15) = 1.032616...
    if (Math_abs(h.estimate() - 1.032616) < 0.001) {
        io::println("PASS: hyperloglogext sparse estimate");
    } else {
        io::println("FAIL: hyperloglogext sparse estimate");
    }
}

public fn test_hyperloglogext_dense(): void {
    let h: HyperLogLogExt = new HyperLogLogExt(4);
    // (1 << 30) + i selects register i with rho = 1.
    var i: int = 0;
    while (i < 16) {
        h.add((1 << 30) + i);
        i = i + 1;
    }
    // All 16 registers are 1: Z = 8, E = 0.673*256/8 = 21.536.
    if (h.isDense() && h.sparseSize() == 0 && h.registerAt(0) == 1
            && h.registerAt(15) == 1 && Math_abs(h.estimate() - 21.536) < 0.001) {
        io::println("PASS: hyperloglogext dense conversion");
    } else {
        io::println("FAIL: hyperloglogext dense conversion");
    }
}

public fn test_hyperloglogext_conversion_keeps_max(): void {
    let h: HyperLogLogExt = new HyperLogLogExt(4);
    h.add(3);
    var i: int = 0;
    while (i < 9) {
        h.add((1 << 30) + i);
        i = i + 1;
    }
    // Nine occupied registers exceed the threshold of 8, so conversion
    // happens and register 3 keeps its rho of 28.
    // Z = 15/2 + 2^-28; linear counting applies with 7 empty registers:
    // 16*ln(16/7) = 13.226857...
    if (h.isDense() && h.registerAt(3) == 28 && h.registerAt(0) == 1
            && h.estimate() > 13.2 && h.estimate() < 13.3) {
        io::println("PASS: hyperloglogext conversion keeps max");
    } else {
        io::println("FAIL: hyperloglogext conversion keeps max");
    }
}

public fn run_all_hyperloglogext_tests(): void {
    io::println("=== datastruct/HyperLogLogExt.tr Tests ===");
    test_hyperloglogext_sparse();
    test_hyperloglogext_dense();
    test_hyperloglogext_conversion_keeps_max();
}
