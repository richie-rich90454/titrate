import tt::util::ArrayList;
import tt::math::ndarray::NDArray;

// Basic linear algebra on 2D NDArrays.

public fn matmul(a: NDArray<double>, b: NDArray<double>): NDArray<double> {
    if (a.ndim() != 2 || b.ndim() != 2 || a.cols() != b.rows()) {
        return new NDArray<double>();
    }
    let rows: int = a.rows();
    let inner: int = a.cols();
    let cols: int = b.cols();
    let shape: ArrayList<int> = new ArrayList<int>();
    shape.add(rows);
    shape.add(cols);
    let result: NDArray<double> = zeros(shape);
    var i: int = 0;
    while (i < rows) {
        var j: int = 0;
        while (j < cols) {
            var s: double = 0.0;
            var k: int = 0;
            while (k < inner) {
                s = s + a.get2D(i, k) * b.get2D(k, j);
                k = k + 1;
            }
            result.set2D(i, j, s);
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

public fn matVec(a: NDArray<double>, v: NDArray<double>): NDArray<double> {
    if (a.ndim() != 2 || v.ndim() != 1 || a.cols() != v.size()) {
        return new NDArray<double>();
    }
    let shape: ArrayList<int> = new ArrayList<int>();
    shape.add(a.rows());
    let result: NDArray<double> = zeros(shape);
    var i: int = 0;
    while (i < a.rows()) {
        var s: double = 0.0;
        var j: int = 0;
        while (j < a.cols()) {
            s = s + a.get2D(i, j) * v.getFlat(j);
            j = j + 1;
        }
        result.setFlat(i, s);
        i = i + 1;
    }
    return result;
}

public fn dot(a: NDArray<double>, b: NDArray<double>): double {
    if (a.size() != b.size()) { return 0.0; }
    var s: double = 0.0;
    var i: int = 0;
    while (i < a.size()) {
        s = s + a.getFlat(i) * b.getFlat(i);
        i = i + 1;
    }
    return s;
}

public fn trace(a: NDArray<double>): double {
    if (a.ndim() != 2 || a.rows() != a.cols()) { return 0.0; }
    var s: double = 0.0;
    var i: int = 0;
    while (i < a.rows()) {
        s = s + a.get2D(i, i);
        i = i + 1;
    }
    return s;
}

// ---- Tests ----

fn linalgApprox(a: double, b: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < 1e-9;
}

fn linalgMatrix(rows: int, cols: int, first: double): NDArray<double> {
    let shape: ArrayList<int> = new ArrayList<int>();
    shape.add(rows);
    shape.add(cols);
    let values: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < rows * cols) {
        values.add(first + i as double);
        i = i + 1;
    }
    return fromData<double>(shape, values);
}

fn linalgVec(n: int, first: double): NDArray<double> {
    let shape: ArrayList<int> = new ArrayList<int>();
    shape.add(n);
    let values: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < n) {
        values.add(first + i as double);
        i = i + 1;
    }
    return fromData<double>(shape, values);
}

fn testLinalgMatmul(): void {
    let a: NDArray<double> = linalgMatrix(2, 3, 1.0);
    let b: NDArray<double> = linalgMatrix(3, 2, 1.0);
    let c: NDArray<double> = matmul(a, b);
    let ok: bool = c.rows() == 2 && c.cols() == 2
        && linalgApprox(c.get2D(0, 0), 22.0) && linalgApprox(c.get2D(0, 1), 28.0)
        && linalgApprox(c.get2D(1, 0), 49.0) && linalgApprox(c.get2D(1, 1), 64.0);
    if (ok) {
        io::println("PASS testLinalgMatmul: 2x3 times 3x2 matrix product");
    } else {
        io::println("FAIL testLinalgMatmul");
    }
}

fn testLinalgMatVec(): void {
    let a: NDArray<double> = linalgMatrix(2, 2, 1.0);
    let v: NDArray<double> = linalgVec(2, 1.0);
    let r: NDArray<double> = matVec(a, v);
    let ok: bool = r.size() == 2 && linalgApprox(r.getFlat(0), 5.0) && linalgApprox(r.getFlat(1), 11.0);
    if (ok) {
        io::println("PASS testLinalgMatVec: matrix times vector");
    } else {
        io::println("FAIL testLinalgMatVec");
    }
}

fn testLinalgDotAndTrace(): void {
    let v: NDArray<double> = linalgVec(3, 1.0);
    let a: NDArray<double> = linalgMatrix(3, 3, 1.0);
    let ok: bool = linalgApprox(dot(v, v), 14.0) && linalgApprox(trace(a), 15.0);
    if (ok) {
        io::println("PASS testLinalgDotAndTrace: dot = 14, trace = 15");
    } else {
        io::println("FAIL testLinalgDotAndTrace");
    }
}

fn testLinalgMismatch(): void {
    let a: NDArray<double> = linalgMatrix(2, 3, 1.0);
    let b: NDArray<double> = linalgMatrix(2, 2, 1.0);
    if (matmul(a, b).size() == 0) {
        io::println("PASS testLinalgMismatch: incompatible shapes return an empty array");
    } else {
        io::println("FAIL testLinalgMismatch");
    }
}

public fn run_all_ndarray_linalg_tests(): void {
    io::println("=== NDArrayLinalg tests ===");
    testLinalgMatmul();
    testLinalgMatVec();
    testLinalgDotAndTrace();
    testLinalgMismatch();
}
