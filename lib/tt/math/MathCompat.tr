// MathCompat provides binomial, power, logarithmic, and exact-integer
// helpers backing the Math module. Math.tr keeps thin delegating shims
// so every routine stays callable as Math.xxx.
import tt::util::ArrayList;

// ==================== Binomial expansion and logarithm helpers ====================

// Binomial coefficient returning long (internal helper)
public fn combLong(n: int, k: int): long {
    if (k < 0 || k > n) { return 0; }
    if (k == 0 || k == n) { return 1; }
    var kk: int = k;
    if (kk > n - kk) { kk = n - kk; }
    var result: long = 1;
    var i: int = 0;
    while (i < kk) {
        result = result * ((n - i) as long);
        result = result / ((i + 1) as long);
        i = i + 1;
    }
    return result;
}

// Full row of Pascal's triangle: C(n,0) through C(n,n)
public fn binomialExpansion(n: int): ArrayList<long> {
    let row: ArrayList<long> = new ArrayList<long>();
    var k: int = 0;
    while (k <= n) {
        row.add(combLong(n, k));
        k = k + 1;
    }
    return row;
}

// Single binomial term: C(n,k) * x^k * (1-x)^(n-k)
public fn binomialTerm(n: int, k: int, x: double): double {
    let coeff: double = combLong(n, k) as double;
    return coeff * pow(x, k as double) * pow(1.0 - x, (n - k) as double);
}

// Change of base for logarithms: log_toBase(value) using base-2 as intermediate
public fn changeOfBase(value: double, fromBase: double, toBase: double): double {
    return ln(value) / ln(toBase);
}

// Pascal triangle and integer power helpers

// Same as binomialExpansion: full row of Pascal's triangle
public fn pascalsTriangleRow(n: int): ArrayList<long> {
    return binomialExpansion(n);
}

// All rows of Pascal's triangle from row 0 through row n
public fn pascalsTriangle(n: int): ArrayList<ArrayList<long>> {
    let triangle: ArrayList<ArrayList<long>> = new ArrayList<ArrayList<long>>();
    var row: int = 0;
    while (row <= n) {
        triangle.add(binomialExpansion(row));
        row = row + 1;
    }
    return triangle;
}

// Check if n is an exact power of base
public fn isPowerOf(n: double, base: double): bool {
    if (n <= 0.0 || base <= 0.0 || base == 1.0) { return false; }
    let logVal: double = ln(n) / ln(base);
    let rounded: double = Math.round(logVal) as double;
    var diff: double = logVal - rounded;
    if (diff < 0.0) { diff = -diff; }
    return diff < 1e-10;
}

// Nearest power of base to n
public fn nearestPowerOf(n: double, base: double): double {
    let logVal: double = ln(n) / ln(base);
    let rounded: long = Math.round(logVal);
    return pow(base, rounded as double);
}

// Permutation P(n, k) returning long for larger results
public fn permLong(n: int, k: int): long {
    if (k < 0 || k > n) { return 0; }
    var result: long = 1;
    var i: int = 0;
    while (i < k) {
        result = result * ((n - i) as long);
        i = i + 1;
    }
    return result;
}

// modf returning ArrayList<double> [fractional, integer] parts
public fn modfList(x: double): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    let intPart: double = Math_floor(Math_abs(x));
    var signedInt: double = intPart;
    if (x < 0.0) { signedInt = -intPart; }
    let fracPart: double = x - signedInt;
    result.add(fracPart);
    result.add(signedInt);
    return result;
}

// frexp returning ArrayList<double> [mantissa, exponent-as-double]
public fn frexpList(x: double): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    if (x == 0.0) {
        result.add(0.0);
        result.add(0.0);
        return result;
    }
    var exp: int = 0;
    var mantissa: double = Math_abs(x);
    if (mantissa >= 1.0) {
        while (mantissa >= 1.0) {
            mantissa = mantissa / 2.0;
            exp = exp + 1;
        }
    } else {
        while (mantissa < 0.5 && mantissa > 0.0) {
            mantissa = mantissa * 2.0;
            exp = exp - 1;
        }
    }
    if (x < 0.0) { mantissa = -mantissa; }
    result.add(mantissa);
    result.add(exp as double);
    return result;
}

// Return the next representable float after x in the direction of y.
public fn nextAfter(x: double, y: double): double {
    if (x == y) { return x; }
    if (y > x) {
        return Math_nextUp(x);
    } else {
        return Math_nextDown(x);
    }
}

// ==================== Logarithmic, exponential, power ====================
// (Relocated from MathAdvanced so every math routine is a Math method.)

// Natural logarithm
public fn ln(x: double): double {
    return Math_ln(x);
}

// Logarithm base `base` of x
public fn log(base: double, x: double): double {
    return Math_ln(x) / Math_ln(base);
}

// e^x
public fn exp(x: double): double {
    return Math_exp(x);
}

// base raised to exp
public fn pow(base: double, exp: double): double {
    return Math_pow(base, exp);
}

// Square root
public fn sqrt(x: double): double {
    return Math_sqrt(x);
}

// Magnitude of x with the sign of y
public fn copySign(magnitude: double, sign: double): double {
    if (sign < 0.0) {
        if (magnitude < 0.0) { return magnitude; }
        return -magnitude;
    }
    if (magnitude < 0.0) { return -magnitude; }
    return magnitude;
}

// Unit in the last place
public fn ulp(x: double): double {
    return Math_ulp(x);
}

// Unbiased exponent
public fn getExponent(x: double): int {
    return Math_getExponent(x);
}

// x scaled by 2^scaleFactor
public fn scalb(x: double, scaleFactor: int): double {
    return Math_scalb(x, scaleFactor);
}

// Integer division that floors toward negative infinity
public fn floorDiv(a: long, b: long): long {
    let q: long = a / b;
    if ((a ^ b) < 0 && q * b != a) {
        q = q - 1;
    }
    return q;
}

// Floor modulus
public fn floorMod(a: long, b: long): long {
    return a - floorDiv(a, b) * b;
}

// Exact arithmetic (returns clamped value on overflow)
public fn addExact(a: long, b: long): long {
    let result: long = a + b;
    if (((a ^ result) & (b ^ result)) < 0) {
        return Math_maxInt();
    }
    return result;
}

public fn subtractExact(a: long, b: long): long {
    let result: long = a - b;
    if (((a ^ b) & (a ^ result)) < 0) {
        return Math_minInt();
    }
    return result;
}

public fn multiplyExact(a: long, b: long): long {
    let result: long = a * b;
    if (a != 0 && result / a != b) {
        return Math_maxInt();
    }
    return result;
}

public fn incrementExact(a: long): long {
    if (a == Math_maxInt()) { return Math_maxInt(); }
    return a + 1;
}

public fn decrementExact(a: long): long {
    if (a == Math_minInt()) { return Math_minInt(); }
    return a - 1;
}

public fn negateExact(a: long): long {
    if (a == Math_minInt()) { return Math_maxInt(); }
    return -a;
}

public fn toIntExact(value: long): int {
    if (value > 2147483647L) { return 2147483647; }
    if (value < -2147483648L) { return -2147483648; }
    return value as int;
}
