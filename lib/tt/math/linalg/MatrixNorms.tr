import tt::util::ArrayList;
import tt::math::ndarray::NDArray;
import tt::math::Math;
import tt::math::MathAdvanced;

// Matrix norms for 2D NDArrays: Frobenius, L1, spectral L2, and infinity.

public fn frobenius(a: NDArray<double>): double {
    var s: double = 0.0;
    var i: int = 0;
    while (i < a.data.size()) {
        let v: double = a.data.get(i);
        s = s + v * v;
        i = i + 1;
    }
    return MathAdvanced.sqrt(s);
}

public fn normFrobenius(a: NDArray<double>): double {
    return frobenius(a);
}

// Maximum absolute column sum.
public fn l1(a: NDArray<double>): double {
    var best: double = 0.0;
    var j: int = 0;
    while (j < a.cols()) {
        var total: double = 0.0;
        var i: int = 0;
        while (i < a.rows()) {
            total = total + Math.abs(a.get2D(i, j));
            i = i + 1;
        }
        if (total > best) { best = total; }
        j = j + 1;
    }
    return best;
}

public fn norm1(a: NDArray<double>): double {
    return l1(a);
}

// Maximum absolute row sum.
public fn infinity(a: NDArray<double>): double {
    var best: double = 0.0;
    var i: int = 0;
    while (i < a.rows()) {
        var total: double = 0.0;
        var j: int = 0;
        while (j < a.cols()) {
            total = total + Math.abs(a.get2D(i, j));
            j = j + 1;
        }
        if (total > best) { best = total; }
        i = i + 1;
    }
    return best;
}

public fn normInf(a: NDArray<double>): double {
    return infinity(a);
}

// Largest singular value, computed by power iteration on A-transpose-A.
public fn l2(a: NDArray<double>): double {
    let m: int = a.rows();
    let n: int = a.cols();
    if (m == 0 || n == 0) { return 0.0; }
    let x: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < n) {
        x.add(1.0);
        i = i + 1;
    }

    var iter: int = 0;
    while (iter < 100) {
        let ax: ArrayList<double> = new ArrayList<double>();
        i = 0;
        while (i < m) {
            var sum: double = 0.0;
            var j: int = 0;
            while (j < n) {
                sum = sum + a.get2D(i, j) * x.get(j);
                j = j + 1;
            }
            ax.add(sum);
            i = i + 1;
        }
        let next: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < n) {
            var total: double = 0.0;
            i = 0;
            while (i < m) {
                total = total + a.get2D(i, j) * ax.get(i);
                i = i + 1;
            }
            next.add(total);
            j = j + 1;
        }
        var scale: double = 0.0;
        j = 0;
        while (j < n) {
            let mag: double = Math.abs(next.get(j));
            if (mag > scale) { scale = mag; }
            j = j + 1;
        }
        if (scale == 0.0) { return 0.0; }
        j = 0;
        while (j < n) {
            x.set(j, next.get(j) / scale);
            j = j + 1;
        }
        iter = iter + 1;
    }

    var numerator: double = 0.0;
    var denominator: double = 0.0;
    i = 0;
    while (i < m) {
        var value: double = 0.0;
        var j: int = 0;
        while (j < n) {
            value = value + a.get2D(i, j) * x.get(j);
            j = j + 1;
        }
        numerator = numerator + value * value;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        let component: double = x.get(i);
        denominator = denominator + component * component;
        i = i + 1;
    }
    if (denominator == 0.0) { return 0.0; }
    return MathAdvanced.sqrt(numerator / denominator);
}

public fn norm2(a: NDArray<double>): double {
    return l2(a);
}

// ---- Tests ----

fn normsApprox(a: double, b: double, tol: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < tol;
}

fn normsMatrix(a: double, b: double, c: double, d: double): NDArray<double> {
    let shape: ArrayList<int> = new ArrayList<int>();
    shape.add(2);
    shape.add(2);
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(a);
    values.add(b);
    values.add(c);
    values.add(d);
    return NDArray.fromData<double>(shape, values);
}

fn testNormsDiagonal(): void {
    let m: NDArray<double> = normsMatrix(3.0, 0.0, 0.0, 4.0);
    let ok: bool = normsApprox(frobenius(m), 5.0, 1e-9)
        && normsApprox(l1(m), 4.0, 1e-9)
        && normsApprox(l2(m), 4.0, 1e-6)
        && normsApprox(infinity(m), 4.0, 1e-9);
    if (ok) {
        io::println("PASS testNormsDiagonal: all four norms of diag(3,4)");
    } else {
        io::println("FAIL testNormsDiagonal");
    }
}

fn testNormsGeneral(): void {
    let m: NDArray<double> = normsMatrix(1.0, 2.0, 3.0, 4.0);
    let ok: bool = normsApprox(frobenius(m), MathAdvanced.sqrt(30.0), 1e-9)
        && normsApprox(l1(m), 6.0, 1e-9)
        && normsApprox(infinity(m), 7.0, 1e-9)
        && normsApprox(l2(m), 5.465032, 1e-5);
    if (ok) {
        io::println("PASS testNormsGeneral: Frobenius/L1/L2/infinity of [[1,2],[3,4]]");
    } else {
        io::println("FAIL testNormsGeneral: got " + Double.toString(l2(m)));
    }
}

fn testNormsEmpty(): void {
    let m: NDArray<double> = new NDArray<double>();
    let ok: bool = frobenius(m) == 0.0 && l1(m) == 0.0 && l2(m) == 0.0 && infinity(m) == 0.0;
    if (ok) {
        io::println("PASS testNormsEmpty: empty matrix has zero norms");
    } else {
        io::println("FAIL testNormsEmpty");
    }
}

public fn run_all_matrix_norms_tests(): void {
    io::println("=== MatrixNorms tests ===");
    testNormsDiagonal();
    testNormsGeneral();
    testNormsEmpty();
}
