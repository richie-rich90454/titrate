// Noise provides deterministic, seedable value noise in one and two dimensions
// plus fractional Brownian motion. No global state is involved: identical inputs
// always produce identical values on every backend.
import tt::math::Math;

// Deterministic hash mapped into [0, 1).
public fn hash01(x: int, y: int, seed: int): double {
    var h: long = (x as long) * 374761393L + (y as long) * 668265263L + (seed as long) * 1442695041L;
    h = h % 2147483647L;
    if (h < 0L) { h = h + 2147483647L; }
    return (h as double) / 2147483647.0;
}

public fn smoothstep(t: double): double {
    return t * t * (3.0 - 2.0 * t);
}

public fn lerp(a: double, b: double, t: double): double {
    return a + (b - a) * t;
}

public fn valueNoise1D(x: double, seed: int): double {
    let i: int = Math.floor(x) as int;
    let f: double = x - (i as double);
    return lerp(hash01(i, 0, seed), hash01(i + 1, 0, seed), smoothstep(f));
}

public fn valueNoise2D(x: double, y: double, seed: int): double {
    let ix: int = Math.floor(x) as int;
    let iy: int = Math.floor(y) as int;
    let fx: double = x - (ix as double);
    let fy: double = y - (iy as double);
    let u: double = smoothstep(fx);
    let v: double = smoothstep(fy);
    let bottom: double = lerp(hash01(ix, iy, seed), hash01(ix + 1, iy, seed), u);
    let top: double = lerp(hash01(ix, iy + 1, seed), hash01(ix + 1, iy + 1, seed), u);
    return lerp(bottom, top, v);
}

// Fractal sum of octaves, normalised back into [0, 1).
public fn fbm1D(x: double, seed: int, octaves: int): double {
    var total: double = 0.0;
    var amplitude: double = 1.0;
    var frequency: double = 1.0;
    var norm: double = 0.0;
    var o: int = 0;
    while (o < octaves) {
        total = total + amplitude * valueNoise1D(x * frequency, seed + o);
        norm = norm + amplitude;
        amplitude = amplitude * 0.5;
        frequency = frequency * 2.0;
        o = o + 1;
    }
    if (norm == 0.0) { return 0.0; }
    return total / norm;
}

// ==================== tests ====================

public fn test_noise_interpolation(): void {
    if (smoothstep(0.0) == 0.0 && smoothstep(1.0) == 1.0
            && smoothstep(0.5) == 0.5 && lerp(0.0, 10.0, 0.25) == 2.5
            && lerp(3.0, 3.0, 0.7) == 3.0) {
        io::println("PASS: noise interpolation");
    } else {
        io::println("FAIL: noise interpolation");
    }
}

public fn test_noise_hash(): void {
    let h: double = hash01(7, 9, 3);
    if (h == hash01(7, 9, 3) && h >= 0.0 && h < 1.0
            && hash01(0, 0, 0) == 0.0) {
        io::println("PASS: noise hash");
    } else {
        io::println("FAIL: noise hash");
    }
}

public fn test_noise_lattice(): void {
    let seed: int = 42;
    if (valueNoise1D(2.0, seed) == hash01(2, 0, seed)
            && valueNoise2D(2.0, 3.0, seed) == hash01(2, 3, seed)) {
        io::println("PASS: noise lattice");
    } else {
        io::println("FAIL: noise lattice");
    }
}

public fn test_noise_ranges_and_fbm(): void {
    let a: double = valueNoise1D(2.5, 11);
    let b: double = valueNoise2D(1.3, 4.7, 11);
    if (a >= 0.0 && a <= 1.0 && b >= 0.0 && b <= 1.0
            && fbm1D(2.5, 11, 1) == valueNoise1D(2.5, 11)
            && fbm1D(2.5, 11, 0) == 0.0) {
        io::println("PASS: noise ranges and fbm");
    } else {
        io::println("FAIL: noise ranges and fbm");
    }
}

public fn run_all_noise_tests(): void {
    io::println("=== math/Noise.tr Tests ===");
    test_noise_interpolation();
    test_noise_hash();
    test_noise_lattice();
    test_noise_ranges_and_fbm();
}
