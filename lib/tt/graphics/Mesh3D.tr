// Mesh3D — polygon mesh stored as flat vertex and face arrays.
//
// Geometry math (face cross products, normal accumulation, centroid) stays in
// Titrate. No host GPU buffer is touched here.
import tt::util::ArrayList;
import tt::math::MathAdvanced;

public class Mesh3D {
    public ArrayList<double> vertices;
    public ArrayList<int> faces;

    public fn init() {
        this.vertices = new ArrayList<double>();
        this.faces = new ArrayList<int>();
    }

    public fn addVertex(x: double, y: double, z: double): int {
        this.vertices.add(x);
        this.vertices.add(y);
        this.vertices.add(z);
        return this.vertices.size() / 3 - 1;
    }

    public fn addFace(a: int, b: int, c: int): bool {
        if (a < 0 || b < 0 || c < 0) { return false; }
        if (a >= this.vertexCount() || b >= this.vertexCount() || c >= this.vertexCount()) {
            return false;
        }
        this.faces.add(a);
        this.faces.add(b);
        this.faces.add(c);
        return true;
    }

    public fn vertexCount(): int {
        return this.vertices.size() / 3;
    }

    public fn faceCount(): int {
        return this.faces.size() / 3;
    }

    public fn getVertex(index: int, component: int): double {
        if (index < 0 || index >= this.vertexCount() || component < 0 || component > 2) {
            return 0.0;
        }
        return this.vertices.get(index * 3 + component);
    }

    public fn centroid(): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var sx: double = 0.0;
        var sy: double = 0.0;
        var sz: double = 0.0;
        var i: int = 0;
        while (i < this.vertexCount()) {
            sx = sx + this.getVertex(i, 0);
            sy = sy + this.getVertex(i, 1);
            sz = sz + this.getVertex(i, 2);
            i = i + 1;
        }
        let count: double = this.vertexCount() as double;
        if (count > 0.0) {
            result.add(sx / count);
            result.add(sy / count);
            result.add(sz / count);
        } else {
            result.add(0.0);
            result.add(0.0);
            result.add(0.0);
        }
        return result;
    }

    // Per-vertex normals from accumulated, normalized face normals.
    public fn computeNormals(): ArrayList<double> {
        let normals: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < this.vertexCount()) {
            normals.add(0.0);
            normals.add(0.0);
            normals.add(0.0);
            i = i + 1;
        }
        var f: int = 0;
        while (f < this.faceCount()) {
            let a: int = this.faces.get(f * 3);
            let b: int = this.faces.get(f * 3 + 1);
            let c: int = this.faces.get(f * 3 + 2);
            let ax: double = this.getVertex(a, 0);
            let ay: double = this.getVertex(a, 1);
            let az: double = this.getVertex(a, 2);
            let e1x: double = this.getVertex(b, 0) - ax;
            let e1y: double = this.getVertex(b, 1) - ay;
            let e1z: double = this.getVertex(b, 2) - az;
            let e2x: double = this.getVertex(c, 0) - ax;
            let e2y: double = this.getVertex(c, 1) - ay;
            let e2z: double = this.getVertex(c, 2) - az;
            let nx: double = e1y * e2z - e1z * e2y;
            let ny: double = e1z * e2x - e1x * e2z;
            let nz: double = e1x * e2y - e1y * e2x;
            let len: double = MathAdvanced.sqrt(nx * nx + ny * ny + nz * nz);
            if (len > 0.0) {
                let ux: double = nx / len;
                let uy: double = ny / len;
                let uz: double = nz / len;
                normals.set(a * 3, normals.get(a * 3) + ux);
                normals.set(a * 3 + 1, normals.get(a * 3 + 1) + uy);
                normals.set(a * 3 + 2, normals.get(a * 3 + 2) + uz);
                normals.set(b * 3, normals.get(b * 3) + ux);
                normals.set(b * 3 + 1, normals.get(b * 3 + 1) + uy);
                normals.set(b * 3 + 2, normals.get(b * 3 + 2) + uz);
                normals.set(c * 3, normals.get(c * 3) + ux);
                normals.set(c * 3 + 1, normals.get(c * 3 + 1) + uy);
                normals.set(c * 3 + 2, normals.get(c * 3 + 2) + uz);
            }
            f = f + 1;
        }
        i = 0;
        while (i < this.vertexCount()) {
            let x: double = normals.get(i * 3);
            let y: double = normals.get(i * 3 + 1);
            let z: double = normals.get(i * 3 + 2);
            let len2: double = MathAdvanced.sqrt(x * x + y * y + z * z);
            if (len2 > 0.0) {
                normals.set(i * 3, x / len2);
                normals.set(i * 3 + 1, y / len2);
                normals.set(i * 3 + 2, z / len2);
            }
            i = i + 1;
        }
        return normals;
    }

    public fn clear(): void {
        this.vertices.clear();
        this.faces.clear();
    }
}

public fn run_all_mesh3d_tests(): void {
    io::println("=== Mesh3D.tr Tests ===");
    let mesh: Mesh3D = new Mesh3D();
    let a: int = mesh.addVertex(0.0, 0.0, 0.0);
    let b: int = mesh.addVertex(1.0, 0.0, 0.0);
    let c: int = mesh.addVertex(0.0, 1.0, 0.0);
    if (a == 0 && b == 1 && c == 2 && mesh.vertexCount() == 3) {
        io::println("PASS: Mesh3D vertices");
    } else {
        io::println("FAIL: Mesh3D vertices");
    }
    if (mesh.addFace(0, 1, 2) && mesh.faceCount() == 1 && !mesh.addFace(0, 1, 9)) {
        io::println("PASS: Mesh3D faces and bounds");
    } else {
        io::println("FAIL: Mesh3D faces");
    }
    let normals: ArrayList<double> = mesh.computeNormals();
    if (normals.size() == 9 && Math.abs(normals.get(2) - 1.0) < 0.000001
            && Math.abs(normals.get(8) - 1.0) < 0.000001) {
        io::println("PASS: Mesh3D face normal points along +Z");
    } else {
        io::println("FAIL: Mesh3D normals");
    }
    let center: ArrayList<double> = mesh.centroid();
    if (center.size() == 3 && Math.abs(center.get(0) - 0.3333333) < 0.0001
            && Math.abs(center.get(1) - 0.3333333) < 0.0001) {
        io::println("PASS: Mesh3D centroid");
    } else {
        io::println("FAIL: Mesh3D centroid");
    }
    mesh.clear();
    if (mesh.vertexCount() == 0 && mesh.faceCount() == 0) {
        io::println("PASS: Mesh3D clear");
    } else {
        io::println("FAIL: Mesh3D clear");
    }
}
