// StringView — a zero-copy window over an immutable source string.
// A view stores the source reference plus integer offset and length instead of
// copying characters; substring and split hand back more views over that same
// source. Only toString materializes a standalone string.
import tt::lang::String;
import tt::util::ArrayList;

public class StringView {
    private string _source;
    private int _offset;
    private int _length;

    public fn init(source: string, offset: int, length: int) {
        this._source = source;
        this._offset = offset;
        this._length = length;
    }

    public fn source(): string { return this._source; }
    public fn offset(): int { return this._offset; }
    public fn length(): int { return this._length; }
    public fn isEmpty(): bool { return this._length == 0; }

    // Returns the character at a view-relative index.
    public fn charAt(index: int): string {
        return String.charAt(this._source, this._offset + index);
    }

    // Materializes the window into a standalone string.
    public fn toString(): string {
        return String.substring(this._source, this._offset, this._offset + this._length);
    }

    // Returns a sub-view over [start, end); end is exclusive and clamped.
    public fn substring(start: int, end: int): StringView {
        let from: int = start;
        if (from < 0) { from = 0; }
        let to: int = end;
        if (to > this._length) { to = this._length; }
        if (to < from) { to = from; }
        return new StringView(this._source, this._offset + from, to - from);
    }

    // Returns a sub-view from start through the end of this view.
    public fn substringFrom(start: int): StringView {
        return this.substring(start, this._length);
    }

    // Returns the view-relative index of needle, or -1 when absent.
    public fn indexOf(needle: string): int {
        let len: int = String.length(needle);
        if (len == 0) { return 0; }
        let found: int = String.indexOf(this._source, needle, this._offset);
        if (found < 0 || found + len > this._offset + this._length) {
            return -1;
        }
        return found - this._offset;
    }

    public fn contains(needle: string): bool {
        return this.indexOf(needle) >= 0;
    }

    public fn startsWith(prefix: string): bool {
        let len: int = String.length(prefix);
        if (len > this._length) { return false; }
        var i: int = 0;
        while (i < len) {
            if (String.charAt(this._source, this._offset + i) != String.charAt(prefix, i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn endsWith(suffix: string): bool {
        let len: int = String.length(suffix);
        if (len > this._length) { return false; }
        var i: int = 0;
        while (i < len) {
            if (String.charAt(this._source, this._offset + this._length - len + i) != String.charAt(suffix, i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn equals(other: StringView): bool {
        if (this._length != other._length) { return false; }
        var i: int = 0;
        while (i < this._length) {
            if (String.charAt(this._source, this._offset + i) != String.charAt(other._source, other._offset + i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Splits on delim into views that all share the original source.
    public fn split(delim: string): ArrayList<StringView> {
        let parts: ArrayList<StringView> = new ArrayList<StringView>();
        let end: int = this._offset + this._length;
        let delimLen: int = String.length(delim);
        if (delimLen == 0) {
            var k: int = 0;
            while (k < this._length) {
                parts.add(new StringView(this._source, this._offset + k, 1));
                k = k + 1;
            }
            return parts;
        }
        var pos: int = this._offset;
        var found: int = String.indexOf(this._source, delim, pos);
        while (found >= 0 && found + delimLen <= end) {
            parts.add(new StringView(this._source, pos, found - pos));
            pos = found + delimLen;
            found = String.indexOf(this._source, delim, pos);
        }
        parts.add(new StringView(this._source, pos, end - pos));
        return parts;
    }
}

// Wraps a whole string in a view with offset zero.
public fn stringView(s: string): StringView {
    return new StringView(s, 0, String.length(s));
}

// ==================== tests ====================

public fn test_stringview_basic(): void {
    let view: StringView = stringView("hello world");
    if (view.length() == 11 && !view.isEmpty() && view.toString() == "hello world"
            && view.charAt(0) == "h" && view.offset() == 0 && view.source() == "hello world") {
        io::println("PASS: stringview basic");
    } else {
        io::println("FAIL: stringview basic");
    }
}

public fn test_stringview_substring(): void {
    let view: StringView = stringView("hello world");
    let head: StringView = view.substring(0, 5);
    let tail: StringView = view.substringFrom(6);
    if (head.toString() == "hello" && head.length() == 5 && head.source() == "hello world"
            && tail.toString() == "world" && tail.offset() == 6) {
        io::println("PASS: stringview substring");
    } else {
        io::println("FAIL: stringview substring");
    }
}

public fn test_stringview_search(): void {
    let view: StringView = stringView("abcabc");
    let inner: StringView = view.substring(2, 6);
    if (view.indexOf("bc") == 1 && view.contains("abc") && view.startsWith("ab") && view.endsWith("bc")
            && inner.indexOf("bc") == 2 && inner.indexOf("zz") == -1) {
        io::println("PASS: stringview search");
    } else {
        io::println("FAIL: stringview search");
    }
}

public fn test_stringview_split(): void {
    let view: StringView = stringView("a,b,c");
    let parts: ArrayList<StringView> = view.split(",");
    if (parts.size() == 3 && parts.get(0).toString() == "a" && parts.get(1).toString() == "b"
            && parts.get(2).toString() == "c" && parts.get(0).source() == "a,b,c") {
        io::println("PASS: stringview split");
    } else {
        io::println("FAIL: stringview split");
    }
}

public fn test_stringview_split_window(): void {
    let view: StringView = stringView("x-a,b,c-y").substring(2, 7);
    let parts: ArrayList<StringView> = view.split(",");
    if (view.toString() == "a,b,c" && parts.size() == 3 && parts.get(0).toString() == "a"
            && parts.get(2).toString() == "c") {
        io::println("PASS: stringview split on window");
    } else {
        io::println("FAIL: stringview split on window");
    }
}

public fn test_stringview_equals(): void {
    let whole: StringView = stringView("hello");
    let window: StringView = stringView("xhellox").substring(1, 6);
    if (whole.equals(window) && whole.toString() == window.toString()) {
        io::println("PASS: stringview equals");
    } else {
        io::println("FAIL: stringview equals");
    }
}

public fn run_all_stringview_tests(): void {
    io::println("=== util/StringView.tr Tests ===");
    test_stringview_basic();
    test_stringview_substring();
    test_stringview_search();
    test_stringview_split();
    test_stringview_split_window();
    test_stringview_equals();
}
