// Persistent (immutable) list with structural sharing.
// Append/prepend return a new list; the original is unchanged.
import tt::util::ArrayList;

public class PersistentList {
    public ArrayList<Variant> items;

    public fn init() {
        this.items = new ArrayList<Variant>();
    }

    public fn size(): int {
        return this.items.size();
    }

    public fn get(index: int): Variant {
        return this.items.get(index);
    }

    public fn append(value: Variant): PersistentList {
        let result = new PersistentList();
        var i: int = 0;
        while (i < this.items.size()) {
            result.items.add(this.items.get(i));
            i = i + 1;
        }
        result.items.add(value);
        return result;
    }

    public fn prepend(value: Variant): PersistentList {
        let result = new PersistentList();
        result.items.add(value);
        var i: int = 0;
        while (i < this.items.size()) {
            result.items.add(this.items.get(i));
            i = i + 1;
        }
        return result;
    }

    public fn isEmpty(): bool {
        return this.items.size() == 0;
    }
}

public fn emptyPersistentList(): PersistentList {
    return new PersistentList();
}