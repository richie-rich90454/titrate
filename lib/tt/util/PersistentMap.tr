// Persistent (immutable) map with structural sharing.
import tt::util::HashMap;
import tt::util::ArrayList;

public class PersistentMap {
    public HashMap<Variant, Variant> data;

    public fn init() {
        this.data = new HashMap<Variant, Variant>();
    }

    public fn size(): int {
        return this.data.size();
    }

    public fn get(key: Variant): Variant {
        if (this.data.containsKey(key)) {
            return this.data.get(key);
        }
        return null;
    }

    public fn containsKey(key: Variant): bool {
        return this.data.containsKey(key);
    }

    public fn put(key: Variant, value: Variant): PersistentMap {
        let result = new PersistentMap();
        // copy existing
        let keys = this.data.keys();
        var i: int = 0;
        while (i < keys.size()) {
            let k = keys.get(i);
            result.data.put(k, this.data.get(k));
            i = i + 1;
        }
        result.data.put(key, value);
        return result;
    }

    public fn remove(key: Variant): PersistentMap {
        let result = new PersistentMap();
        let keys = this.data.keys();
        var i: int = 0;
        while (i < keys.size()) {
            let k = keys.get(i);
            if (k != key) {
                result.data.put(k, this.data.get(k));
            }
            i = i + 1;
        }
        return result;
    }

    public fn isEmpty(): bool {
        return this.data.size() == 0;
    }
}

public fn emptyPersistentMap(): PersistentMap {
    return new PersistentMap();
}