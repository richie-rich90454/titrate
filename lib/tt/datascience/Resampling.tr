// Resampling — deterministic LCG-driven shuffles, bootstrap means and
// jackknife means. The generator uses state = (13*state + 7) mod 101 so
// results are reproducible and directly checkable.

import tt::util::ArrayList;
import tt::math::MathAdvanced;

public class Resampling {
    public int state;

    public fn init(seed: int) {
        this.state = seed;
    }

    public fn nextInt(bound: int): int {
        this.state = (this.state * 13 + 7) % 101;
        if (bound <= 0) { return 0; }
        return this.state % bound;
    }

    public fn nextUniform(): double {
        return this.nextInt(101) as double / 101.0;
    }

    public fn shuffle(values: ArrayList<double>): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < values.size()) {
            result.add(values.get(i));
            i = i + 1;
        }
        var end: int = result.size() - 1;
        while (end > 0) {
            let j: int = this.nextInt(end + 1);
            let tmp: double = result.get(end);
            result.set(end, result.get(j));
            result.set(j, tmp);
            end = end - 1;
        }
        return result;
    }

    public fn bootstrapMeans(values: ArrayList<double>, replicates: int, sampleSize: int): ArrayList<double> {
        let means: ArrayList<double> = new ArrayList<double>();
        if (values.size() == 0 || replicates <= 0 || sampleSize <= 0) { return means; }
        var r: int = 0;
        while (r < replicates) {
            var total: double = 0.0;
            var i: int = 0;
            while (i < sampleSize) {
                total = total + values.get(this.nextInt(values.size()));
                i = i + 1;
            }
            means.add(total / (sampleSize as double));
            r = r + 1;
        }
        return means;
    }

    public fn jackknifeMeans(values: ArrayList<double>): ArrayList<double> {
        let means: ArrayList<double> = new ArrayList<double>();
        let n: int = values.size();
        if (n <= 1) { return means; }
        var left: int = 0;
        while (left < n) {
            var total: double = 0.0;
            var i: int = 0;
            while (i < n) {
                if (i != left) { total = total + values.get(i); }
                i = i + 1;
            }
            means.add(total / ((n - 1) as double));
            left = left + 1;
        }
        return means;
    }

    public fn standardError(values: ArrayList<double>, replicates: int, sampleSize: int): double {
        let means: ArrayList<double> = this.bootstrapMeans(values, replicates, sampleSize);
        if (means.size() < 2) { return 0.0; }
        var total: double = 0.0;
        var i: int = 0;
        while (i < means.size()) {
            total = total + means.get(i);
            i = i + 1;
        }
        let mean: double = total / (means.size() as double);
        var sumSquares: double = 0.0;
        i = 0;
        while (i < means.size()) {
            let d: double = means.get(i) - mean;
            sumSquares = sumSquares + d * d;
            i = i + 1;
        }
        return MathAdvanced.sqrt(sumSquares / ((means.size() - 1) as double));
    }
}

fn resApprox(a: double, b: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < 1e-9;
}

fn fourValues(): ArrayList<double> {
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(1.0); values.add(2.0); values.add(3.0); values.add(4.0);
    return values;
}

fn testResamplingGenerator(): void {
    let r: Resampling = new Resampling(1);
    if (r.nextInt(10) == 0 && r.state == 20 && r.nextInt(10) == 5
            && r.state == 65 && r.nextInt(10) == 4 && r.state == 44) {
        io::println("PASS: resampling generator");
    } else {
        io::println("FAIL: resampling generator");
    }
    let u: Resampling = new Resampling(1);
    if (resApprox(u.nextUniform(), 20.0 / 101.0)) {
        io::println("PASS: resampling uniform");
    } else {
        io::println("FAIL: resampling uniform");
    }
}

fn testResamplingShuffle(): void {
    let r: Resampling = new Resampling(1);
    let shuffled: ArrayList<double> = r.shuffle(fourValues());
    if (shuffled.size() == 4 && shuffled.get(0) == 2.0 && shuffled.get(1) == 4.0
            && shuffled.get(2) == 3.0 && shuffled.get(3) == 1.0) {
        io::println("PASS: resampling shuffle");
    } else {
        io::println("FAIL: resampling shuffle");
    }
}

fn testResamplingJackknife(): void {
    let r: Resampling = new Resampling(1);
    let means: ArrayList<double> = r.jackknifeMeans(fourValues());
    if (means.size() == 4 && resApprox(means.get(0), 3.0) && resApprox(means.get(1), 8.0 / 3.0)
            && resApprox(means.get(2), 7.0 / 3.0) && resApprox(means.get(3), 2.0)
            && r.jackknifeMeans(new ArrayList<double>()).size() == 0) {
        io::println("PASS: resampling jackknife");
    } else {
        io::println("FAIL: resampling jackknife");
    }
}

fn testResamplingBootstrap(): void {
    let r: Resampling = new Resampling(7);
    let means: ArrayList<double> = r.bootstrapMeans(fourValues(), 20, 4);
    var inRange: bool = means.size() == 20;
    var i: int = 0;
    while (i < means.size()) {
        if (means.get(i) < 1.0 || means.get(i) > 4.0) { inRange = false; }
        i = i + 1;
    }
    let se: double = r.standardError(fourValues(), 20, 4);
    if (inRange && se > 0.0 && resApprox(r.standardError(fourValues(), 1, 4), 0.0)) {
        io::println("PASS: resampling bootstrap");
    } else {
        io::println("FAIL: resampling bootstrap");
    }
}

public fn run_all_resampling_tests(): void {
    io::println("=== datascience/Resampling.tr Tests ===");
    testResamplingGenerator();
    testResamplingShuffle();
    testResamplingJackknife();
    testResamplingBootstrap();
}
