// FeatureEngineering — common vector feature transforms. standardize uses
// the sample standard deviation; oneHot returns a zero vector with a single
// one at the requested category index.

import tt::util::ArrayList;
import tt::math::MathAdvanced;

public class FeatureEngineering {
    public double defaultValue;

    public fn init(defaultValue: double) {
        this.defaultValue = defaultValue;
    }

    public fn mean(values: ArrayList<double>): double {
        if (values.size() == 0) { return 0.0; }
        var total: double = 0.0;
        var i: int = 0;
        while (i < values.size()) {
            total = total + values.get(i);
            i = i + 1;
        }
        return total / (values.size() as double);
    }

    public fn standardize(values: ArrayList<double>, epsilon: double): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        let n: int = values.size();
        if (n < 2) { return result; }
        let m: double = this.mean(values);
        var sumSquares: double = 0.0;
        var i: int = 0;
        while (i < n) {
            let d: double = values.get(i) - m;
            sumSquares = sumSquares + d * d;
            i = i + 1;
        }
        let sd: double = MathAdvanced.sqrt(sumSquares / ((n - 1) as double));
        i = 0;
        while (i < n) {
            if (sd <= epsilon) { result.add(0.0); } else { result.add((values.get(i) - m) / sd); }
            i = i + 1;
        }
        return result;
    }

    public fn minMaxScale(values: ArrayList<double>): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        if (values.size() == 0) { return result; }
        var low: double = values.get(0);
        var high: double = values.get(0);
        var i: int = 1;
        while (i < values.size()) {
            let x: double = values.get(i);
            if (x < low) { low = x; }
            if (x > high) { high = x; }
            i = i + 1;
        }
        let span: double = high - low;
        i = 0;
        while (i < values.size()) {
            if (span == 0.0) { result.add(0.0); } else { result.add((values.get(i) - low) / span); }
            i = i + 1;
        }
        return result;
    }

    public fn binarize(values: ArrayList<double>, threshold: double): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < values.size()) {
            if (values.get(i) > threshold) { result.add(1.0); } else { result.add(0.0); }
            i = i + 1;
        }
        return result;
    }

    public fn oneHot(index: int, categories: int): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < categories) {
            if (i == index) { result.add(1.0); } else { result.add(0.0); }
            i = i + 1;
        }
        return result;
    }

    public fn polynomialFeatures(x: double, degree: int): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var power: double = 1.0;
        var i: int = 0;
        while (i < degree) {
            power = power * x;
            result.add(power);
            i = i + 1;
        }
        return result;
    }

    public fn clip(values: ArrayList<double>, low: double, high: double): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < values.size()) {
            let x: double = values.get(i);
            if (x < low) { result.add(low); }
            else if (x > high) { result.add(high); }
            else { result.add(x); }
            i = i + 1;
        }
        return result;
    }

    public fn withDefault(values: ArrayList<double>, missing: double): ArrayList<double> {
        let result: ArrayList<double> = new ArrayList<double>();
        var i: int = 0;
        while (i < values.size()) {
            if (values.get(i) == missing) { result.add(this.defaultValue); }
            else { result.add(values.get(i)); }
            i = i + 1;
        }
        return result;
    }
}

fn featApprox(a: double, b: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < 1e-9;
}

fn rampFour(): ArrayList<double> {
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(1.0); values.add(2.0); values.add(3.0); values.add(4.0);
    return values;
}

fn testFeatureStandardize(): void {
    let f: FeatureEngineering = new FeatureEngineering(0.0);
    let z: ArrayList<double> = f.standardize(rampFour(), 1e-12);
    var sumSquares: double = 0.0;
    var i: int = 0;
    while (i < z.size()) {
        sumSquares = sumSquares + z.get(i) * z.get(i);
        i = i + 1;
    }
    if (z.size() == 4 && featApprox(sumSquares, 3.0)
            && featApprox(f.standardize(new ArrayList<double>(), 1e-12).size() as double, 0.0)) {
        io::println("PASS: feature standardize");
    } else {
        io::println("FAIL: feature standardize");
    }
}

fn testFeatureScaling(): void {
    let f: FeatureEngineering = new FeatureEngineering(0.0);
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(10.0); values.add(20.0); values.add(30.0);
    let scaled: ArrayList<double> = f.minMaxScale(values);
    let flat: ArrayList<double> = new ArrayList<double>();
    flat.add(5.0); flat.add(5.0);
    if (scaled.size() == 3 && featApprox(scaled.get(0), 0.0)
            && featApprox(scaled.get(1), 0.5) && featApprox(scaled.get(2), 1.0)
            && featApprox(f.minMaxScale(flat).get(0), 0.0)) {
        io::println("PASS: feature minMaxScale");
    } else {
        io::println("FAIL: feature minMaxScale");
    }
}

fn testFeatureEncoding(): void {
    let f: FeatureEngineering = new FeatureEngineering(0.0);
    let binary: ArrayList<double> = f.binarize(rampFour(), 2.0);
    let hot: ArrayList<double> = f.oneHot(2, 3);
    let powers: ArrayList<double> = f.polynomialFeatures(3.0, 3);
    if (binary.size() == 4 && binary.get(0) == 0.0 && binary.get(1) == 0.0
            && binary.get(2) == 1.0 && binary.get(3) == 1.0
            && hot.size() == 3 && hot.get(0) == 0.0 && hot.get(1) == 0.0 && hot.get(2) == 1.0
            && powers.size() == 3 && featApprox(powers.get(0), 3.0)
            && featApprox(powers.get(1), 9.0) && featApprox(powers.get(2), 27.0)) {
        io::println("PASS: feature encoding");
    } else {
        io::println("FAIL: feature encoding");
    }
}

fn testFeatureClipDefault(): void {
    let f: FeatureEngineering = new FeatureEngineering(0.0);
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(-1.0); values.add(2.0); values.add(10.0);
    let clipped: ArrayList<double> = f.clip(values, 0.0, 5.0);
    let replaced: ArrayList<double> = f.withDefault(rampFour(), 2.0);
    if (clipped.size() == 3 && featApprox(clipped.get(0), 0.0) && featApprox(clipped.get(1), 2.0)
            && featApprox(clipped.get(2), 5.0) && replaced.size() == 4
            && featApprox(replaced.get(1), 0.0) && featApprox(replaced.get(2), 3.0)) {
        io::println("PASS: feature clip/default");
    } else {
        io::println("FAIL: feature clip/default");
    }
}

public fn run_all_featureengineering_tests(): void {
    io::println("=== datascience/FeatureEngineering.tr Tests ===");
    testFeatureStandardize();
    testFeatureScaling();
    testFeatureEncoding();
    testFeatureClipDefault();
}
