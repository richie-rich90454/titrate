// SignalStats — scalar statistics over a sampled double signal.

import tt::util::ArrayList;
import tt::math::MathAdvanced;

public class SignalStats {
    public double epsilon;

    public fn init(epsilon: double) {
        this.epsilon = epsilon;
    }

    public fn mean(values: ArrayList<double>): double {
        if (values.size() == 0) { return 0.0; }
        var total: double = 0.0;
        var i: int = 0;
        while (i < values.size()) {
            total = total + values.get(i);
            i = i + 1;
        }
        return total / (values.size() as double);
    }

    public fn variance(values: ArrayList<double>): double {
        let n: int = values.size();
        if (n < 2) { return 0.0; }
        let m: double = this.mean(values);
        var total: double = 0.0;
        var i: int = 0;
        while (i < n) {
            let d: double = values.get(i) - m;
            total = total + d * d;
            i = i + 1;
        }
        return total / ((n - 1) as double);
    }

    public fn stdDev(values: ArrayList<double>): double {
        return MathAdvanced.sqrt(this.variance(values));
    }

    public fn energy(values: ArrayList<double>): double {
        var total: double = 0.0;
        var i: int = 0;
        while (i < values.size()) {
            let x: double = values.get(i);
            total = total + x * x;
            i = i + 1;
        }
        return total;
    }

    public fn rms(values: ArrayList<double>): double {
        if (values.size() == 0) { return 0.0; }
        return MathAdvanced.sqrt(this.energy(values) / (values.size() as double));
    }

    public fn peakToPeak(values: ArrayList<double>): double {
        if (values.size() == 0) { return 0.0; }
        var low: double = values.get(0);
        var high: double = values.get(0);
        var i: int = 1;
        while (i < values.size()) {
            let x: double = values.get(i);
            if (x < low) { low = x; }
            if (x > high) { high = x; }
            i = i + 1;
        }
        return high - low;
    }

    public fn zeroCrossings(values: ArrayList<double>): int {
        var count: int = 0;
        var i: int = 1;
        while (i < values.size()) {
            if (values.get(i - 1) * values.get(i) < 0.0) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn snrRatio(signal: ArrayList<double>, noise: ArrayList<double>): double {
        if (signal.size() == 0 || noise.size() == 0) { return 0.0; }
        let signalPower: double = this.energy(signal) / (signal.size() as double);
        let noisePower: double = this.energy(noise) / (noise.size() as double);
        if (noisePower <= this.epsilon) { return 0.0; }
        return signalPower / noisePower;
    }
}

fn sigApprox(a: double, b: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < 1e-9;
}

fn rampFour(): ArrayList<double> {
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(1.0); values.add(2.0); values.add(3.0); values.add(4.0);
    return values;
}

fn testSignalMoments(): void {
    let s: SignalStats = new SignalStats(1e-12);
    let values: ArrayList<double> = rampFour();
    let rms: double = s.rms(values);
    if (sigApprox(s.mean(values), 2.5) && sigApprox(s.variance(values), 5.0 / 3.0)
            && sigApprox(rms * rms, 7.5) && sigApprox(s.energy(values), 30.0)) {
        io::println("PASS: signalstats moments");
    } else {
        io::println("FAIL: signalstats moments");
    }
}

fn testSignalRange(): void {
    let s: SignalStats = new SignalStats(1e-12);
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(-2.0); values.add(5.0); values.add(1.0);
    let empty: ArrayList<double> = new ArrayList<double>();
    if (sigApprox(s.peakToPeak(values), 7.0) && sigApprox(s.peakToPeak(empty), 0.0)
            && sigApprox(s.stdDev(empty), 0.0)) {
        io::println("PASS: signalstats range");
    } else {
        io::println("FAIL: signalstats range");
    }
}

fn testSignalCrossings(): void {
    let s: SignalStats = new SignalStats(1e-12);
    let values: ArrayList<double> = new ArrayList<double>();
    values.add(-1.0); values.add(2.0); values.add(-3.0); values.add(4.0);
    if (s.zeroCrossings(values) == 3 && s.zeroCrossings(new ArrayList<double>()) == 0) {
        io::println("PASS: signalstats crossings");
    } else {
        io::println("FAIL: signalstats crossings");
    }
}

fn testSignalSnr(): void {
    let s: SignalStats = new SignalStats(1e-12);
    let signal: ArrayList<double> = new ArrayList<double>();
    signal.add(1.0); signal.add(1.0); signal.add(1.0); signal.add(1.0);
    let noise: ArrayList<double> = new ArrayList<double>();
    noise.add(0.1); noise.add(0.1); noise.add(0.1); noise.add(0.1);
    let silence: ArrayList<double> = new ArrayList<double>();
    silence.add(0.0); silence.add(0.0);
    if (sigApprox(s.snrRatio(signal, noise), 100.0) && sigApprox(s.snrRatio(signal, silence), 0.0)) {
        io::println("PASS: signalstats snr");
    } else {
        io::println("FAIL: signalstats snr");
    }
}

public fn run_all_signalstats_tests(): void {
    io::println("=== datascience/SignalStats.tr Tests ===");
    testSignalMoments();
    testSignalRange();
    testSignalCrossings();
    testSignalSnr();
}
