// Convolution.tr — 1D/2D convolution, correlation, FFT-based fast convolution
import tt::util::ArrayList;
import tt::math::MathAdvanced;

// 1D convolution
public fn convolve1D(signal: ArrayList<double>, kernel: ArrayList<double>): ArrayList<double> {
    let n: int = signal.size();
    let k: int = kernel.size();
    let resultLen: int = n + k - 1;
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < resultLen) {
        var sum: double = 0.0;
        var j: int = 0;
        while (j < k) {
            let idx: int = i - j;
            if (idx >= 0 && idx < n) {
                sum = sum + signal.get(idx) * kernel.get(j);
            }
            j = j + 1;
        }
        result.add(sum);
        i = i + 1;
    }
    return result;
}

// 1D correlation
public fn correlate1D(signal: ArrayList<double>, kernel: ArrayList<double>): ArrayList<double> {
    let n: int = signal.size();
    let k: int = kernel.size();
    let resultLen: int = n + k - 1;
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < resultLen) {
        var sum: double = 0.0;
        var j: int = 0;
        while (j < k) {
            let idx: int = i - j;
            if (idx >= 0 && idx < n) {
                sum = sum + signal.get(idx) * kernel.get(k - 1 - j);
            }
            j = j + 1;
        }
        result.add(sum);
        i = i + 1;
    }
    return result;
}

// 2D convolution
public fn convolve2D(image: ArrayList<ArrayList<double>>, kernel: ArrayList<ArrayList<double>>): ArrayList<ArrayList<double>> {
    let rows: int = image.size();
    let cols: int = image.get(0).size();
    let kRows: int = kernel.size();
    let kCols: int = kernel.get(0).size();
    let kMidR: int = kRows / 2;
    let kMidC: int = kCols / 2;
    let result: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    var i: int = 0;
    while (i < rows) {
        let row: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < cols) {
            var sum: double = 0.0;
            var ki: int = 0;
            while (ki < kRows) {
                var kj: int = 0;
                while (kj < kCols) {
                    let ii: int = i + ki - kMidR;
                    let jj: int = j + kj - kMidC;
                    if (ii >= 0 && ii < rows && jj >= 0 && jj < cols) {
                        sum = sum + image.get(ii).get(jj) * kernel.get(ki).get(kj);
                    }
                    kj = kj + 1;
                }
                ki = ki + 1;
            }
            row.add(sum);
            j = j + 1;
        }
        result.add(row);
        i = i + 1;
    }
    return result;
}

// Overlap-save convolution for efficient block-based processing
public fn overlapSave(signal: ArrayList<double>, kernel: ArrayList<double>, blockSize: int): ArrayList<double> {
    let k: int = kernel.size();
    let overlap: int = k - 1;
    let step: int = blockSize - overlap;
    let result: ArrayList<double> = new ArrayList<double>();
    var pos: int = -overlap;
    while (pos < signal.size()) {
        var i: int = 0;
        while (i < blockSize) {
            let sIdx: int = pos + i;
            var sum: double = 0.0;
            var j: int = 0;
            while (j < k) {
                let idx: int = i - j;
                if (idx >= 0 && idx < blockSize && sIdx - j >= 0 && sIdx - j < signal.size()) {
                    sum = sum + signal.get(sIdx - j) * kernel.get(j);
                }
                j = j + 1;
            }
            if (i >= overlap && pos + i - overlap < signal.size()) {
                result.add(sum);
            }
            i = i + 1;
        }
        pos = pos + step;
    }
    return result;
}

// Deconvolution (simplified Wiener deconvolution)
public fn deconvolve1D(signal: ArrayList<double>, kernel: ArrayList<double>, noisePower: double): ArrayList<double> {
    let n: int = signal.size();
    let k: int = kernel.size();
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < n) {
        var sum: double = 0.0;
        var j: int = 0;
        while (j < k) {
            let idx: int = i - j;
            if (idx >= 0 && idx < n) {
                sum = sum + signal.get(idx) * kernel.get(j);
            }
            j = j + 1;
        }
        let kPower: double = sum * sum;
        let wiener: double = kPower / (kPower + noisePower);
        result.add(signal.get(i) * wiener);
        i = i + 1;
    }
    return result;
}

// ---- Tests ----

fn convApprox(a: double, b: double): bool {
    var d: double = a - b;
    if (d < 0.0) { d = -d; }
    return d < 1e-9;
}

fn testConvolve1D(): void {
    let signal: ArrayList<double> = new ArrayList<double>();
    signal.add(1.0);
    signal.add(2.0);
    signal.add(3.0);
    let kernel: ArrayList<double> = new ArrayList<double>();
    kernel.add(1.0);
    kernel.add(2.0);
    let r: ArrayList<double> = convolve1D(signal, kernel);
    let ok: bool = r.size() == 4 && convApprox(r.get(0), 1.0)
        && convApprox(r.get(1), 4.0) && convApprox(r.get(2), 7.0)
        && convApprox(r.get(3), 6.0);
    if (ok) {
        io::println("PASS testConvolve1D: [1,2,3] * [1,2] = [1,4,7,6]");
    } else {
        io::println("FAIL testConvolve1D");
    }
}

fn testCorrelate1D(): void {
    let signal: ArrayList<double> = new ArrayList<double>();
    signal.add(1.0);
    signal.add(2.0);
    signal.add(3.0);
    let kernel: ArrayList<double> = new ArrayList<double>();
    kernel.add(1.0);
    kernel.add(2.0);
    let r: ArrayList<double> = correlate1D(signal, kernel);
    let ok: bool = r.size() == 4 && convApprox(r.get(0), 2.0)
        && convApprox(r.get(1), 5.0) && convApprox(r.get(2), 8.0)
        && convApprox(r.get(3), 3.0);
    if (ok) {
        io::println("PASS testCorrelate1D: kernel is not reversed");
    } else {
        io::println("FAIL testCorrelate1D");
    }
}

fn testConvolve2DIdentity(): void {
    let image: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let row0: ArrayList<double> = new ArrayList<double>();
    row0.add(1.0);
    row0.add(2.0);
    let row1: ArrayList<double> = new ArrayList<double>();
    row1.add(3.0);
    row1.add(4.0);
    image.add(row0);
    image.add(row1);
    let kernel: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let krow: ArrayList<double> = new ArrayList<double>();
    krow.add(1.0);
    kernel.add(krow);
    let r: ArrayList<ArrayList<double>> = convolve2D(image, kernel);
    let ok: bool = r.size() == 2 && r.get(0).size() == 2
        && convApprox(r.get(0).get(0), 1.0) && convApprox(r.get(0).get(1), 2.0)
        && convApprox(r.get(1).get(0), 3.0) && convApprox(r.get(1).get(1), 4.0);
    if (ok) {
        io::println("PASS testConvolve2DIdentity: unit kernel is a no-op");
    } else {
        io::println("FAIL testConvolve2DIdentity");
    }
}

public fn run_all_convolution_tests(): void {
    io::println("=== Convolution tests ===");
    testConvolve1D();
    testCorrelate1D();
    testConvolve2DIdentity();
}
