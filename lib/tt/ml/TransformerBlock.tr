// TransformerBlock.tr — multi-head self-attention, residual connection and a
// position-wise feed-forward network, all in pure .tr.
// Requires embedDim to be divisible by numHeads.
import tt::util::ArrayList;
import tt::ml::Attention;

fn _tbSlice(row: ArrayList<double>, start: int, length: int): ArrayList<double> {
    let out: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < length && start + i < row.size()) {
        out.add(row.get(start + i));
        i = i + 1;
    }
    return out;
}

fn _tbInitMatrix(rows: int, cols: int): ArrayList<ArrayList<double>> {
    let m: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    var i: int = 0;
    while (i < rows) {
        let row: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < cols) {
            row.add(((i * 3 + j * 11) % 7 - 3) as double * 0.01);
            j = j + 1;
        }
        m.add(row);
        i = i + 1;
    }
    return m;
}

fn _tbMatVec(m: ArrayList<ArrayList<double>>, row: ArrayList<double>): ArrayList<double> {
    let out: ArrayList<double> = new ArrayList<double>();
    var j: int = 0;
    while (j < m.get(0).size()) {
        var sum: double = 0.0;
        var i: int = 0;
        while (i < m.size() && i < row.size()) {
            sum = sum + row.get(i) * m.get(i).get(j);
            i = i + 1;
        }
        out.add(sum);
        j = j + 1;
    }
    return out;
}

fn _tbRelu(v: ArrayList<double>): ArrayList<double> {
    var i: int = 0;
    while (i < v.size()) {
        if (v.get(i) < 0.0) { v.set(i, 0.0); }
        i = i + 1;
    }
    return v;
}

public class TransformerBlock {
    public int embedDim;
    public int numHeads;
    public int headDim;
    public int feedDim;
    public ArrayList<Attention> heads;
    public ArrayList<ArrayList<double>> outputProjection;
    public ArrayList<ArrayList<double>> feedForward1;
    public ArrayList<ArrayList<double>> feedForward2;

    public fn init(embedDim: int, numHeads: int, feedDim: int) {
        this.embedDim = embedDim;
        this.numHeads = numHeads;
        this.headDim = embedDim / numHeads;
        this.feedDim = feedDim;
        this.heads = new ArrayList<Attention>();
        this.outputProjection = _tbInitMatrix(embedDim, embedDim);
        this.feedForward1 = _tbInitMatrix(embedDim, feedDim);
        this.feedForward2 = _tbInitMatrix(feedDim, embedDim);
        var h: int = 0;
        while (h < numHeads) {
            this.heads.add(new Attention(this.headDim));
            h = h + 1;
        }
    }

    public fn setHeadWeight(head: int, i: int, j: int, q: double, k: double, v: double): void {
        this.heads.get(head).setQuery(i, j, q);
        this.heads.get(head).setKey(i, j, k);
        this.heads.get(head).setValue(i, j, v);
    }

    public fn slice(row: ArrayList<double>, head: int): ArrayList<double> {
        return _tbSlice(row, head * this.headDim, this.headDim);
    }

    public fn selfAttention(sequence: ArrayList<ArrayList<double>>): ArrayList<ArrayList<double>> {
        var parts: ArrayList<ArrayList<ArrayList<double>>> = new ArrayList<ArrayList<ArrayList<double>>>();
        var h: int = 0;
        while (h < this.numHeads) {
            let q: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
            var i: int = 0;
            while (i < sequence.size()) {
                q.add(this.slice(sequence.get(i), h));
                i = i + 1;
            }
            parts.add(this.heads.get(h).forward(q, q, q));
            h = h + 1;
        }
        let out: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
        i = 0;
        while (i < sequence.size()) {
            let row: ArrayList<double> = new ArrayList<double>();
            h = 0;
            while (h < this.numHeads) {
                let part: ArrayList<double> = parts.get(h).get(i);
                var d: int = 0;
                while (d < part.size()) {
                    row.add(part.get(d));
                    d = d + 1;
                }
                h = h + 1;
            }
            out.add(row);
            i = i + 1;
        }
        return out;
    }

    public fn forward(sequence: ArrayList<ArrayList<double>>): ArrayList<ArrayList<double>> {
        let attention: ArrayList<ArrayList<double>> = this.selfAttention(sequence);
        let out: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
        var i: int = 0;
        while (i < sequence.size()) {
            let attended: ArrayList<double> = _tbMatVec(this.outputProjection, attention.get(i));
            let row: ArrayList<double> = new ArrayList<double>();
            var j: int = 0;
            while (j < this.embedDim) {
                row.add(sequence.get(i).get(j) + attended.get(j));
                j = j + 1;
            }
            let hidden: ArrayList<double> = _tbRelu(_tbMatVec(this.feedForward1, row));
            let fed: ArrayList<double> = _tbMatVec(this.feedForward2, hidden);
            j = 0;
            while (j < this.embedDim) {
                row.set(j, row.get(j) + fed.get(j));
                j = j + 1;
            }
            out.add(row);
            i = i + 1;
        }
        return out;
    }
}

public fn run_all_transformerblock_tests(): void {
    let sequence: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let first: ArrayList<double> = new ArrayList<double>();
    first.add(1.0); first.add(0.0);
    let second: ArrayList<double> = new ArrayList<double>();
    second.add(0.0); second.add(1.0);
    sequence.add(first); sequence.add(second);

    let block: TransformerBlock = new TransformerBlock(2, 1, 4);
    block.setHeadWeight(0, 0, 0, 1.0, 1.0, 1.0);
    block.setHeadWeight(0, 1, 1, 1.0, 1.0, 1.0);

    let attended: ArrayList<ArrayList<double>> = block.selfAttention(sequence);
    if (attended.size() == 2 && attended.get(0).size() == 2
        && attended.get(0).get(0) > attended.get(0).get(1)) {
        io::println("PASS: TransformerBlock selfAttention");
    } else {
        io::println("FAIL: TransformerBlock selfAttention");
    }

    let out: ArrayList<ArrayList<double>> = block.forward(sequence);
    if (out.size() == 2 && out.get(1).size() == 2 && out.get(1).get(1) > out.get(1).get(0)) {
        io::println("PASS: TransformerBlock forward shape and residual");
    } else {
        io::println("FAIL: TransformerBlock forward shape and residual");
    }
    if (block.headDim == 2 && block.heads.size() == 1 && block.feedForward2.size() == 4) {
        io::println("PASS: TransformerBlock dimensions");
    } else {
        io::println("FAIL: TransformerBlock dimensions");
    }
}
