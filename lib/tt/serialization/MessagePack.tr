// Minimal MessagePack-style binary serializer for JsonValue values.
// Supported types: nil, bool, fixint/int32, float64, str8/str16/fixstr,
// fixarray/array16, fixmap/map16. Byte strings are represented as strings of
// code points 0..255, matching the other binary codecs in this library.
import tt::json::JsonValue;
import tt::util::ArrayList;
import tt::util::HashMap;
import tt::lang::String;

public class MessagePackError {
    public string message;

    public fn init(msg: string) {
        this.message = msg;
    }

    public fn toString(): string {
        return "MessagePackError: " + this.message;
    }
}

// ---- Byte helpers ----

// One byte is one code point 0..255. Non-Latin-1 characters are truncated.
fn _byte(b: int): string {
    return String.fromCharCode(b & 0xFF);
}

fn _byteAt(s: string, i: int): int {
    return String.charAt(s, i) as int;
}

fn _u16be(n: int): string {
    return _byte((n >> 8) & 0xFF) + _byte(n & 0xFF);
}

// ---- Encoding ----

let _out: string = "";

fn _emitByte(b: int): void {
    _out = _out + _byte(b);
}

fn _packInt(n: int): void {
    if (n >= 0 && n <= 127) {
        _emitByte(n);
        return;
    }
    if (n < 0 && n >= -32) {
        _emitByte(n & 0xFF);
        return;
    }
    _emitByte(0xD2);
    _emitByte((n >> 24) & 0xFF);
    _emitByte((n >> 16) & 0xFF);
    _emitByte((n >> 8) & 0xFF);
    _emitByte(n & 0xFF);
}

// IEEE-754 bits as an eight-byte little-endian string (shared with Marshal).
fn _doubleBitsLE(val: double): string {
    if (val == 0.0) {
        if ((1.0 / val) < 0.0) {
            return _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0x80);
        }
        return _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0);
    }
    if (!(val == val)) {
        return _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0xF8) + _byte(0x7F);
    }
    let inf: double = 1.7976931348623157e308 * 2.0;
    if (val == inf) {
        return _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0xF0) + _byte(0x7F);
    }
    if (val == -inf) {
        return _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0) + _byte(0xF0) + _byte(0xFF);
    }
    var sign: int = 0;
    var absVal: double = val;
    if (val < 0.0) {
        sign = 1;
        absVal = -val;
    }
    var exp: int = 0;
    var mantissaBase: double = absVal;
    if (absVal >= 2.0) {
        while (mantissaBase >= 2.0) {
            mantissaBase = mantissaBase / 2.0;
            exp = exp + 1;
        }
    } else if (absVal < 1.0) {
        while (mantissaBase < 1.0) {
            mantissaBase = mantissaBase * 2.0;
            exp = exp - 1;
        }
    }
    let biasedExp: int = exp + 1023;
    var frac: double = mantissaBase - 1.0;
    var mantissa: long = 0;
    var i: int = 51;
    while (i >= 0) {
        frac = frac * 2.0;
        if (frac >= 1.0) {
            mantissa = mantissa | (1L << i);
            frac = frac - 1.0;
        }
        i = i - 1;
    }
    let bits: long = ((sign as long) << 63) | (((biasedExp as long) & 0x7FFL) << 52) | mantissa;
    return _byte(bits as int & 0xFF)
        + _byte((bits >> 8) as int & 0xFF)
        + _byte((bits >> 16) as int & 0xFF)
        + _byte((bits >> 24) as int & 0xFF)
        + _byte((bits >> 32) as int & 0xFF)
        + _byte((bits >> 40) as int & 0xFF)
        + _byte((bits >> 48) as int & 0xFF)
        + _byte((bits >> 56) as int & 0xFF);
}

fn _packDouble(val: double): void {
    _emitByte(0xCB);
    let le: string = _doubleBitsLE(val);
    var i: int = 7;
    while (i >= 0) {
        _emitByte(_byteAt(le, i));
        i = i - 1;
    }
}

fn _packString(s: string): void {
    let len: int = String.length(s);
    if (len <= 31) {
        _emitByte(0xA0 | len);
    } else if (len <= 255) {
        _emitByte(0xD9);
        _emitByte(len & 0xFF);
    } else {
        _emitByte(0xDA);
        _out = _out + _u16be(len);
    }
    var i: int = 0;
    while (i < len) {
        _emitByte(_byteAt(s, i));
        i = i + 1;
    }
}

fn _packValue(value: JsonValue): void {
    if (value == null || value.isNull()) {
        _emitByte(0xC0);
        return;
    }
    if (value.isBool()) {
        _emitByte(value.asBool() ? 0xC3 : 0xC2);
        return;
    }
    if (value.isNumber()) {
        let n: double = value.asNumber();
        let asInt: int = n as int;
        if (n == (asInt as double)) {
            _packInt(asInt);
        } else {
            _packDouble(n);
        }
        return;
    }
    if (value.isString()) {
        _packString(value.asString());
        return;
    }
    if (value.isArray()) {
        let arr: ArrayList<JsonValue> = value.asArray();
        let n: int = arr.size();
        if (n <= 15) {
            _emitByte(0x90 | n);
        } else {
            _emitByte(0xDC);
            _out = _out + _u16be(n);
        }
        var i: int = 0;
        while (i < n) {
            _packValue(arr.get(i));
            i = i + 1;
        }
        return;
    }
    if (value.isObject()) {
        let obj: HashMap<string, JsonValue> = value.asObject();
        let keys: ArrayList<string> = obj.keys();
        let n: int = keys.size();
        if (n <= 15) {
            _emitByte(0x80 | n);
        } else {
            _emitByte(0xDE);
            _out = _out + _u16be(n);
        }
        var i: int = 0;
        while (i < n) {
            let key: string = keys.get(i);
            _packString(key);
            _packValue(obj.get(key));
            i = i + 1;
        }
        return;
    }
    _emitByte(0xC0);
}

// ---- Decoding ----

let _data: string = "";
let _pos: int = 0;

fn _readU8(): int {
    if (_pos >= String.length(_data)) {
        throw new MessagePackError("unexpected end of stream");
    }
    let b: int = _byteAt(_data, _pos);
    _pos = _pos + 1;
    return b;
}

fn _readU16(): int {
    return (_readU8() << 8) | _readU8();
}

fn _readU32(): long {
    let a: long = _readU8() as long;
    let b: long = _readU8() as long;
    let c: long = _readU8() as long;
    let d: long = _readU8() as long;
    return (a << 24) | (b << 16) | (c << 8) | d;
}

fn _readString(len: int): string {
    if (len < 0 || _pos + len > String.length(_data)) {
        throw new MessagePackError("invalid string length: " + (len as string));
    }
    let s: string = String.substring(_data, _pos, _pos + len);
    _pos = _pos + len;
    return s;
}

fn _pow2(n: int): double {
    if (n >= 0) {
        var result: double = 1.0;
        var i: int = 0;
        while (i < n) {
            result = result * 2.0;
            i = i + 1;
        }
        return result;
    }
    var result: double = 1.0;
    var i: int = 0;
    while (i > n) {
        result = result / 2.0;
        i = i - 1;
    }
    return result;
}

fn _bitsToDouble(bits: long): double {
    let sign: int = (bits >> 63) as int & 0x1;
    let exp: int = (bits >> 52) as int & 0x7FF;
    let mantissa: long = bits & 0xFFFFFFFFFFFFFL;
    if (exp == 0x7FF) {
        if (mantissa == 0) {
            if (sign == 1) {
                return -(1.7976931348623157e308 * 2.0);
            }
            return 1.7976931348623157e308 * 2.0;
        }
        return 0.0 / 0.0;
    }
    if (exp == 0 && mantissa == 0) {
        if (sign == 1) {
            return -0.0;
        }
        return 0.0;
    }
    if (exp == 0) {
        var small: double = 0.0;
        var i: int = 0;
        while (i < 52) {
            if (((mantissa >> i) & 1L) == 1) {
                small = small + _pow2(i - 1074);
            }
            i = i + 1;
        }
        if (sign == 1) {
            return -small;
        }
        return small;
    }
    let biasedExp: int = exp - 1023;
    var val: double = _pow2(biasedExp);
    var frac: double = 0.0;
    var i: int = 0;
    while (i < 52) {
        if (((mantissa >> i) & 1L) == 1) {
            frac = frac + _pow2(i - 52);
        }
        i = i + 1;
    }
    val = val * (1.0 + frac);
    if (sign == 1) {
        return -val;
    }
    return val;
}

fn _unpackDouble(): double {
    var bits: long = 0;
    var i: int = 0;
    while (i < 8) {
        bits = (bits << 8) | (_readU8() as long);
        i = i + 1;
    }
    return _bitsToDouble(bits);
}

fn _unpackValue(): JsonValue {
    let code: int = _readU8();
    if (code == 0xC0) {
        return JsonValue.ofNull();
    }
    if (code == 0xC2) {
        return JsonValue.ofBool(false);
    }
    if (code == 0xC3) {
        return JsonValue.ofBool(true);
    }
    if (code >= 0x00 && code <= 0x7F) {
        return JsonValue.ofNum(code as double);
    }
    if (code >= 0xE0) {
        return JsonValue.ofNum((code - 256) as double);
    }
    if (code == 0xD2) {
        let raw: long = _readU32();
        let signed: long = raw >= 2147483648L ? raw - 4294967296L : raw;
        return JsonValue.ofNum(signed as double);
    }
    if (code == 0xCB) {
        return JsonValue.ofNum(_unpackDouble());
    }
    if (code >= 0xA0 && code <= 0xBF) {
        return JsonValue.ofStr(_readString(code & 0x1F));
    }
    if (code == 0xD9) {
        return JsonValue.ofStr(_readString(_readU8()));
    }
    if (code == 0xDA) {
        return JsonValue.ofStr(_readString(_readU16()));
    }
    if (code >= 0x90 && code <= 0x9F) {
        return _unpackArray(code & 0x0F);
    }
    if (code == 0xDC) {
        return _unpackArray(_readU16());
    }
    if (code >= 0x80 && code <= 0x8F) {
        return _unpackMap(code & 0x0F);
    }
    if (code == 0xDE) {
        return _unpackMap(_readU16());
    }
    throw new MessagePackError("unsupported type code: " + (code as string));
}

fn _unpackArray(count: int): JsonValue {
    let arr: ArrayList<JsonValue> = new ArrayList<JsonValue>();
    var i: int = 0;
    while (i < count) {
        arr.add(_unpackValue());
        i = i + 1;
    }
    return JsonValue.ofArray(arr);
}

fn _unpackMap(count: int): JsonValue {
    let obj: HashMap<string, JsonValue> = new HashMap<string, JsonValue>();
    var i: int = 0;
    while (i < count) {
        let keyCode: int = _readU8();
        let key: string = "";
        if (keyCode >= 0xA0 && keyCode <= 0xBF) {
            key = _readString(keyCode & 0x1F);
        } else if (keyCode == 0xD9) {
            key = _readString(_readU8());
        } else if (keyCode == 0xDA) {
            key = _readString(_readU16());
        } else {
            throw new MessagePackError("invalid map key type: " + (keyCode as string));
        }
        obj.put(key, _unpackValue());
        i = i + 1;
    }
    return JsonValue.ofObject(obj);
}

// ---- Module API ----

public fn dumps(value: JsonValue): string {
    _out = "";
    _packValue(value);
    let result: string = _out;
    _out = "";
    return result;
}

public fn loads(data: string): JsonValue {
    if (data == null || String.length(data) == 0) {
        throw new MessagePackError("empty messagepack stream");
    }
    _data = data;
    _pos = 0;
    let result: JsonValue = _unpackValue();
    _data = "";
    _pos = 0;
    return result;
}

// ==================== Tests ====================

public fn test_messagepack_scalars(): void {
    let a: JsonValue = loads(dumps(JsonValue.ofNull()));
    let b: JsonValue = loads(dumps(JsonValue.ofBool(true)));
    let c: JsonValue = loads(dumps(JsonValue.ofBool(false)));
    if (a.isNull() && b.asBool() && !c.asBool()) {
        io::println("PASS: messagepack scalars");
    } else {
        io::println("FAIL: messagepack scalars");
    }
}

public fn test_messagepack_numbers(): void {
    let a: JsonValue = loads(dumps(JsonValue.ofNum(42.0)));
    let b: JsonValue = loads(dumps(JsonValue.ofNum(-7.0)));
    let c: JsonValue = loads(dumps(JsonValue.ofNum(1000.0)));
    let d: JsonValue = loads(dumps(JsonValue.ofNum(3.5)));
    if (a.asNumber() == 42.0 && b.asNumber() == -7.0 && c.asNumber() == 1000.0 && d.asNumber() == 3.5) {
        io::println("PASS: messagepack numbers");
    } else {
        io::println("FAIL: messagepack numbers");
    }
}

public fn test_messagepack_strings(): void {
    let a: JsonValue = loads(dumps(JsonValue.ofStr("hello")));
    let longText: string = "0123456789012345678901234567890123456789";
    let b: JsonValue = loads(dumps(JsonValue.ofStr(longText)));
    if (a.asString() == "hello" && b.asString() == longText) {
        io::println("PASS: messagepack strings");
    } else {
        io::println("FAIL: messagepack strings");
    }
}

public fn test_messagepack_containers(): void {
    let items: ArrayList<JsonValue> = new ArrayList<JsonValue>();
    items.add(JsonValue.ofNum(1.0));
    items.add(JsonValue.ofStr("two"));
    let arr: JsonValue = loads(dumps(JsonValue.ofArray(items)));
    let objMap: HashMap<string, JsonValue> = new HashMap<string, JsonValue>();
    objMap.put("key", JsonValue.ofNum(9.0));
    let obj: JsonValue = loads(dumps(JsonValue.ofObject(objMap)));
    if (arr.isArray() && arr.size() == 2 && arr.getAt(1).asString() == "two"
        && obj.isObject() && obj.get("key").asNumber() == 9.0) {
        io::println("PASS: messagepack containers");
    } else {
        io::println("FAIL: messagepack containers");
    }
}

public fn run_all_messagepack_tests(): void {
    io::println("=== serialization/MessagePack.tr Tests ===");
    test_messagepack_scalars();
    test_messagepack_numbers();
    test_messagepack_strings();
    test_messagepack_containers();
}
