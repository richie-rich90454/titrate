// Env — an in-memory environment-variable store. It never reads or mutates
// the process environment, so tests and programs stay deterministic.

import tt::util::ArrayList;
import tt::util::HashMap;

public class Env {
    public string scope;
    private HashMap<string, string> vars;

    public fn init(scope: string) {
        this.scope = scope;
        this.vars = new HashMap<string, string>();
    }

    public fn set(name: string, value: string): void {
        this.vars.put(name, value);
    }

    public fn get(name: string): string {
        if (!this.vars.containsKey(name)) { return ""; }
        return this.vars.get(name);
    }

    public fn getOrDefault(name: string, fallback: string): string {
        if (!this.vars.containsKey(name)) { return fallback; }
        return this.vars.get(name);
    }

    public fn has(name: string): bool {
        return this.vars.containsKey(name);
    }

    public fn unset(name: string): bool {
        if (!this.vars.containsKey(name)) { return false; }
        this.vars.remove(name);
        return true;
    }

    public fn names(): ArrayList<string> {
        return this.vars.keys();
    }

    public fn size(): int {
        return this.vars.size();
    }

    public fn applyDefaults(defaults: Env): int {
        let keys: ArrayList<string> = defaults.names();
        var added: int = 0;
        var i: int = 0;
        while (i < keys.size()) {
            let key: string = keys.get(i);
            if (!this.vars.containsKey(key)) {
                this.vars.put(key, defaults.get(key));
                added = added + 1;
            }
            i = i + 1;
        }
        return added;
    }

    public fn join(name: string, suffix: string): string {
        return this.get(name) + suffix;
    }
}

// ==================== tests ====================

fn testEnvBasics(): void {
    let env: Env = new Env("test");
    env.set("HOME", "/home");
    if (env.scope == "test" && env.size() == 1 && env.has("HOME")
            && env.get("HOME") == "/home" && env.get("MISSING") == ""
            && env.getOrDefault("MISSING", "fallback") == "fallback"
            && env.join("HOME", "/user") == "/home/user") {
        io::println("PASS: env basics");
    } else {
        io::println("FAIL: env basics");
    }
}

fn testEnvUnset(): void {
    let env: Env = new Env("test");
    env.set("HOME", "/home");
    let first: bool = env.unset("HOME");
    let second: bool = env.unset("HOME");
    if (first && !second && !env.has("HOME") && env.size() == 0) {
        io::println("PASS: env unset");
    } else {
        io::println("FAIL: env unset");
    }
}

fn testEnvDefaults(): void {
    let env: Env = new Env("test");
    env.set("HOME", "/custom");
    let defaults: Env = new Env("defaults");
    defaults.set("HOME", "/default");
    defaults.set("PATH", "/bin");
    let added: int = env.applyDefaults(defaults);
    if (added == 1 && env.size() == 2 && env.get("HOME") == "/custom"
            && env.get("PATH") == "/bin" && env.names().size() == 2) {
        io::println("PASS: env defaults");
    } else {
        io::println("FAIL: env defaults");
    }
}

public fn run_all_env_tests(): void {
    io::println("=== platform/Env.tr Tests ===");
    testEnvBasics();
    testEnvUnset();
    testEnvDefaults();
}
