// Base64 encoding and decoding backed by native implementations.
import tt::util::ArrayList;
import tt::lang::DataFile;
import tt::json::JsonValue;

// ---- Data loaded from external JSON via DataFile ----

var _alphabetCache: HashMap<string, string> = new HashMap<string, string>();
var _alphabetLoaded: bool = false;

fn _ensureAlphabetLoaded(): void {
    if (_alphabetLoaded) {
        return;
    }
    let data: JsonValue = DataFile.load("encoding/base64_alphabets.json");
    if (data.isNull() || !data.isObject()) {
        _alphabetLoaded = true;
        return;
    }
    if (data.hasKey("base64")) {
        _alphabetCache.put("base64", data.get("base64").asString());
    }
    if (data.hasKey("base64url")) {
        _alphabetCache.put("base64url", data.get("base64url").asString());
    }
    if (data.hasKey("base32")) {
        _alphabetCache.put("base32", data.get("base32").asString());
    }
    _alphabetLoaded = true;
}

fn _getAlphabet(key: string, defaultVal: string): string {
    _ensureAlphabetLoaded();
    if (_alphabetCache.containsKey(key)) {
        return _alphabetCache.get(key);
    }
    return defaultVal;
}

let ALPHABET: string = _getAlphabet("base64", "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/");
let URL_ALPHABET: string = _getAlphabet("base64url", "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_");
let BASE32_ALPHABET: string = _getAlphabet("base32", "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567");

public class Base64 {
    public fn encode(input: string): string {
        return Base64_encode(input);
    }

    public fn decode(input: string): string {
        try {
            return Base64_decode(input);
        } catch (e: string) {
            return "";
        }
    }

    public fn encodeUrlSafe(data: string): string {
        // Encode with standard then replace +/ with -_ and strip padding
        let encoded: string = Base64_encode(data);
        let result: string = "";
        let i: int = 0;
        while (i < String.length(encoded)) {
            let c: string = String.charAt(encoded, i);
            if (c == "+") {
                result = result + "-";
            } else if (c == "/") {
                result = result + "_";
            } else if (c == "=") {
                // skip padding for URL-safe
            } else {
                result = result + c;
            }
            i = i + 1;
        }
        return result;
    }

    public fn decodeUrlSafe(data: string): string {
        // Convert URL-safe back to standard, add padding, then decode
        let standard: string = "";
        let i: int = 0;
        while (i < String.length(data)) {
            let c: string = String.charAt(data, i);
            if (c == "-") {
                standard = standard + "+";
            } else if (c == "_") {
                standard = standard + "/";
            } else {
                standard = standard + c;
            }
            i = i + 1;
        }
        // Add padding
        while (String.length(standard) % 4 != 0) {
            standard = standard + "=";
        }
        try {
            return Base64_decode(standard);
        } catch (e: string) {
            return "";
        }
    }

    public fn encodeWithoutPadding(data: string): string {
        let encoded: string = Base64_encode(data);
        // Remove trailing '=' padding characters
        while (String.length(encoded) > 0 && String.charAt(encoded, String.length(encoded) - 1) == "=") {
            encoded = String.substring(encoded, 0, String.length(encoded) - 1);
        }
        return encoded;
    }

    public fn encodeBytes(bytes: ArrayList<int>): string {
        // Encode raw bytes using the Base64 alphabet
        let result: string = "";
        let i: int = 0;
        let len: int = bytes.size();
        while (i < len) {
            let b0: int = bytes.get(i);
            let b1: int = (i + 1 < len) ? bytes.get(i + 1) : 0;
            let b2: int = (i + 2 < len) ? bytes.get(i + 2) : 0;
            let triple: int = (b0 * 65536) + (b1 * 256) + b2;
            result = result + Base64._char(ALPHABET, (triple / 262144) % 64);
            result = result + Base64._char(ALPHABET, (triple / 4096) % 64);
            if (i + 1 < len) {
                result = result + Base64._char(ALPHABET, (triple / 64) % 64);
            } else {
                result = result + "=";
            }
            if (i + 2 < len) {
                result = result + Base64._char(ALPHABET, triple % 64);
            } else {
                result = result + "=";
            }
            i = i + 3;
        }
        return result;
    }

    public fn decodeToBytes(data: string): ArrayList<int> {
        let result: ArrayList<int> = new ArrayList<int>();
        let n: int = String.length(data);
        let i: int = 0;
        while (i + 3 < n) {
            let c0: int = Base64._val(String.charAt(data, i));
            let c1: int = Base64._val(String.charAt(data, i + 1));
            let c2: int = Base64._val(String.charAt(data, i + 2));
            let c3: int = Base64._val(String.charAt(data, i + 3));
            let triple: int = (c0 * 262144) + (c1 * 4096) + (c2 * 64) + c3;
            result.add((triple / 65536) % 256);
            if (String.charAt(data, i + 2) != "=") {
                result.add((triple / 256) % 256);
            }
            if (String.charAt(data, i + 3) != "=") {
                result.add(triple % 256);
            }
            i = i + 4;
        }
        // Unpadded trailing group of 2 or 3 characters.
        if (i < n) {
            let c0: int = Base64._val(String.charAt(data, i));
            let c1: int = Base64._val(String.charAt(data, i + 1));
            let c2: int = 0;
            if (i + 2 < n) {
                c2 = Base64._val(String.charAt(data, i + 2));
            }
            let triple: int = (c0 * 262144) + (c1 * 4096) + (c2 * 64);
            result.add((triple / 65536) % 256);
            if (i + 2 < n && String.charAt(data, i + 2) != "=") {
                result.add((triple / 256) % 256);
            }
        }
        return result;
    }

    private fn _char(alphabet: string, idx: int): string {
        return String.charAt(alphabet, idx);
    }

    private fn _val(c: string): int {
        if (c == "=") { return 0; }
        let i: int = 0;
        while (i < String.length(ALPHABET)) {
            if (String.charAt(ALPHABET, i) == c) {
                return i;
            }
            i = i + 1;
        }
        // Also check URL alphabet
        i = 0;
        while (i < String.length(URL_ALPHABET)) {
            if (String.charAt(URL_ALPHABET, i) == c) {
                return i;
            }
            i = i + 1;
        }
        return 0;
    }
}

// Convert a string to UTF-8 bytes, including the four-byte form for
// supplementary code points (above 0xFFFF).
fn _utf8Bytes(s: string): ArrayList<int> {
    let out: ArrayList<int> = new ArrayList<int>();
    var i: int = 0;
    while (i < String.length(s)) {
        let cp: int = String.charAt(s, i) as int;
        if (cp < 128) {
            out.add(cp);
        } else if (cp < 2048) {
            out.add(192 + (cp / 64));
            out.add(128 + (cp % 64));
        } else if (cp < 65536) {
            out.add(224 + (cp / 4096));
            out.add(128 + ((cp / 64) % 64));
            out.add(128 + (cp % 64));
        } else if (cp < 1114112) {
            out.add(240 + (cp / 262144));
            out.add(128 + ((cp / 4096) % 64));
            out.add(128 + ((cp / 64) % 64));
            out.add(128 + (cp % 64));
        }
        i = i + 1;
    }
    return out;
}

// Convert UTF-8 bytes back to a string, including the four-byte form.
fn _fromUtf8Bytes(bytes: ArrayList<int>): string {
    let result: string = "";
    var i: int = 0;
    while (i < bytes.size()) {
        let b: int = bytes.get(i);
        if (b < 128) {
            result = result + String.fromCharCode(b);
            i = i + 1;
        } else if (b >= 192 && b < 224 && i + 1 < bytes.size()) {
            let cp: int = ((b - 192) * 64) + (bytes.get(i + 1) - 128);
            result = result + String.fromCharCode(cp);
            i = i + 2;
        } else if (b >= 224 && b < 240 && i + 2 < bytes.size()) {
            let cp: int = ((b - 224) * 4096) + ((bytes.get(i + 1) - 128) * 64) + (bytes.get(i + 2) - 128);
            result = result + String.fromCharCode(cp);
            i = i + 3;
        } else if (b >= 240 && b < 248 && i + 3 < bytes.size()) {
            let cp: int = ((b - 240) * 262144) + ((bytes.get(i + 1) - 128) * 4096) + ((bytes.get(i + 2) - 128) * 64) + (bytes.get(i + 3) - 128);
            result = result + String.fromCharCode(cp);
            i = i + 4;
        } else {
            result = result + String.fromCharCode(b);
            i = i + 1;
        }
    }
    return result;
}

// Encode a string to Base32 (RFC 4648).
public fn encodeBase32(s: string): string {
    let bytes: ArrayList<int> = _utf8Bytes(s);
    let len: int = bytes.size();
    // Process byte-by-byte using bit buffer. Mask after each byte to
    // keep buffer small and avoid i32 overflow on long inputs.
    let buffer: int = 0;
    let bits: int = 0;
    let k: int = 0;
    let result: string = "";
    while (k < len) {
        buffer = ((buffer & _lowMask(bits)) * 256) + bytes.get(k);
        bits = bits + 8;
        while (bits >= 5) {
            let shift: int = bits - 5;
            let idx: int = (buffer / _pow2(shift)) & 31;
            result = result + String.charAt(BASE32_ALPHABET, idx);
            bits = bits - 5;
        }
        buffer = buffer & _lowMask(bits);
        k = k + 1;
    }
    // Flush remaining bits
    if (bits > 0) {
        let idx: int = (buffer * _pow2(5 - bits)) & 31;
        result = result + String.charAt(BASE32_ALPHABET, idx);
    }
    // Add padding
    let modLen: int = len % 5;
    if (modLen == 1) {
        result = result + "======";
    } else if (modLen == 2) {
        result = result + "====";
    } else if (modLen == 3) {
        result = result + "===";
    } else if (modLen == 4) {
        result = result + "=";
    }
    return result;
}

// Decode a Base32 string back to the original string.
public fn decodeBase32(s: string): string {
    let buffer: int = 0;
    let bits: int = 0;
    let out: ArrayList<int> = new ArrayList<int>();
    let i: int = 0;
    while (i < String.length(s)) {
        let c: string = String.charAt(s, i);
        if (c == "=") {
            i = i + 1;
            continue;
        }
        let val: int = _base32Val(c);
        buffer = ((buffer & _lowMask(bits)) * 32) + val;
        bits = bits + 5;
        if (bits >= 8) {
            bits = bits - 8;
            let byteVal: int = (buffer / _pow2(bits)) & 255;
            out.add(byteVal);
        }
        i = i + 1;
    }
    return _fromUtf8Bytes(out);
}

// Helper: power of 2 (used for bit shifting in base32 bit buffer)
fn _pow2(exp: int): int {
    let result: int = 1;
    let i: int = 0;
    while (i < exp) {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// Helper: bit mask of `bits` low bits set, i.e. (1 << bits) - 1.
// Used to keep the base32 bit buffer small and prevent i32 overflow.
fn _lowMask(bits: int): int {
    if (bits <= 0) {
        return 0;
    }
    if (bits >= 31) {
        return 2147483647;
    }
    return _pow2(bits) - 1;
}

// Helper: get Base32 value for a character
fn _base32Val(c: string): int {
    let i: int = 0;
    while (i < String.length(BASE32_ALPHABET)) {
        if (String.charAt(BASE32_ALPHABET, i) == c) {
            return i;
        }
        i = i + 1;
    }
    // Handle lowercase
    let upper: string = String.toUpperCase(c);
    i = 0;
    while (i < String.length(BASE32_ALPHABET)) {
        if (String.charAt(BASE32_ALPHABET, i) == upper) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

// Encode a string to Base16 (hexadecimal).
public fn encodeBase16(s: string): string {
    let HEX_CHARS: string = "0123456789ABCDEF";
    let result: string = "";
    let i: int = 0;
    while (i < String.length(s)) {
        let code: int = String.charAt(s, i) as int;
        let hi: int = code / 16;
        let lo: int = code % 16;
        result = result + String.charAt(HEX_CHARS, hi) + String.charAt(HEX_CHARS, lo);
        i = i + 1;
    }
    return result;
}

// Decode a Base16 (hexadecimal) string back to the original string.
public fn decodeBase16(s: string): string {
    let HEX_CHARS: string = "0123456789ABCDEF";
    let result: string = "";
    let i: int = 0;
    while (i + 1 < String.length(s)) {
        let hiChar: string = String.charAt(s, i);
        let loChar: string = String.charAt(s, i + 1);
        let hi: int = _hexVal(hiChar);
        let lo: int = _hexVal(loChar);
        result = result + String.fromCharCode(hi * 16 + lo);
        i = i + 2;
    }
    return result;
}

// Helper: get hex value for a character
fn _hexVal(c: string): int {
    let HEX_CHARS: string = "0123456789ABCDEF";
    let upper: string = String.toUpperCase(c);
    let i: int = 0;
    while (i < String.length(HEX_CHARS)) {
        if (String.charAt(HEX_CHARS, i) == upper) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

// Encode a string to Base85 (Ascii85).
// Ascii85 encodes 4 bytes into 5 characters using characters 33-117 (! through u).
// Zero-length groups are encoded as 'z'.
public fn encodeBase85(s: string): string {
    let bytes: ArrayList<int> = _utf8Bytes(s);
    let len: int = bytes.size();
    let result: string = "";
    let j: int = 0;
    while (j < len) {
        let b0: int = bytes.get(j);
        let b1: int = (j + 1 < len) ? bytes.get(j + 1) : 0;
        let b2: int = (j + 2 < len) ? bytes.get(j + 2) : 0;
        let b3: int = (j + 3 < len) ? bytes.get(j + 3) : 0;
        let count: int = len - j;
        if (count > 4) { count = 4; }
        // long accumulation avoids i32 overflow when a byte is 255
        var val: long = ((b0 as long) << 24) | ((b1 as long) << 16) | ((b2 as long) << 8) | (b3 as long);
        if (count == 4 && val == 0L) {
            result = result + "z";
        } else {
            // Five base-85 digits, least significant first.
            let digits: ArrayList<int> = new ArrayList<int>();
            var d: int = 0;
            while (d < 5) {
                digits.add((val % 85L) as int);
                val = val / 85L;
                d = d + 1;
            }
            // Emit the most significant digits first; partial groups emit n+1.
            var idx: int = 4;
            while (idx >= 5 - (count + 1)) {
                result = result + String.fromCharCode(33 + digits.get(idx));
                idx = idx - 1;
            }
        }
        j = j + 4;
    }
    return result;
}

// Decode a Base85 (Ascii85) string back to the original string.
public fn decodeBase85(s: string): string {
    let out: ArrayList<int> = new ArrayList<int>();
    let i: int = 0;
    while (i < String.length(s)) {
        let c: string = String.charAt(s, i);
        if (c == "z") {
            out.add(0);
            out.add(0);
            out.add(0);
            out.add(0);
            i = i + 1;
        } else {
            let group: string = "";
            let k: int = 0;
            while (k < 5 && i < String.length(s)) {
                let ch: string = String.charAt(s, i);
                if (ch == "z") { break; }
                group = group + ch;
                k = k + 1;
                i = i + 1;
            }
            var val: long = 0L;
            let g: int = 0;
            while (g < String.length(group)) {
                val = (val * 85L) + ((String.charAt(group, g) as int) - 33);
                g = g + 1;
            }
            let padNeeded: int = 5 - String.length(group);
            let p: int = 0;
            while (p < padNeeded) {
                val = (val * 85L) + 84L;
                p = p + 1;
            }
            let byteCount: int = String.length(group) - 1;
            let b3: int = (val % 256L) as int;
            val = val / 256L;
            let b2: int = (val % 256L) as int;
            val = val / 256L;
            let b1: int = (val % 256L) as int;
            val = val / 256L;
            let b0: int = (val % 256L) as int;
            if (byteCount >= 1) { out.add(b0); }
            if (byteCount >= 2) { out.add(b1); }
            if (byteCount >= 3) { out.add(b2); }
            if (byteCount >= 4) { out.add(b3); }
        }
    }
    return _fromUtf8Bytes(out);
}
