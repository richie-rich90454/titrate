// CalculusODE provides adaptive ODE solvers (RK45, BDF, Adams, events).
import tt::util::ArrayList;
import tt::math::Math;
import tt::math::MathAdvanced;
import tt::math::MathTrig;

// ==================== Advanced ODE Solvers ====================

// Helper: add two vectors element-wise
fn vecAdd(a: ArrayList<double>, b: ArrayList<double>): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < a.size()) {
        result.add(a.get(i) + b.get(i));
        i = i + 1;
    }
    return result;
}

// Helper: add scaled vector: a + s*b
fn vecAddScaled(a: ArrayList<double>, b: ArrayList<double>, s: double): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < a.size()) {
        result.add(a.get(i) + s * b.get(i));
        i = i + 1;
    }
    return result;
}

// Helper: scale a vector by a scalar
fn vecScale(v: ArrayList<double>, s: double): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < v.size()) {
        result.add(v.get(i) * s);
        i = i + 1;
    }
    return result;
}

// Helper: copy a vector
fn vecCopy(v: ArrayList<double>): ArrayList<double> {
    let result: ArrayList<double> = new ArrayList<double>();
    var i: int = 0;
    while (i < v.size()) {
        result.add(v.get(i));
        i = i + 1;
    }
    return result;
}

// Helper: max norm of a vector
fn vecMaxNorm(v: ArrayList<double>): double {
    var m: double = 0.0;
    var i: int = 0;
    while (i < v.size()) {
        let a: double = Math.fabs(v.get(i));
        if (a > m) {
            m = a;
        }
        i = i + 1;
    }
    return m;
}

// Helper: weighted error norm for adaptive step control
fn vecErrorNorm(y: ArrayList<double>, err: ArrayList<double>, tol: double): double {
    var s: double = 0.0;
    var i: int = 0;
    while (i < y.size()) {
        let sc: double = tol * (1.0 + Math.fabs(y.get(i)));
        let e: double = err.get(i) / sc;
        s = s + e * e;
        i = i + 1;
    }
    return MathAdvanced.sqrt(s / (y.size() as double));
}
// Dormand-Prince RK45 adaptive step-size solver for systems of ODEs
// y' = f(t, y), y(t0) = y0, tSpan = [t0, tf]
// Uses embedded 4th and 5th order Runge-Kutta for error estimation
// Adjusts step size based on error vs tolerance
// Returns list of solution vectors at each time step
public fn solveODERK45(f: fn(double, ArrayList<double>): ArrayList<double>, y0: ArrayList<double>, tSpan: ArrayList<double>, tol: double): ArrayList<ArrayList<double>> {
    let result: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    var t: double = tSpan.get(0);
    let tEnd: double = tSpan.get(1);
    var y: ArrayList<double> = vecCopy(y0);

    // Store initial condition
    result.add(vecCopy(y));

    // Initial step size
    var h: double = (tEnd - t) / 100.0;
    if (h < 1e-10) {
        h = 1e-10;
    }

    // Dormand-Prince coefficients
    let c2: double = 1.0 / 5.0;
    let c3: double = 3.0 / 10.0;
    let c4: double = 4.0 / 5.0;
    let c5: double = 8.0 / 9.0;

    let a21: double = 1.0 / 5.0;
    let a31: double = 3.0 / 40.0;
    let a32: double = 9.0 / 40.0;
    let a41: double = 44.0 / 45.0;
    let a42: double = -56.0 / 15.0;
    let a43: double = 32.0 / 9.0;
    let a51: double = 19372.0 / 6561.0;
    let a52: double = -25360.0 / 2187.0;
    let a53: double = 64448.0 / 6561.0;
    let a54: double = -212.0 / 729.0;
    let a61: double = 9017.0 / 3168.0;
    let a62: double = -355.0 / 33.0;
    let a63: double = 46732.0 / 5247.0;
    let a64: double = 49.0 / 176.0;
    let a65: double = -5103.0 / 18656.0;

    let b1: double = 35.0 / 384.0;
    let b3: double = 500.0 / 1113.0;
    let b4: double = 125.0 / 192.0;
    let b5: double = -2187.0 / 6784.0;
    let b6: double = 11.0 / 84.0;

    let e1: double = 71.0 / 57600.0;
    let e3: double = -71.0 / 16695.0;
    let e4: double = 71.0 / 1920.0;
    let e5: double = -17253.0 / 339200.0;
    let e6: double = 22.0 / 525.0;
    let e7: double = -1.0 / 40.0;

    let maxIter: int = 1000000;
    var iter: int = 0;
    while (t < tEnd && iter < maxIter) {
        iter = iter + 1;

        if (t + h > tEnd) {
            h = tEnd - t;
        }

        // Compute RK stages
        let k1: ArrayList<double> = vecScale(f(t, y), h);

        let y2: ArrayList<double> = vecAddScaled(y, k1, a21);
        let k2: ArrayList<double> = vecScale(f(t + c2 * h, y2), h);

        let y3: ArrayList<double> = vecAddScaled(vecAddScaled(y, k1, a31), k2, a32);
        let k3: ArrayList<double> = vecScale(f(t + c3 * h, y3), h);

        let y4: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(y, k1, a41), k2, a42), k3, a43);
        let k4: ArrayList<double> = vecScale(f(t + c4 * h, y4), h);

        let y5: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(y, k1, a51), k2, a52), k3, a53), k4, a54);
        let k5: ArrayList<double> = vecScale(f(t + c5 * h, y5), h);

        let y6: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(y, k1, a61), k2, a62), k3, a63), k4, a64), k5, a65);
        let k6: ArrayList<double> = vecScale(f(t + h, y6), h);

        // 5th order solution
        let yNew: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(y, k1, b1), k3, b3), k4, b4), k5, b5), k6, b6);

        // 7th stage for error estimation
        let k7: ArrayList<double> = vecScale(f(t + h, yNew), h);

        // Error estimate
        let errDiff: ArrayList<double> = new ArrayList<double>();
        var ei: int = 0;
        while (ei < y.size()) {
            let errVal: double = e1 * k1.get(ei) + e3 * k3.get(ei) + e4 * k4.get(ei) + e5 * k5.get(ei) + e6 * k6.get(ei) + e7 * k7.get(ei);
            errDiff.add(errVal);
            ei = ei + 1;
        }

        let errNorm: double = vecErrorNorm(yNew, errDiff, tol);

        if (errNorm <= 1.0 || h <= 1e-12) {
            // Accept step
            t = t + h;
            y = vecCopy(yNew);
            result.add(vecCopy(y));
        }

        // Adjust step size
        if (errNorm > 0.0) {
            let factor: double = 0.9 * MathAdvanced.pow(1.0 / errNorm, 0.2);
            if (factor < 0.2) {
                h = h * 0.2;
            } else {
                if (factor > 5.0) {
                    h = h * 5.0;
                } else {
                    h = h * factor;
                }
            }
        } else {
            h = h * 5.0;
        }

        if (h < 1e-14) {
            h = 1e-14;
        }
        if (h > tEnd - t && t < tEnd) {
            h = tEnd - t;
        }
    }

    return result;
}
// BDF (Backward Differentiation Formula) solver for stiff systems
// Fixed-order BDF with simple Newton iteration for the implicit step
// order should be 1-5
// Returns list of solution vectors at each time step
public fn solveODEBDF(f: fn(double, ArrayList<double>): ArrayList<double>, y0: ArrayList<double>, tSpan: ArrayList<double>, order: int, tol: double): ArrayList<ArrayList<double>> {
    let result: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let t0: double = tSpan.get(0);
    let tEnd: double = tSpan.get(1);
    let n: int = y0.size();

    var ord: int = order;
    if (ord < 1) {
        ord = 1;
    }
    if (ord > 5) {
        ord = 5;
    }

    var h: double = (tEnd - t0) / 1000.0;
    if (h < 1e-10) {
        h = 1e-10;
    }

    // BDF coefficients
    let alpha: ArrayList<double> = new ArrayList<double>();
    let beta: double;

    if (ord == 1) {
        alpha.add(1.0);
        beta = 1.0;
    } else {
        if (ord == 2) {
            alpha.add(4.0 / 3.0);
            alpha.add(-1.0 / 3.0);
            beta = 2.0 / 3.0;
        } else {
            if (ord == 3) {
                alpha.add(18.0 / 11.0);
                alpha.add(-9.0 / 11.0);
                alpha.add(2.0 / 11.0);
                beta = 6.0 / 11.0;
            } else {
                if (ord == 4) {
                    alpha.add(48.0 / 25.0);
                    alpha.add(-36.0 / 25.0);
                    alpha.add(16.0 / 25.0);
                    alpha.add(-3.0 / 25.0);
                    beta = 12.0 / 25.0;
                } else {
                    alpha.add(300.0 / 137.0);
                    alpha.add(-300.0 / 137.0);
                    alpha.add(200.0 / 137.0);
                    alpha.add(-75.0 / 137.0);
                    alpha.add(12.0 / 137.0);
                    beta = 60.0 / 137.0;
                }
            }
        }
    }

    // Bootstrap with RK4
    let history: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    history.add(vecCopy(y0));
    result.add(vecCopy(y0));

    var bootT: double = t0;
    var bootY: ArrayList<double> = vecCopy(y0);
    var bootIdx: int = 1;
    while (bootIdx < ord) {
        let k1b: ArrayList<double> = f(bootT, bootY);
        let yTemp2: ArrayList<double> = vecAddScaled(bootY, k1b, h / 2.0);
        let k2b: ArrayList<double> = f(bootT + h / 2.0, yTemp2);
        let yTemp3: ArrayList<double> = vecAddScaled(bootY, k2b, h / 2.0);
        let k3b: ArrayList<double> = f(bootT + h / 2.0, yTemp3);
        let yTemp4: ArrayList<double> = vecAddScaled(bootY, k3b, h);
        let k4b: ArrayList<double> = f(bootT + h, yTemp4);

        let yNew: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < n) {
            let val: double = bootY.get(j) + (h / 6.0) * (k1b.get(j) + 2.0 * k2b.get(j) + 2.0 * k3b.get(j) + k4b.get(j));
            yNew.add(val);
            j = j + 1;
        }

        bootT = bootT + h;
        bootY = vecCopy(yNew);
        history.add(vecCopy(yNew));
        result.add(vecCopy(yNew));
        bootIdx = bootIdx + 1;
    }

    // Main BDF loop
    var t: double = t0 + (ord as double) * h;
    let maxIter: int = 1000000;
    var iter: int = 0;
    while (t < tEnd && iter < maxIter) {
        iter = iter + 1;

        if (t + h > tEnd) {
            h = tEnd - t;
        }

        // Compute explicit part
        let explicitPart: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < n) {
            explicitPart.add(0.0);
            j = j + 1;
        }
        var ai: int = 0;
        while (ai < alpha.size()) {
            let histIdx: int = history.size() - 1 - ai;
            var j: int = 0;
            while (j < n) {
                explicitPart.set(j, explicitPart.get(j) + alpha.get(ai) * history.get(histIdx).get(j));
                j = j + 1;
            }
            ai = ai + 1;
        }

        // Newton iteration
        var yCurr: ArrayList<double> = vecCopy(explicitPart);
        let newtonTol: double = tol * 0.01;
        var newtonIter: int = 0;
        let maxNewtonIter: int = 20;
        var converged: bool = false;
        while (newtonIter < maxNewtonIter && !converged) {
            let fVal: ArrayList<double> = f(t + h, yCurr);

            let residual: ArrayList<double> = new ArrayList<double>();
            var j: int = 0;
            while (j < n) {
                residual.add(yCurr.get(j) - explicitPart.get(j) - h * beta * fVal.get(j));
                j = j + 1;
            }

            let resNorm: double = vecMaxNorm(residual);
            if (resNorm < newtonTol) {
                converged = true;
            } else {
                var j: int = 0;
                while (j < n) {
                    yCurr.set(j, explicitPart.get(j) + h * beta * fVal.get(j));
                    j = j + 1;
                }
            }
            newtonIter = newtonIter + 1;
        }

        t = t + h;
        history.add(vecCopy(yCurr));
        result.add(vecCopy(yCurr));

        while (history.size() > ord) {
            history.removeAt(0);
        }
    }

    return result;
}
// Adams-Bashforth-Moulton predictor-corrector method
// Uses AB4 as predictor, AM4 as corrector
// Bootstraps first 3 steps with RK4
// Returns list of solution vectors at each time step
public fn solveODEAdams(f: fn(double, ArrayList<double>): ArrayList<double>, y0: ArrayList<double>, tSpan: ArrayList<double>, tol: double): ArrayList<ArrayList<double>> {
    let result: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let t0: double = tSpan.get(0);
    let tEnd: double = tSpan.get(1);
    let n: int = y0.size();

    var h: double = (tEnd - t0) / 1000.0;
    if (h < 1e-10) {
        h = 1e-10;
    }

    // AB4 coefficients
    let ab1: double = 55.0 / 24.0;
    let ab2: double = -59.0 / 24.0;
    let ab3: double = 37.0 / 24.0;
    let ab4: double = -9.0 / 24.0;

    // AM4 coefficients
    let am1: double = 251.0 / 720.0;
    let am2: double = 646.0 / 720.0;
    let am3: double = -264.0 / 720.0;
    let am4: double = 106.0 / 720.0;
    let am5: double = -19.0 / 720.0;

    let pastF: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let pastY: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();

    pastY.add(vecCopy(y0));
    result.add(vecCopy(y0));

    // Bootstrap first 3 steps with RK4
    var t: double = t0;
    var y: ArrayList<double> = vecCopy(y0);
    pastF.add(f(t, y));

    var bootIdx: int = 0;
    while (bootIdx < 3) {
        let k1a: ArrayList<double> = f(t, y);
        let yT2: ArrayList<double> = vecAddScaled(y, k1a, h / 2.0);
        let k2a: ArrayList<double> = f(t + h / 2.0, yT2);
        let yT3: ArrayList<double> = vecAddScaled(y, k2a, h / 2.0);
        let k3a: ArrayList<double> = f(t + h / 2.0, yT3);
        let yT4: ArrayList<double> = vecAddScaled(y, k3a, h);
        let k4a: ArrayList<double> = f(t + h, yT4);

        let yNew: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < n) {
            let val: double = y.get(j) + (h / 6.0) * (k1a.get(j) + 2.0 * k2a.get(j) + 2.0 * k3a.get(j) + k4a.get(j));
            yNew.add(val);
            j = j + 1;
        }

        t = t + h;
        y = vecCopy(yNew);
        pastY.add(vecCopy(y));
        pastF.add(f(t, y));
        result.add(vecCopy(y));
        bootIdx = bootIdx + 1;
    }

    // AB4-AM4 main loop
    let maxIter: int = 1000000;
    var iter: int = 0;
    while (t < tEnd && iter < maxIter) {
        iter = iter + 1;

        if (t + h > tEnd) {
            h = tEnd - t;
        }

        let fN: int = pastF.size();

        // AB4 predictor
        let yPred: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(
            pastY.get(pastY.size() - 1),
            pastF.get(fN - 1), h * ab1),
            pastF.get(fN - 2), h * ab2),
            pastF.get(fN - 3), h * ab3),
            pastF.get(fN - 4), h * ab4);

        let fPred: ArrayList<double> = f(t + h, yPred);

        // AM4 corrector
        let yCorr: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(
            pastY.get(pastY.size() - 1),
            fPred, h * am1),
            pastF.get(fN - 1), h * am2),
            pastF.get(fN - 2), h * am3),
            pastF.get(fN - 3), h * am4);

        // Second corrector iteration
        let fCorr: ArrayList<double> = f(t + h, yCorr);
        let yCorr2: ArrayList<double> = vecAddScaled(vecAddScaled(vecAddScaled(vecAddScaled(
            pastY.get(pastY.size() - 1),
            fCorr, h * am1),
            pastF.get(fN - 1), h * am2),
            pastF.get(fN - 2), h * am3),
            pastF.get(fN - 3), h * am4);

        t = t + h;
        y = vecCopy(yCorr2);
        pastY.add(vecCopy(y));
        pastF.add(f(t, y));
        result.add(vecCopy(y));

        while (pastF.size() > 4) {
            pastF.removeAt(0);
        }
        while (pastY.size() > 4) {
            pastY.removeAt(0);
        }
    }

    return result;
}
// ODE solver with event detection (zero-crossing)
// Uses RK4 with bisection to find exact event time
// Stops integration when an event function crosses zero
// events: ArrayList of event functions, each returns a double; zero-crossing triggers stop
public fn solveODEWithEvents(f: fn(double, ArrayList<double>): ArrayList<double>, y0: ArrayList<double>, tSpan: ArrayList<double>, events: ArrayList<fn(double, ArrayList<double>): double>, tol: double): ArrayList<ArrayList<double>> {
    let result: ArrayList<ArrayList<double>> = new ArrayList<ArrayList<double>>();
    let t0: double = tSpan.get(0);
    let tEnd: double = tSpan.get(1);
    let n: int = y0.size();
    let nEvents: int = events.size();

    var h: double = (tEnd - t0) / 1000.0;
    if (h < 1e-10) {
        h = 1e-10;
    }

    var t: double = t0;
    var y: ArrayList<double> = vecCopy(y0);
    result.add(vecCopy(y));

    // Evaluate initial event values
    let prevEventVals: ArrayList<double> = new ArrayList<double>();
    var ei: int = 0;
    while (ei < nEvents) {
        prevEventVals.add(events.get(ei)(t, y));
        ei = ei + 1;
    }

    let maxIter: int = 1000000;
    var iter: int = 0;
    var eventTriggered: bool = false;
    while (t < tEnd && iter < maxIter && !eventTriggered) {
        iter = iter + 1;

        if (t + h > tEnd) {
            h = tEnd - t;
        }

        // RK4 step
        let k1e: ArrayList<double> = f(t, y);
        let yT2: ArrayList<double> = vecAddScaled(y, k1e, h / 2.0);
        let k2e: ArrayList<double> = f(t + h / 2.0, yT2);
        let yT3: ArrayList<double> = vecAddScaled(y, k2e, h / 2.0);
        let k3e: ArrayList<double> = f(t + h / 2.0, yT3);
        let yT4: ArrayList<double> = vecAddScaled(y, k3e, h);
        let k4e: ArrayList<double> = f(t + h, yT4);

        let yNew: ArrayList<double> = new ArrayList<double>();
        var j: int = 0;
        while (j < n) {
            let val: double = y.get(j) + (h / 6.0) * (k1e.get(j) + 2.0 * k2e.get(j) + 2.0 * k3e.get(j) + k4e.get(j));
            yNew.add(val);
            j = j + 1;
        }

        let tNew: double = t + h;

        // Evaluate event functions at new point
        let currEventVals: ArrayList<double> = new ArrayList<double>();
        var ei: int = 0;
        while (ei < nEvents) {
            currEventVals.add(events.get(ei)(tNew, yNew));
            ei = ei + 1;
        }

        // Check for zero-crossing
        var crossedIdx: int = -1;
        var ei: int = 0;
        while (ei < nEvents && crossedIdx == -1) {
            let prev: double = prevEventVals.get(ei);
            let curr: double = currEventVals.get(ei);
            if (prev * curr < 0.0) {
                crossedIdx = ei;
            }
            ei = ei + 1;
        }

        if (crossedIdx >= 0) {
            // Bisection to find exact event time
            var tA: double = t;
            var yA: ArrayList<double> = vecCopy(y);
            var tB: double = tNew;
            var yB: ArrayList<double> = vecCopy(yNew);
            let eventFn: fn(double, ArrayList<double>): double = events.get(crossedIdx);

            var bisectIter: int = 0;
            let maxBisect: int = 50;
            var tMid: double = (tA + tB) / 2.0;
            var yMid: ArrayList<double> = vecCopy(yA);

            while (bisectIter < maxBisect) {
                let hMid: double = (tB - tA) / 2.0;

                // RK4 from tA to tMid
                let bk1: ArrayList<double> = f(tA, yA);
                let byT2: ArrayList<double> = vecAddScaled(yA, bk1, hMid / 2.0);
                let bk2: ArrayList<double> = f(tA + hMid / 2.0, byT2);
                let byT3: ArrayList<double> = vecAddScaled(yA, bk2, hMid / 2.0);
                let bk3: ArrayList<double> = f(tA + hMid / 2.0, byT3);
                let byT4: ArrayList<double> = vecAddScaled(yA, bk3, hMid);
                let bk4: ArrayList<double> = f(tA + hMid, byT4);

                yMid = new ArrayList<double>();
                var j: int = 0;
                while (j < n) {
                    let val: double = yA.get(j) + (hMid / 6.0) * (bk1.get(j) + 2.0 * bk2.get(j) + 2.0 * bk3.get(j) + bk4.get(j));
                    yMid.add(val);
                    j = j + 1;
                }
                tMid = tA + hMid;

                let midVal: double = eventFn(tMid, yMid);
                let aVal: double = eventFn(tA, yA);

                if (Math.fabs(midVal) < tol * 1e-6) {
                    bisectIter = maxBisect;
                } else {
                    if (aVal * midVal < 0.0) {
                        tB = tMid;
                        yB = vecCopy(yMid);
                    } else {
                        tA = tMid;
                        yA = vecCopy(yMid);
                    }
                }
                bisectIter = bisectIter + 1;
            }

            result.add(vecCopy(yMid));
            eventTriggered = true;
        } else {
            // No event, accept step
            t = tNew;
            y = vecCopy(yNew);
            result.add(vecCopy(y));

            var ei: int = 0;
            while (ei < nEvents) {
                prevEventVals.set(ei, currEventVals.get(ei));
                ei = ei + 1;
            }
        }
    }

    return result;
}
