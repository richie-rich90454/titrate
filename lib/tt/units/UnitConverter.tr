// UnitConverter provides unit conversion using data from conversions.json.
import tt::util::ArrayList;
import tt::util::HashMap;
import tt::lang::DataFile;
import tt::json::JsonValue;

// Cache for conversion data loaded from DataFile. Keys are "category.unit";
// _unitCategory resolves a bare unit name to its category (temperature wins
// for the ambiguous names "C" and "F").
let _conversionsCache: HashMap<string, JsonValue> = new HashMap<string, JsonValue>();
let _unitCategory: HashMap<string, string> = new HashMap<string, string>();
var _conversionsLoaded: bool = false;

fn _ensureConversionsLoaded(): void {
    if (_conversionsLoaded) {
        return;
    }
    let data: JsonValue = DataFile.load("units/conversions.json");
    if (!data.isNull() && data.isObject()) {
        let categories: JsonValue = data.get("categories");
        if (!categories.isNull() && categories.isObject()) {
            let catKeys: ArrayList<string> = categories.keys();
            var ci: int = 0;
            while (ci < catKeys.size()) {
                let cat: JsonValue = categories.get(catKeys.get(ci));
                if (!cat.isNull() && cat.isObject() && cat.hasKey("units")) {
                    let units: JsonValue = cat.get("units");
                    if (units.isObject()) {
                        let unitKeys: ArrayList<string> = units.keys();
                        var ui: int = 0;
                        while (ui < unitKeys.size()) {
                            let catName: string = catKeys.get(ci);
                            let unitName: string = unitKeys.get(ui);
                            _conversionsCache.put(catName + "." + unitName, units.get(unitName));
                            if (catName == "temperature" || !_unitCategory.containsKey(unitName)) {
                                _unitCategory.put(unitName, catName);
                            }
                            ui = ui + 1;
                        }
                    }
                }
                ci = ci + 1;
            }
        }
    }
    _conversionsLoaded = true;
}

// Look up a unit's raw JSON data by bare name.
fn _getUnitData(unit: string): JsonValue {
    _ensureConversionsLoaded();
    if (_unitCategory.containsKey(unit)) {
        let key: string = _unitCategory.get(unit) + "." + unit;
        if (_conversionsCache.containsKey(key)) {
            return _conversionsCache.get(key);
        }
    }
    return JsonValue.ofNull();
}

fn _factorOf(data: JsonValue): double {
    if (data.isNull()) { return 0.0; }
    if (data.isObject() && data.hasKey("factor")) { return data.get("factor").asNumber(); }
    if (data.isNumber()) { return data.asNumber(); }
    return 0.0;
}

fn _offsetOf(data: JsonValue): double {
    if (!data.isNull() && data.isObject() && data.hasKey("offset")) {
        return data.get("offset").asNumber();
    }
    return 0.0;
}

// Convert a value between two units. Affine units (temperature) use
// base = value * factor + offset, and the reverse on the target side.
public fn convert(value: double, fromUnit: string, toUnit: string): double {
    _ensureConversionsLoaded();
    // Same unit: no conversion needed
    if (fromUnit == toUnit) {
        return value;
    }
    let fromData: JsonValue = _getUnitData(fromUnit);
    let toData: JsonValue = _getUnitData(toUnit);
    let fromFactor: double = _factorOf(fromData);
    let toFactor: double = _factorOf(toData);
    if (fromFactor == 0.0 || toFactor == 0.0) {
        return 0.0;
    }
    let baseValue: double = value * fromFactor + _offsetOf(fromData);
    return (baseValue - _offsetOf(toData)) / toFactor;
}

// Convert a value between compound units (e.g., m/s to km/h). The first
// entry is a numerator unit; subsequent entries are denominators. A leading
// "/" on a unit (or a "/" entry) marks denominators explicitly.
public fn convertCompound(value: double, fromUnits: ArrayList<string>, toUnits: ArrayList<string>): double {
    var result: double = value;
    var denominator: bool = false;
    var i: int = 0;
    while (i < fromUnits.size() && i < toUnits.size()) {
        var from: string = fromUnits.get(i);
        var to: string = toUnits.get(i);
        if (from == "/") {
            denominator = true;
            i = i + 1;
            continue;
        }
        if (String.length(from) > 0 && String.charAt(from, 0) == "/") {
            from = String.substring(from, 1, String.length(from));
            denominator = true;
        }
        if (String.length(to) > 0 && String.charAt(to, 0) == "/") {
            to = String.substring(to, 1, String.length(to));
        }
        if (denominator || i > 0) {
            result = convert(result, to, from);
        } else {
            result = convert(result, from, to);
        }
        i = i + 1;
    }
    return result;
}

// Get the base dimensions for a unit (e.g., "N" -> {"length": 1, "mass": 1, "time": -2}).
public fn dimensionalAnalysis(unit: string): HashMap<string, int> {
    let result: HashMap<string, int> = new HashMap<string, int>();
    _ensureConversionsLoaded();
    let unitData: JsonValue = _getUnitData(unit);
    if (!unitData.isNull()) {
        if (unitData.isObject() && unitData.hasKey("dimensions")) {
            let dims: JsonValue = unitData.get("dimensions");
            if (dims.isObject()) {
                let keys: ArrayList<string> = dims.keys();
                var i: int = 0;
                while (i < keys.size()) {
                    let key: string = keys.get(i);
                    result.put(key, dims.get(key).asInt());
                    i = i + 1;
                }
            }
        }
    }
    return result;
}

// Find all units compatible with the given unit (same base dimensions).
public fn compatibleUnits(unit: string): ArrayList<string> {
    let result: ArrayList<string> = new ArrayList<string>();
    _ensureConversionsLoaded();
    let targetDims: HashMap<string, int> = dimensionalAnalysis(unit);
    if (targetDims.size() == 0) {
        return result;
    }
    let allKeys: ArrayList<string> = _unitCategory.keys();
    var i: int = 0;
    while (i < allKeys.size()) {
        let key: string = allKeys.get(i);
        let otherDims: HashMap<string, int> = dimensionalAnalysis(key);
        if (_dimensionsEqual(targetDims, otherDims)) {
            result.add(key);
        }
        i = i + 1;
    }
    return result;
}

// UnitTracker tracks a value with its unit for chained conversions.
public class UnitTracker {
    public double value;
    public string unit;

    public fn init(value: double, unit: string) {
        this.value = value;
        this.unit = unit;
    }

    // Convert to a target unit and return a new UnitTracker.
    public fn to(targetUnit: string): UnitTracker {
        let converted: double = convert(this.value, this.unit, targetUnit);
        return new UnitTracker(converted, targetUnit);
    }

    public fn getValue(): double {
        return this.value;
    }

    public fn getUnit(): string {
        return this.unit;
    }
}

// Check if two dimension maps are equal.
fn _dimensionsEqual(a: HashMap<string, int>, b: HashMap<string, int>): bool {
    if (a.size() != b.size()) {
        return false;
    }
    let keys: ArrayList<string> = a.keys();
    var i: int = 0;
    while (i < keys.size()) {
        let key: string = keys.get(i);
        if (!b.containsKey(key)) {
            return false;
        }
        if (a.get(key) != b.get(key)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
