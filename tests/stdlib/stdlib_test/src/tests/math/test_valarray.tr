// ==================== ValArray shift/cshift ====================

public fn test_va_shift_positive(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    va.data.add(4.0);
    // shift(1): shifts left by 1, zeros fill in
    // result[0] = data[1] = 2, result[1] = data[2] = 3, result[2] = data[3] = 4, result[3] = 0
    let result: ValArray = va.shift(1);
    if (result.get(0) == 2.0 && result.get(1) == 3.0 && result.get(2) == 4.0 && result.get(3) == 0.0) {
        io::println("PASS: ValArray.shift(1) shifts left with zero fill");
    } else {
        io::println("FAIL: ValArray.shift(1)");
    }
}

public fn test_va_shift_negative(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    va.data.add(4.0);
    // shift(-1): shifts right by 1, zeros fill in
    // result[0] = 0, result[1] = data[0] = 1, result[2] = data[1] = 2, result[3] = data[2] = 3
    let result: ValArray = va.shift(-1);
    if (result.get(0) == 0.0 && result.get(1) == 1.0 && result.get(2) == 2.0 && result.get(3) == 3.0) {
        io::println("PASS: ValArray.shift(-1) shifts right with zero fill");
    } else {
        io::println("FAIL: ValArray.shift(-1)");
    }
}

public fn test_va_shift_zero(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    let result: ValArray = va.shift(0);
    if (result.get(0) == 1.0 && result.get(1) == 2.0) {
        io::println("PASS: ValArray.shift(0) returns copy");
    } else {
        io::println("FAIL: ValArray.shift(0)");
    }
}

public fn test_va_shift_large(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    let result: ValArray = va.shift(5);
    if (result.get(0) == 0.0 && result.get(1) == 0.0) {
        io::println("PASS: ValArray.shift(n>=size) all zeros");
    } else {
        io::println("FAIL: ValArray.shift large");
    }
}

public fn test_va_cshift_positive(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    va.data.add(4.0);
    // cshift(1): circular shift left by 1
    // result[0] = data[1] = 2, result[1] = data[2] = 3, result[2] = data[3] = 4, result[3] = data[0] = 1
    let result: ValArray = va.cshift(1);
    if (result.get(0) == 2.0 && result.get(1) == 3.0 && result.get(2) == 4.0 && result.get(3) == 1.0) {
        io::println("PASS: ValArray.cshift(1) circular left");
    } else {
        io::println("FAIL: ValArray.cshift(1)");
    }
}

public fn test_va_cshift_negative(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    va.data.add(4.0);
    // cshift(-1): circular shift right by 1
    // result[0] = data[3] = 4, result[1] = data[0] = 1, result[2] = data[1] = 2, result[3] = data[2] = 3
    let result: ValArray = va.cshift(-1);
    if (result.get(0) == 4.0 && result.get(1) == 1.0 && result.get(2) == 2.0 && result.get(3) == 3.0) {
        io::println("PASS: ValArray.cshift(-1) circular right");
    } else {
        io::println("FAIL: ValArray.cshift(-1)");
    }
}

public fn test_va_cshift_zero(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    let result: ValArray = va.cshift(0);
    if (result.get(0) == 1.0 && result.get(1) == 2.0) {
        io::println("PASS: ValArray.cshift(0) returns copy");
    } else {
        io::println("FAIL: ValArray.cshift(0)");
    }
}

public fn test_va_cshift_full_rotation(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    // cshift(3) on length-3 array = full rotation = identity
    let result: ValArray = va.cshift(3);
    if (result.get(0) == 1.0 && result.get(1) == 2.0 && result.get(2) == 3.0) {
        io::println("PASS: ValArray.cshift(size) is identity");
    } else {
        io::println("FAIL: ValArray.cshift full rotation");
    }
}

// ==================== ValArray reductions ====================

public fn test_va_sum(): void {
    let va: ValArray = new ValArray();
    va.data.add(1.0);
    va.data.add(2.0);
    va.data.add(3.0);
    va.data.add(4.0);
    if (va.sum() == 10.0) {
        io::println("PASS: ValArray.sum = 10.0");
    } else {
        io::println("FAIL: ValArray.sum");
    }
}

public fn test_va_sum_empty(): void {
    let va: ValArray = new ValArray();
    if (va.sum() == 0.0) {
        io::println("PASS: ValArray.sum empty = 0.0");
    } else {
        io::println("FAIL: ValArray.sum empty");
    }
}

public fn test_va_min(): void {
    let va: ValArray = new ValArray();
    va.data.add(3.0);
    va.data.add(1.0);
    va.data.add(2.0);
    if (va.min() == 1.0) {
        io::println("PASS: ValArray.min = 1.0");
    } else {
        io::println("FAIL: ValArray.min");
    }
}

public fn test_va_max(): void {
    let va: ValArray = new ValArray();
    va.data.add(3.0);
    va.data.add(1.0);
    va.data.add(2.0);
    if (va.max() == 3.0) {
        io::println("PASS: ValArray.max = 3.0");
    } else {
        io::println("FAIL: ValArray.max");
    }
}

public fn test_va_min_max_empty(): void {
    let va: ValArray = new ValArray();
    if (va.min() == 0.0 && va.max() == 0.0) {
        io::println("PASS: ValArray.min/max empty = 0.0");
    } else {
        io::println("FAIL: ValArray.min/max empty");
    }
}

public fn test_va_min_negative(): void {
    let va: ValArray = new ValArray();
    va.data.add(-5.0);
    va.data.add(2.0);
    va.data.add(-10.0);
    if (va.min() == -10.0 && va.max() == 2.0) {
        io::println("PASS: ValArray.min/max with negatives");
    } else {
        io::println("FAIL: ValArray.min/max negative");
    }
}

public fn run_all_valarray_tests(): void {
    io::println("=== ValArray.tr Tests ===");
    // Slice
    test_slice_construct();
    test_slice_getters();
    test_slice_index();
    test_slice_equals();
    test_slice_toString();
    test_slice_factory();
    // GSlice
    test_gslice_construct();
    test_gslice_getters();
    test_gslice_totalSize();
    test_gslice_indices_single_dim();
    test_gslice_indices_multi_dim();
    test_gslice_indices_empty();
    test_gslice_equals();
    test_gslice_toString();
    // ValArray construction & access
    test_va_construct_empty();
    test_va_get_set();
    test_va_at_in_bounds();
    test_va_at_out_of_bounds_throws();
    test_va_at_negative_throws();
    // ValArray factories
    test_va_of();
    test_va_of_empty();
    test_va_zeros();
    test_va_filled();
    // ValArray slicing
    test_va_applySlice();
    test_va_applySlice_contiguous();
    test_va_applyGSlice();
    test_va_applyIndirect();
    test_va_applyMask();
    test_va_applyMask_all_false();
    test_va_applyMask_all_true();
    // ValArray assignment
    test_va_assignSlice_scalar();
    test_va_assignSliceArray();
    test_va_assignMask_scalar();
    test_va_assignMaskArray();
    test_va_assignIndirect_scalar();
    test_va_assignIndirectArray();
    // ValArray shift/cshift
    test_va_shift_positive();
    test_va_shift_negative();
    test_va_shift_zero();
    test_va_shift_large();
    test_va_cshift_positive();
    test_va_cshift_negative();
    test_va_cshift_zero();
    test_va_cshift_full_rotation();
    // ValArray reductions
    test_va_sum();
    test_va_sum_empty();
    test_va_min();
    test_va_max();
    test_va_min_max_empty();
    test_va_min_negative();
}
