// Tests for the Slice utility module.
import tt::util::Slice;
import tt::util::ArrayList;

public fn test_slice_string(): void {
    let result = Slice.slice("hello", 1, 4, null);
    if (result == "ell") {
        io::println("PASS: Slice.slice string");
    } else {
        io::println("FAIL: Slice.slice string got " + result);
    }
}

public fn test_slice_array_list(): void {
    let list = new ArrayList<Variant>();
    list.add("a");
    list.add("b");
    list.add("c");
    list.add("d");
    let result = Slice.slice(list, 1, 3, null) as ArrayList<Variant>;
    if (result.size() == 2 && result.get(0) == "b" && result.get(1) == "c") {
        io::println("PASS: Slice.slice ArrayList");
    } else {
        io::println("FAIL: Slice.slice ArrayList");
    }
}

public fn run_all_util_slice_tests(): void {
    test_slice_string();
    test_slice_array_list();
}
