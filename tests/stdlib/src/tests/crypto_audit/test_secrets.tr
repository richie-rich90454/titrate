// Regression tests for Secrets token and random generation.
import tt::crypto::Secrets;

public fn test_tokenUrlSafe_length_and_charset(): void {
    let tok: string = Secrets.tokenUrlSafe(16);
    if (String.length(tok) != 22) {
        io::println("FAIL: tokenUrlSafe(16) length " + (String.length(tok) as string) + ", expected 22");
        return;
    }
    var i: int = 0;
    while (i < String.length(tok)) {
        let c: string = String.charAt(tok, i);
        let code: int = String.charAt(c, 0) as int;
        if (code == 65533 || c == "+" || c == "/" || c == "=") {
            io::println("FAIL: tokenUrlSafe has invalid char at " + (i as string));
            return;
        }
        i = i + 1;
    }
    io::println("PASS: tokenUrlSafe(16) is 22 URL-safe chars");
}

public fn test_randBelow_large_range(): void {
    var seen: bool = false;
    var i: int = 0;
    while (i < 200) {
        let v: int = Secrets.randBelow(1000000000);
        if (v < 0 || v >= 1000000000) {
            io::println("FAIL: randBelow out of range: " + (v as string));
            return;
        }
        if (v > 16777216) {
            seen = true;
        }
        i = i + 1;
    }
    if (!seen) {
        io::println("FAIL: randBelow appears capped at 2^24");
    } else {
        io::println("PASS: randBelow uses full integer range");
    }
}
