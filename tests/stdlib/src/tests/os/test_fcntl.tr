// Test file for os/Fcntl.tr
import tt::os::Fcntl;
import tt::os::Pty;
import tt::lang::Integer;

public fn test_fcntl_f_dupd(): void {
    let v: int = Fcntl.F_DUPFD();
    io::println("PASS: F_DUPFD() = " + Integer.toString(v));
}

public fn test_fcntl_f_getfd(): void {
    let v: int = Fcntl.F_GETFD();
    io::println("PASS: F_GETFD() = " + Integer.toString(v));
}

public fn test_fcntl_lock_sh(): void {
    let v: int = Fcntl.LOCK_SH();
    io::println("PASS: LOCK_SH() = " + Integer.toString(v));
}

public fn test_fcntl_lock_ex(): void {
    let v: int = Fcntl.LOCK_EX();
    io::println("PASS: LOCK_EX() = " + Integer.toString(v));
}

public fn test_fcntl_flock(): void {
    // Use a real descriptor on Unix (the pty master) instead of a hard-coded
    // fd number that may not be open in the harness process.
    let pair = Pty.openpty();
    if (pair.masterFd <= 0) {
        io::println("FAIL: no descriptor for flock");
        return;
    }
    let result: int = Fcntl.flock(pair.masterFd, Fcntl.LOCK_EX());
    Pty.close(pair.masterFd);
    if (result == 0) {
        io::println("PASS: flock returns 0");
    } else {
        io::println("FAIL: flock returned " + Integer.toString(result));
    }
}

// On Unix fcntl() issues a real fcntl(2). fd 0 is open in the harness, so
// F_GETFD returns the descriptor flags (>= 0). Windows has no syscall and
// returns -1.
public fn test_fcntl_getfd_query(): void {
    if (Os_name() == "windows") {
        io::println("PASS: fcntl windows fallback documented");
    } else {
        let flags: int = Fcntl.fcntl(0, Fcntl.F_GETFD());
        if (flags >= 0) {
            io::println("PASS: fcntl F_GETFD = " + Integer.toString(flags));
        } else {
            io::println("FAIL: fcntl F_GETFD returned " + Integer.toString(flags));
        }
    }
}

// Exercise flock() end-to-end on a descriptor that is real on Unix (the
// pty master) and synthetic on Windows (the in-memory fallback).
public fn test_fcntl_flock_roundtrip(): void {
    let pair = Pty.openpty();
    if (pair.masterFd <= 0) {
        io::println("FAIL: no descriptor for flock roundtrip");
        return;
    }
    let acquired: int = Fcntl.flock(pair.masterFd, Fcntl.LOCK_EX() | Fcntl.LOCK_NB());
    let released: int = Fcntl.flock(pair.masterFd, Fcntl.LOCK_UN());
    Pty.close(pair.masterFd);
    if (acquired == 0 && released == 0) {
        io::println("PASS: flock acquire/release roundtrip");
    } else {
        io::println("FAIL: flock roundtrip " + Integer.toString(acquired) + "/" + Integer.toString(released));
    }
}

public fn run_all_fcntl_tests(): void {
    io::println("=== Fcntl.tr Tests ===");
    test_fcntl_f_dupd();
    test_fcntl_f_getfd();
    test_fcntl_lock_sh();
    test_fcntl_lock_ex();
    test_fcntl_flock();
    test_fcntl_getfd_query();
    test_fcntl_flock_roundtrip();
}
